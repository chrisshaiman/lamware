---
# =============================================================================
# vars/secrets.yml — Sensitive variables (gitignored)
#
# Copy this file to secrets.yml and fill in real values:
#   cp secrets.yml.example secrets.yml
#
# Then encrypt with ansible-vault:
#   ansible-vault encrypt ansible/vars/secrets.yml
#
# To run playbooks:
#   ansible-playbook site.yml --ask-vault-pass
#   OR
#   ansible-playbook site.yml --vault-password-file ~/.vault_pass
# =============================================================================

# Cape API key — used by api.conf for authenticated sample submission.
# Generate from Cape web UI: Settings > API > Generate Token
cape_api_key: ""

# MalwareBazaar API key — free auth key from https://auth.abuse.ch/
# Used by sample-feeder CLI to query and download samples.
bazaar_auth_key: ""

# Anthropic API key — used by LLM interpretation container for Claude API calls.
# Get from https://console.anthropic.com/settings/keys
anthropic_api_key: "sk-ant-..."

# LiteLLM master key — authenticates the API, the interpret container, and the
# daily digest to the LiteLLM router. There is deliberately NO role default: one
# used to exist, which made the `| mandatory` guards at every call site unfirable
# and shipped the same key on every deploy (#238). Generate with:
#   python3 -c "import secrets; print('sk-' + secrets.token_urlsafe(32))"
litellm_master_key: ""

# Pipeline database password — for the malware_analysis PostgreSQL database.
# Used by the pipeline to store structured analysis results.
pipeline_db_password: ""

# lamware API key — X-API-Key header value required by the FastAPI backend.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
lamware_api_key: ""

# Keycloak smoke-test viewer password — read-only account used by the post-deploy
# Playwright smoke gate (make smoke). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
keycloak_smoke_test_password: ""

# ntfy topic — the routing key alerts are published under. On the public
# ntfy.sh this is the ONLY access control unless ntfy_token is also set, so
# treat it as a credential: anyone who learns it subscribes to a live feed of
# what this sandbox is analysing. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
ntfy_topic: ""

# ntfy bearer token — optional, and what actually authenticates the publish.
# Required for a protected topic; on a self-hosted ntfy behind nginx it also
# keeps the telemetry off a third party entirely. Leave empty only if you have
# accepted that the topic string alone guards the feed (#352).
ntfy_token: ""
