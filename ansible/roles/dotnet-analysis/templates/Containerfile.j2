# .NET analysis container — de4dotEx deobfuscator + ILSpy decompiler
# Deobfuscates and decompiles .NET assemblies to C# source code for LLM analysis.
# Built locally by Ansible. Never pulled from a registry.
#
# LICENSING NOTE: de4dotEx is licensed under GPL-3.0. It is invoked as a
# subprocess (not linked or imported) from this Apache 2.0 licensed project.
# See: https://github.com/AerialMantis/de4dot (GPL-3.0-or-later)
FROM mcr.microsoft.com/dotnet/sdk:10.0

RUN dotnet tool install -g ilspycmd \
    && cp -r /root/.dotnet/tools /opt/dotnet-tools \
    && chmod -R a+rX /opt/dotnet-tools

# Install de4dotEx — GPL-3.0 licensed .NET deobfuscator.
# Invoked as a subprocess only; not linked into Apache 2.0 code.
# Source fetched into the build context by the role — see the pyinstaller
# Containerfile. NB `dotnet publish` below still restores from NuGet, so this
# build is not fully hermetic; it removes the GitHub dependency, not every one.
COPY de4dotEx.tar.gz /tmp/de4dotEx.tar.gz
RUN tar -xzf /tmp/de4dotEx.tar.gz -C /tmp \
    && cd /tmp/de4dotEx-{{ de4dotex_commit }} \
    && dotnet publish de4dot -c Release -f net8.0 -o /opt/de4dot \
    && chmod -R a+rX /opt/de4dot \
    && rm -rf /tmp/de4dotEx.tar.gz /tmp/de4dotEx-{{ de4dotex_commit }}

ENV PATH="${PATH}:/opt/dotnet-tools:/opt/de4dot"

COPY analyze-dotnet.py /opt/analyze-dotnet.py
RUN chmod +x /opt/analyze-dotnet.py

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /output /nonexistent && chmod 777 /nonexistent /output
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/analyze-dotnet.py"]
