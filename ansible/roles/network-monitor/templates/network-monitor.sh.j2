#!/bin/bash
# =============================================================================
# network-monitor.sh — air-gap integrity checker
# Reads iptables packet counters to verify no traffic from the detonation
# bridge (virbr-det) reaches the internet (eth0) or management (wg0) network.
#
# Run by cron every 5 minutes as root.
# Writes status to /opt/network-monitor/status.json.
# Creates PAUSE file if air-gap breach detected.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

# Ensure output files are world-readable (dashboard runs as cape user)
umask 022

INSTALL_DIR="{{ network_monitor_install_dir }}"
STATUS_FILE="$INSTALL_DIR/status.json"
BASELINE_FILE="$INSTALL_DIR/baseline.json"
PAUSE_FILE="{{ network_monitor_pause_file }}"
BRIDGE="{{ network_monitor_detonation_bridge }}"
TIMESTAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"

mkdir -p "$INSTALL_DIR"

# -------------------------------------------------------------------------
# Read iptables counters for detonation bridge traffic
# -------------------------------------------------------------------------

# Get packet counts for FORWARD chain rules involving the detonation bridge
# iptables -L FORWARD -v -n -x outputs: pkts bytes target prot opt in out source destination
# We look for rules where in=$BRIDGE and target=DROP or ACCEPT

get_counter() {
    local direction="$1"  # "out_eth0" or "out_wg0"
    local target="$2"     # "DROP" or "ACCEPT"
    local iface

    case "$direction" in
        # Templated, NOT hardcoded. This read `eth0` while the host's management
        # interface is `{{ management_interface }}`, so the awk match below never
        # matched a real rule: det_eth0_accept was permanently 0 and the
        # internet-egress alarm could never fire. The one continuous control
        # watching the containment boundary reported healthy while measuring
        # nothing, for as long as the host has not been called eth0.
        out_eth0) iface="{{ management_interface }}" ;;
        out_wg0)  iface="wg0" ;;
        *)        echo "0"; return ;;
    esac

    # Count packets where traffic comes from bridge and goes to iface
    local count
    count=$(iptables -L FORWARD -v -n -x 2>/dev/null \
        | awk -v bridge="$BRIDGE" -v iface="$iface" -v tgt="$target" \
          '$3 == tgt && $6 == bridge && $7 == iface { sum += $1 } END { print sum+0 }')
    echo "$count"
}

# -------------------------------------------------------------------------
# Do the DROP rules still EXIST?
#
# Counter deltas alone cannot answer this. Flush the FORWARD chain (default
# policy ACCEPT) and every rule disappears: no ACCEPT rule matches, the delta is
# zero, and this script reports `ok` while nothing is blocked at all. The check
# was measuring "have the packets I am watching increased", not "is the air gap
# enforced".
#
# `--line-numbers` shifts the columns by one: num pkts bytes target prot opt in out
# -------------------------------------------------------------------------

rule_survey() {
    # Emits: <drop_count> <first_drop_idx> <accept_count> <first_accept_idx>
    local cmd="$1" iface="$2"
    "$cmd" -L FORWARD -v -n -x --line-numbers 2>/dev/null \
        | awk -v bridge="$BRIDGE" -v iface="$iface" '
            $4 == "DROP"   && $7 == bridge && $8 == iface { if (!d) d = $1; dc++ }
            $4 == "ACCEPT" && $7 == bridge && $8 == iface { if (!a) a = $1; ac++ }
            END { print dc+0, d+0, ac+0, a+0 }'
}

check_rules() {
    local cmd="$1" iface="$2" label="$3"
    read -r dc di ac ai <<< "$(rule_survey "$cmd" "$iface")"
    if [ "$dc" -eq 0 ]; then
        echo "MISSING: no $cmd DROP rule for $BRIDGE -> $label ($iface)"
        return
    fi
    # A DROP that sits below an ACCEPT for the same pair never sees the traffic.
    if [ "$ac" -gt 0 ] && [ "$ai" -lt "$di" ]; then
        echo "ORDERING: $cmd ACCEPT at rule $ai precedes DROP at rule $di for $BRIDGE -> $label ($iface)"
    fi
}

# -------------------------------------------------------------------------
# The pipeline user's own egress allowlist, in BOTH families (#343).
#
# The counters above watch the detonation bridge. Nothing watched this chain,
# and until #343 it existed only in IPv4 — so the v6 half could be absent, or
# present but ordered behind its own DROP, and every other check stayed green.
#
# Ordering is the failure mode worth naming: Ansible APPENDS these rules, so an
# allow added after the DROP-all is dead. It is still present, still matches a
# `-C` check, and blocks the traffic it was written to permit.
# -------------------------------------------------------------------------

egress_survey() {
    # Emits: <accept_count> <last_accept_idx> <drop_count> <first_drop_idx>
    local cmd="$1"
    "$cmd" -L OUTPUT -v -n -x --line-numbers 2>/dev/null \
        | awk '
            /pipeline: / && $4 == "ACCEPT" { a = $1; ac++ }
            /pipeline: / && $4 == "DROP"   { if (!d) d = $1; dc++ }
            END { print ac+0, a+0, dc+0, d+0 }'
}

check_egress() {
    local cmd="$1"
    read -r ac ai dc di <<< "$(egress_survey "$cmd")"
    if [ "$dc" -eq 0 ]; then
        echo "MISSING: no $cmd DROP-all for the pipeline user — its egress is unrestricted"
        return
    fi
    if [ "$ac" -gt 0 ] && [ "$ai" -gt "$di" ]; then
        echo "ORDERING: $cmd pipeline ACCEPT at rule $ai sits below the DROP-all at rule $di"
    fi
}

rules_problem=""
for _fam in iptables ip6tables; do
    for _check in \
        "$(check_rules "$_fam" "{{ management_interface }}" internet)" \
        "$(check_rules "$_fam" wg0 management)" \
        "$(check_egress "$_fam")"
    do
        [ -n "$_check" ] || continue
        rules_problem="${rules_problem}${rules_problem:+; }${_check}"
    done
done

# Current counters
det_eth0_accept=$(get_counter out_eth0 ACCEPT)
det_eth0_drop=$(get_counter out_eth0 DROP)
det_wg0_accept=$(get_counter out_wg0 ACCEPT)
det_wg0_drop=$(get_counter out_wg0 DROP)

# -------------------------------------------------------------------------
# Compare against baseline
# -------------------------------------------------------------------------

status="ok"
alert_message=""

# A missing or out-of-order DROP rule is a breach of the containment DESIGN, not
# of a packet threshold, so it alarms on its own — before any counter is read.
if [ -n "$rules_problem" ]; then
    status="alert"
    alert_message="AIR-GAP RULES NOT ENFORCED: $rules_problem"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ALERT: $alert_message"
    touch "$PAUSE_FILE"
    python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
        "AIR-GAP RULES MISSING" "$alert_message" \
        --priority urgent --tags skull 2>/dev/null || true
fi

if [ -f "$BASELINE_FILE" ]; then
    # Read baseline ACCEPT counters
    baseline_eth0_accept=$(python3 -c "import json; d=json.load(open('$BASELINE_FILE')); print(d.get('det_eth0_accept', 0))")
    baseline_wg0_accept=$(python3 -c "import json; d=json.load(open('$BASELINE_FILE')); print(d.get('det_wg0_accept', 0))")

    # Check if ACCEPT counters increased (breach indicator)
    if [ "$det_eth0_accept" -gt "$baseline_eth0_accept" ]; then
        new_packets=$((det_eth0_accept - baseline_eth0_accept))
        status="alert"
        alert_message="AIR-GAP BREACH: $new_packets packets ACCEPTED from $BRIDGE to eth0 since baseline"
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ALERT: $alert_message"
        touch "$PAUSE_FILE"
        python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
            "NETWORK BREACH" "$alert_message" \
            --priority urgent --tags skull 2>/dev/null || true
    fi

    if [ "$det_wg0_accept" -gt "$baseline_wg0_accept" ]; then
        new_packets=$((det_wg0_accept - baseline_wg0_accept))
        status="alert"
        alert_message="${alert_message:+$alert_message; }AIR-GAP BREACH: $new_packets packets ACCEPTED from $BRIDGE to wg0 since baseline"
        echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ALERT: $alert_message"
        touch "$PAUSE_FILE"
        python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
            "NETWORK BREACH" "$alert_message" \
            --priority urgent --tags skull 2>/dev/null || true
    fi
else
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) INFO: First run — saving baseline"
fi

# -------------------------------------------------------------------------
# QEMU child process check — detect sandbox breakout
# -------------------------------------------------------------------------

QEMU_PIDS=$(pgrep qemu-system 2>/dev/null || true)
qemu_status="ok"
qemu_unexpected=""

if [ -n "$QEMU_PIDS" ]; then
    for qpid in $QEMU_PIDS; do
        # Get child processes (exclude QEMU's own threads)
        children=$(ps --ppid "$qpid" -o pid=,comm= 2>/dev/null | grep -v -E "qemu-system|CPU |worker" || true)
        if [ -n "$children" ]; then
            qemu_status="alert"
            qemu_unexpected="$children"
            status="alert"
            alert_message="${alert_message:+$alert_message; }QEMU BREAKOUT: unexpected child processes of PID $qpid: $children"
            echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) ALERT: QEMU unexpected children: $children"
            touch "$PAUSE_FILE"
            # Send ntfy notification
            python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
                "QEMU BREAKOUT" "Unexpected child process of qemu-system (PID $qpid): $children" \
                --priority urgent --tags skull 2>/dev/null || true
        fi
    done
fi

# -------------------------------------------------------------------------
# Per-user process allowlist checks (full command-line pattern matching)
#
# Uses ps args= for full command lines. Each user has a set of glob
# patterns — if a process doesn't match any pattern, it's flagged.
# -------------------------------------------------------------------------

check_user_processes() {
    local user="$1"
    shift
    local patterns=("$@")
    local unexpected=""

    while IFS= read -r cmdline; do
        [ -z "$cmdline" ] && continue
        local allowed=false
        for pattern in "${patterns[@]}"; do
            case "$cmdline" in $pattern) allowed=true; break ;; esac
        done
        if [ "$allowed" = "false" ]; then
            unexpected="${unexpected:+$unexpected | }$cmdline"
        fi
    done < <(ps -u "$user" -o args= 2>/dev/null | sort -u)

    echo "$unexpected"
}

# --- cape user: CAPE core services + system daemons + cron cleanup ---
cape_patterns=(
    # CAPE core services
    '*/capev2-*/bin/python cuckoo.py*'
    '*/capev2-*/bin/python process.py*'
    '*/capev2-*/bin/python manage.py runserver*'
    '*/capev2-*/bin/python rooter.py*'
    '*/poetry*'
    # Podman containers + QEMU VMs
    'podman'
    'conmon*'
    'catatonit*'
    'pause'
    '*/tcpdump*'
    '*/qemu-system*'
    # Systemd user session
    '/usr/lib/systemd/systemd --user'
    '(sd-pam)'
    '/usr/bin/dbus-daemon --session*'
    '/usr/bin/pipewire*'
    '/usr/bin/xdg-dbus-prox*'
    '/usr/lib/dconf/dconf-service'
    '/usr/libexec/gvfsd*'
    # Cron: cape-memory-dump-cleanup + cape-storage-maintenance
    'find /opt/CAPEv2/storage*'
    'chgrp *lamware /opt/CAPEv2/storage*'
    'chmod *g+rX /opt/CAPEv2/storage*'
    'rm -rf /opt/CAPEv2/storage*'
    '/bin/sh -c find /opt/CAPEv2/storage*'
    '/bin/sh -c *CAPEv2/storage*'
    'bash -c find /opt/CAPEv2/storage*'
    'sleep [0-9]*'
)
cape_unexpected=$(check_user_processes "{{ cape_user | default('cape') }}" "${cape_patterns[@]}")
cape_process_status="ok"
if [ -n "$cape_unexpected" ]; then
    cape_process_status="warning"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) WARNING: Unexpected cape processes: $cape_unexpected"
    python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
        "Unexpected Processes" "cape user: $cape_unexpected" \
        --priority high --tags warning 2>/dev/null || true
fi

# --- pipeline user: pipeline + containers + feeders ---
pipeline_patterns=(
    # Pipeline execution
    '/opt/pipeline/venv/bin/python* /opt/pipeline/run-pipeline.py*'
    '/bin/bash /usr/local/bin/run-pipeline*'
    '/bin/bash */run-pipeline*'
    '*/run-pipeline /tmp/*'
    # Feeders (auto-feeder delegates via sudo)
    'python3 /opt/sample-feeder/sample_feeder.py*'
    # Cron jobs
    # Templated like the alert call sites (#350): these are the ALLOWLIST, so a
    # stale path fails in the opposite direction — the digest keeps running and
    # starts being reported as an unexpected process, which is a false alarm on
    # the one report a human is meant to trust.
    'python3 {{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/daily-digest.py*'
    '/bin/sh -c *ntfy-alerts*'
    '/opt/pipeline/cleanup.sh*'
    '/bin/sh -c *pipeline*'
    '/opt/pipeline/venv/bin/python* /opt/pipeline/generate-report.py*'
    # Podman containers
    'podman'
    'podman run --rm*'
    'podman build*'
    'conmon*'
    'catatonit*'
    'pause'
    # Systemd user session
    '/usr/lib/systemd/systemd --user'
    '(sd-pam)'
    '/usr/bin/dbus-daemon --session*'
    # Pipeline spool processing
    'bash -c for f in /opt/pipeline/spool*'
    # Container file operations (scoped to pipeline paths)
    'cp /tmp/*'
    'find /opt/*'
    'find /tmp/*'
    'sleep [0-9]*'
)
pipeline_unexpected=$(check_user_processes "pipeline" "${pipeline_patterns[@]}")
pipeline_process_status="ok"
if [ -n "$pipeline_unexpected" ]; then
    pipeline_process_status="warning"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) WARNING: Unexpected pipeline processes: $pipeline_unexpected"
    python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
        "Unexpected Processes" "pipeline user: $pipeline_unexpected" \
        --priority high --tags warning 2>/dev/null || true
fi

# --- auto-feeder user: MalwareBazaar downloads + sudo pipeline delegation ---
autofeeder_patterns=(
    # Auto-feeder script + pipeline delegation
    'python3 /opt/auto-feeder/auto-feeder.py*'
    '*/python3 /opt/auto-feeder/auto-feeder.py*'
    'sudo -u pipeline /usr/local/bin/run-pipeline*'
    # Systemd user session
    '/usr/lib/systemd/systemd --user'
    '(sd-pam)'
    'sleep [0-9]*'
)
autofeeder_unexpected=$(check_user_processes "auto-feeder" "${autofeeder_patterns[@]}")
autofeeder_process_status="ok"
if [ -n "$autofeeder_unexpected" ]; then
    autofeeder_process_status="warning"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) WARNING: Unexpected auto-feeder processes: $autofeeder_unexpected"
    python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
        "Unexpected Processes" "auto-feeder user: $autofeeder_unexpected" \
        --priority high --tags warning 2>/dev/null || true
fi

# --- lamware-api user: only uvicorn ---
api_patterns=(
    '*/uvicorn app.main:app*'
    '*/python3 */uvicorn*'
)
api_unexpected=$(check_user_processes "lamware-api" "${api_patterns[@]}")
api_process_status="ok"
if [ -n "$api_unexpected" ]; then
    api_process_status="warning"
    echo "$(date -u +%Y-%m-%dT%H:%M:%SZ) WARNING: Unexpected lamware-api processes: $api_unexpected"
    python3 "{{ ntfy_install_dir | default('/opt/ntfy-alerts') }}/ntfy_notify.py" \
        "Unexpected API Process" "lamware-api user: $api_unexpected" \
        --priority critical --tags rotating_light 2>/dev/null || true
fi

# -------------------------------------------------------------------------
# Save baseline (first run) and status (every run)
# -------------------------------------------------------------------------

# Always update baseline with current counters
python3 -c "
import json
baseline = {
    'det_eth0_accept': $det_eth0_accept,
    'det_eth0_drop': $det_eth0_drop,
    'det_wg0_accept': $det_wg0_accept,
    'det_wg0_drop': $det_wg0_drop,
    'timestamp': '$TIMESTAMP',
}
with open('$BASELINE_FILE', 'w') as f:
    json.dump(baseline, f, indent=2)
"

# Write status file (read by dashboard)
python3 -c "
import json, os
checks = 0
if os.path.exists('$STATUS_FILE'):
    try:
        checks = json.load(open('$STATUS_FILE')).get('checks_since_baseline', 0)
    except Exception:
        pass

status = {
    'status': '$status',
    'last_check': '$TIMESTAMP',
    'checks_since_baseline': checks + 1,
    'detonation_to_internet': {
        'accept_packets': $det_eth0_accept,
        'drop_packets': $det_eth0_drop,
        'status': 'alert' if $det_eth0_accept > 0 else 'ok',
    },
    'detonation_to_management': {
        'accept_packets': $det_wg0_accept,
        'drop_packets': $det_wg0_drop,
        'status': 'alert' if $det_wg0_accept > 0 else 'ok',
    },
    'air_gap_rules': {
        'enforced': not bool('''$rules_problem'''),
        'problem': '''$rules_problem''' or None,
    },
    'qemu_status': '$qemu_status',
    'qemu_unexpected_children': '$qemu_unexpected'.split(chr(10)) if '$qemu_unexpected' else [],
    'cape_process_status': '$cape_process_status',
    'cape_unexpected_processes': '$cape_unexpected'.split(' | ') if '$cape_unexpected' else [],
    'pipeline_process_status': '$pipeline_process_status',
    'pipeline_unexpected_processes': '$pipeline_unexpected'.split(' | ') if '$pipeline_unexpected' else [],
    'api_process_status': '$api_process_status',
    'api_unexpected_processes': '$api_unexpected'.split(' | ') if '$api_unexpected' else [],
    'alert_message': '$alert_message' if '$status' == 'alert' else None,
}
with open('$STATUS_FILE', 'w') as f:
    json.dump(status, f, indent=2)
"
