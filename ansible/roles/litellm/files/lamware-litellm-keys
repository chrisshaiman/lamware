#!/usr/bin/python3 -I
# /usr/local/sbin/lamware-litellm-keys -- managed by Ansible (litellm role). Root only.
"""Keep LiteLLM's scoped keys: one per caller, none of them the master key.

    lamware-litellm-keys <specs.json>

specs.json is a list of {"name": str, "models": [str], "role": str (optional)}.
For each spec the key on record (KEYS_FILE) is kept if LiteLLM still knows it under
the alias lamware-<name>, its model list is updated if the spec changed, and
otherwise any key under that alias is deleted and a new one generated. A spec with
"role" gets its own LiteLLM user with that role (proxy_admin_viewer reads spend and
nothing else). KEYS_FILE is written root 0600, atomically, only when something
changed.

Prints one JSON object, {name: "kept" | "updated" | "created"}, and never a key.
The master key is read from LiteLLM's config and used only here.
"""
from __future__ import annotations

import json
import os
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request

import yaml

CONFIG = os.environ.get("LITELLM_CONFIG", "/opt/litellm/config.yaml")
URL = os.environ.get("LITELLM_URL", "http://127.0.0.1:4000")
# urlopen also opens file: and custom schemes; only LiteLLM's HTTP port is meant.
if urllib.parse.urlsplit(URL).scheme not in ("http", "https"):
    raise SystemExit(f"lamware-litellm-keys: LITELLM_URL must be http(s), got {URL!r}")
KEYS_FILE = os.environ.get("LITELLM_KEYS_FILE", "/etc/lamware-litellm/keys.json")
MANAGED = {"managed_by": "ansible litellm role (lamware-litellm-keys)"}


def master_key() -> str:
    with open(CONFIG, encoding="utf-8") as f:
        return yaml.safe_load(f)["general_settings"]["master_key"]


def call(mk: str, method: str, path: str, body: dict | None = None) -> tuple[int, dict]:
    req = urllib.request.Request(
        URL + path, method=method,
        data=None if body is None else json.dumps(body).encode(),
        headers={"Authorization": f"Bearer {mk}", "Content-Type": "application/json"})
    try:
        # The scheme is checked at import (http/https only).
        with urllib.request.urlopen(req, timeout=30) as r:  # noqa: S310  # nosec B310
            return r.status, json.loads(r.read() or b"{}")
    except urllib.error.HTTPError as e:
        try:
            return e.code, json.loads(e.read() or b"{}")
        except ValueError:
            return e.code, {}


def alias(name: str) -> str:
    return f"lamware-{name}"


def current_info(mk: str, key: str) -> dict | None:
    status, body = call(mk, "GET", "/key/info?" + urllib.parse.urlencode({"key": key}))
    if status != 200:
        return None
    return body.get("info") or None


def user_for(mk: str, name: str, role: str) -> str:
    status, body = call(mk, "POST", "/user/new", {
        "user_alias": alias(name), "user_role": role, "auto_create_key": False,
        "metadata": MANAGED})
    if status != 200 or not body.get("user_id"):
        raise RuntimeError(f"{name}: /user/new returned {status}")
    return body["user_id"]


def create(mk: str, spec: dict) -> str:
    name = spec["name"]
    call(mk, "POST", "/key/delete", {"key_aliases": [alias(name)]})
    body = {"key_alias": alias(name), "models": spec["models"], "metadata": MANAGED}
    if spec.get("role"):
        body["user_id"] = user_for(mk, name, spec["role"])
    status, out = call(mk, "POST", "/key/generate", body)
    if status != 200 or not out.get("key"):
        raise RuntimeError(f"{name}: /key/generate returned {status}")
    return out["key"]


def ensure(mk: str, spec: dict, key: str | None) -> tuple[str, str]:
    """Return (key, what was done)."""
    info = current_info(mk, key) if key else None
    if not info or info.get("key_alias") != alias(spec["name"]):
        return create(mk, spec), "created"
    if sorted(info.get("models") or []) != sorted(spec["models"]):
        status, _ = call(mk, "POST", "/key/update", {"key": key, "models": spec["models"]})
        if status != 200:
            raise RuntimeError(f"{spec['name']}: /key/update returned {status}")
        return key, "updated"
    return key, "kept"


def load() -> dict:
    try:
        with open(KEYS_FILE, encoding="utf-8") as f:
            data = json.load(f)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save(keys: dict) -> None:
    d = os.path.dirname(KEYS_FILE)
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".keys.")
    try:
        os.fchmod(fd, 0o600)
        with os.fdopen(fd, "w", encoding="utf-8") as f:
            json.dump(keys, f, indent=1, sort_keys=True)
            f.write("\n")
        os.replace(tmp, KEYS_FILE)
    except BaseException:
        os.unlink(tmp)
        raise


def main(argv: list[str]) -> int:
    with open(argv[0], encoding="utf-8") as f:
        specs = json.load(f)
    mk = master_key()
    keys = load()
    done = {}
    for spec in specs:
        keys[spec["name"]], done[spec["name"]] = ensure(mk, spec, keys.get(spec["name"]))
    if any(v != "kept" for v in done.values()) or set(keys) - {s["name"] for s in specs}:
        save({s["name"]: keys[s["name"]] for s in specs})
    print(json.dumps(done, sort_keys=True))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
