model_list:
  - model_name: "{{ interpret_model | default('claude-sonnet-4-6') }}"
    litellm_params:
      model: "anthropic/{{ interpret_model | default('claude-sonnet-4-6') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "{{ interpret_summary_model | default('claude-haiku-4-5') }}"
    litellm_params:
      model: "anthropic/{{ interpret_summary_model | default('claude-haiku-4-5') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "{{ interpret_escalation_model | default('claude-opus-4-6') }}"
    litellm_params:
      model: "anthropic/{{ interpret_escalation_model | default('claude-opus-4-6') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  # Current-gen Claude arms for the eval harness (A/B vs local qwen).
  # Use the UNDATED aliases: these models have no dated snapshot id, and a dated
  # pin 404s (verified live 2026-07-24 against GET /v1/models).
  - model_name: "claude-sonnet-5"
    litellm_params:
      model: "anthropic/claude-sonnet-5"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "claude-opus-5"
    litellm_params:
      model: "anthropic/claude-opus-5"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  # Local LLM (Ollama) for the summary stages. Reached over host loopback; the
  # /v1/messages router translates Anthropic<->Ollama (verified 2026-07-04 spike).
  # think:false is REQUIRED — Qwen3.6 is a thinking model and otherwise burns the
  # token budget on hidden reasoning and returns an EMPTY summary (proven
  # 2026-07-04: think=true -> empty, think=false -> full summary). Confirm LiteLLM
  # forwards `think` to ollama_chat during deploy; if not, fall back to an Ollama
  # Modelfile PARAMETER or a `/no_think` directive in the summary system prompt.
  - model_name: "local-qwen"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: false
  - model_name: "local-qwen-strict"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: false
  # Agentic RE loop variant — identical to local-qwen but with think:true so the
  # model reasons through disassembly before committing to tool calls.
  - model_name: "local-qwen-re"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: true
  # Agentic RE on llama.cpp (llama-server), the eval harness's local arms.
  # llama.cpp beat Ollama for reasoning-on work in the 2026-07-23 spike: it splits
  # reasoning into `reasoning_content` so `content` stays clean, and it
  # grammar-constrains forced-tool args, which is what makes structured RE output
  # reliable (PR #180). Thinking is on by DEFAULT here (llama-server --jinja);
  # it is disabled per-request via chat_template_kwargs.enable_thinking, NOT by a
  # `think` param, so none is set.
  #
  # ANTHROPIC-provider entry, not OpenAI (#285). llama-server implements
  # /v1/messages natively and fills thinking blocks on it, so routing through the
  # OpenAI shape asked LiteLLM to translate a format the backend already speaks —
  # and that translation is lossy in exactly the way that matters.
  #
  # Measured 2026-08-04 against llama-server on 11435, no LiteLLM in the path:
  #   thinking   568 chars returned alongside a tool_use block in one response
  #   tool calls stop_reason=tool_use, correct name and arguments
  #   KV cache   call 2 of an identical prefix: input=4, cache_read=1220 (99.7%)
  # while the SAME request through LiteLLM's OpenAI leg returned content: [] with
  # usage.output_tokens: 80 — 80 tokens generated, none delivered. That empty array
  # is #283's "trail records ZERO model output on tool-calling turns".
  #
  # api_base has NO /v1 suffix: LiteLLM appends /v1/messages itself for anthropic
  # providers. LITELLM_ANTHROPIC_DISABLE_URL_SUFFIX exists if that ever changes.
  # llama.cpp ignores api_key.
  - model_name: "local-qwen-llamacpp-re"
    litellm_params:
      model: "anthropic/qwen3.6"
      api_base: "{{ litellm_llamacpp_anthropic_base | default('http://127.0.0.1:11435') }}"
      api_key: "sk-none"

  # The SUMMARY model, on the same llama.cpp server. Kept separate from -re above
  # on purpose, twice over:
  #
  #   1. -re carries NO cloud fallback by design (see `fallbacks` below and
  #      test_litellm_fallbacks.py) because its context holds decompiled malware.
  #      Summaries have always fallen back to Haiku via local-qwen; pointing them
  #      at -re would silently remove that, turning a degraded summary into a
  #      failed pipeline stage.
  #   2. -re names the agentic RE arm the eval harness measures. Routing summary
  #      traffic through it would put unrelated load on the alias whose behaviour
  #      the scorecard attributes to RE.
  #
  # This one DOES take the /v1 suffix: it uses the OpenAI leg, replacing
  # `ollama_chat/`, which is also an OpenAI-shaped chat completion and so the
  # closer behavioural match. The anthropic/ leg above exists for -re specifically
  # because #285 needed thinking to survive tool-calling turns; summaries make no
  # tool calls.
  #
  # Exists so the pipeline stops depending on Ollama, which serves the SAME
  # qwen3.6 weights and loads a second ~14GB copy alongside llama-server (#407).
  - model_name: "local-qwen-llamacpp"
    litellm_params:
      model: "openai/qwen3.6"
      api_base: "{{ litellm_llamacpp_openai_base | default('http://127.0.0.1:11435/v1') }}"
      api_key: "sk-none"
{% for seed in litellm_llamacpp_seeds %}
{% if loop.first %}
  # ---------------------------------------------------------------------------
  # THESE ALIASES ARE NOT SEEDED. The name says -s42; the sampling is not pinned.
  # ---------------------------------------------------------------------------
  #
  # They were built for MULTI-SEED CONSENSUS — run a sample at N seeds, keep claims
  # appearing in >= k of them — on the reasoning that independent samples agreeing
  # is evidence a claim is real (#222). They have never delivered that.
  #
  # Measured 2026-08-03/04 (#292):
  #   Three runs, one per seed, consecutive, same sample, same code:
  #     qwen_10_s42.variance   28330 bytes  sha256=a0dd30d0a5749724...
  #     qwen_10_s1337          28330 bytes  sha256=a0dd30d0a5749724...
  #     qwen_10_s8675309       28330 bytes  sha256=a0dd30d0a5749724...
  #   And at depth 15, qwen_15_s42 vs qwen_15_s1337: 71331 bytes, identical SHA,
  #   zero bytes differing across the whole tool loop.
  #
  # llama.cpp is not at fault — direct to /v1/chat/completions with an explicit
  # seed, the same seed reproduces byte-for-byte and a different seed diverges. The
  # seed simply never arrives. On /v1/messages, llama-server ignores the field
  # outright (measured: seeds 42 and 1337 produced identical output).
  #
  # So the entries below carry no `seed:`, because setting one would be a lie that
  # `drop_params: true` would swallow silently — the same failure mode this file
  # already warns about for top_k/min_p. They stay REGISTERED, identical to the
  # base alias, only so that an arm naming a seed keeps resolving instead of
  # failing with model-not-found hours into a run.
  #
  # RESOLVED 2026-08-07 (#292), by removing the claim rather than the aliases.
  # `--consensus-k` now defaults to 0 and REFUSES seed variants of one arm with an
  # explanation, instead of printing a section where identical loops agreed on
  # everything and k=2 confirmed every claim for free — precisely what __main__.py
  # rejects k=1 for. Scorecards from before that date carry the vacuous section;
  # ignore it. #310 tracks cross-MODEL consensus, which is a real axis.
  #
  # The aliases stay REGISTERED so old arm names keep resolving. They are not,
  # and are not going to be, seeded — see #310 for why that is a backend
  # constraint and not a TODO.
{% endif %}
  - model_name: "local-qwen-llamacpp-re-s{{ seed }}"
    litellm_params:
      model: "anthropic/qwen3.6"
      api_base: "{{ litellm_llamacpp_anthropic_base | default('http://127.0.0.1:11435') }}"
      api_key: "sk-none"
{% endfor %}
  - model_name: "haiku-fallback"
    litellm_params:
      model: "anthropic/{{ litellm_fallback_backend }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

litellm_settings:
  drop_params: true
  set_verbose: false
  # local-qwen -> Haiku on any local failure. See PipelineConfig.summary_model for
  # the per-stage knob.
  #
  # DELIBERATELY ABSENT, do not "fix" by adding one:
  #   local-qwen-strict     — strict = offline.
  #   local-qwen-llamacpp-re — the AGENTIC RE model. Its context holds decompiled
  #     malware bodies, extracted strings and C2 indicators. A cloud fallback would
  #     silently ship all of that to a third party at the exact moment the local
  #     model failed — turning an availability feature into a data-egress incident,
  #     and defeating the air-gap that is the whole reason RE runs locally.
  #     RE must fail loudly and stay offline. Guarded by
  #     pipeline/tests/test_litellm_fallbacks.py.
  fallbacks: [{"local-qwen": ["haiku-fallback"]}, {"local-qwen-llamacpp": ["haiku-fallback"]}]

general_settings:
  master_key: "{{ litellm_master_key | mandatory }}"
  database_url: "os.environ/DATABASE_URL"
