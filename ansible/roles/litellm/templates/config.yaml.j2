model_list:
  - model_name: "{{ interpret_model | default('claude-sonnet-4-6') }}"
    litellm_params:
      model: "anthropic/{{ interpret_model | default('claude-sonnet-4-6') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "{{ interpret_summary_model | default('claude-haiku-4-5') }}"
    litellm_params:
      model: "anthropic/{{ interpret_summary_model | default('claude-haiku-4-5') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "{{ interpret_escalation_model | default('claude-opus-4-6') }}"
    litellm_params:
      model: "anthropic/{{ interpret_escalation_model | default('claude-opus-4-6') }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  # Current-gen Claude arms for the eval harness (A/B vs local qwen).
  # Use the UNDATED aliases: these models have no dated snapshot id, and a dated
  # pin 404s (verified live 2026-07-24 against GET /v1/models).
  - model_name: "claude-sonnet-5"
    litellm_params:
      model: "anthropic/claude-sonnet-5"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  - model_name: "claude-opus-5"
    litellm_params:
      model: "anthropic/claude-opus-5"
      api_key: "os.environ/ANTHROPIC_API_KEY"

  # Local LLM (Ollama) for the summary stages. Reached over host loopback; the
  # /v1/messages router translates Anthropic<->Ollama (verified 2026-07-04 spike).
  # think:false is REQUIRED — Qwen3.6 is a thinking model and otherwise burns the
  # token budget on hidden reasoning and returns an EMPTY summary (proven
  # 2026-07-04: think=true -> empty, think=false -> full summary). Confirm LiteLLM
  # forwards `think` to ollama_chat during deploy; if not, fall back to an Ollama
  # Modelfile PARAMETER or a `/no_think` directive in the summary system prompt.
  - model_name: "local-qwen"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: false
  - model_name: "local-qwen-strict"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: false
  # Agentic RE loop variant — identical to local-qwen but with think:true so the
  # model reasons through disassembly before committing to tool calls.
  - model_name: "local-qwen-re"
    litellm_params:
      model: "{{ litellm_local_model_backend }}"
      api_base: "{{ litellm_ollama_api_base }}"
      think: true
  # Agentic RE on llama.cpp (llama-server), the eval harness's local arms.
  # llama.cpp beat Ollama for reasoning-on work in the 2026-07-23 spike: it splits
  # reasoning into `reasoning_content` so `content` stays clean, and it
  # grammar-constrains forced-tool args, which is what makes structured RE output
  # reliable (PR #180). Thinking is on by DEFAULT here (llama-server --jinja);
  # it is disabled per-request via chat_template_kwargs.enable_thinking, NOT by a
  # `think` param, so none is set.
  # NOTE: an OpenAI-provider entry — llama.cpp ignores the api_key.
  - model_name: "local-qwen-llamacpp-re"
    litellm_params:
      model: "openai/qwen3.6"
      api_base: "{{ litellm_llamacpp_api_base | default('http://127.0.0.1:11435/v1') }}"
      api_key: "sk-none"
{% for seed in litellm_llamacpp_seeds %}
{% if loop.first %}
  # Seed-pinned variants of the RE model, one alias per seed. The interpret client
  # speaks the Anthropic Messages shape, which has no `seed` field — so the seed
  # cannot be a per-request argument and has to be bound to a model alias here.
  #
  # These exist for MULTI-SEED CONSENSUS: run the same sample across several seeds
  # and keep the claims that appear in >= k of them. Independent sampling agreeing
  # is evidence a claim is real; a claim appearing once is more likely confabulation.
  # Affordable only because local inference is $0 (see issue #222).
  #
  # Everything ELSE about sampling (temperature, top_p, top_k, min_p) is set
  # server-side by the llama-cpp role, NOT here: top_k and min_p are not OpenAI
  # parameters and `drop_params: true` above would silently discard them.
  #
  # Do NOT pick the best-scoring seed. Selection on noise invalidates the result.
{% endif %}
  - model_name: "local-qwen-llamacpp-re-s{{ seed }}"
    litellm_params:
      model: "openai/qwen3.6"
      api_base: "{{ litellm_llamacpp_api_base | default('http://127.0.0.1:11435/v1') }}"
      api_key: "sk-none"
      seed: {{ seed }}
{% endfor %}
  - model_name: "haiku-fallback"
    litellm_params:
      model: "anthropic/{{ litellm_fallback_backend }}"
      api_key: "os.environ/ANTHROPIC_API_KEY"

litellm_settings:
  drop_params: true
  set_verbose: false
  # local-qwen -> Haiku on any local failure. See PipelineConfig.summary_model for
  # the per-stage knob.
  #
  # DELIBERATELY ABSENT, do not "fix" by adding one:
  #   local-qwen-strict     — strict = offline.
  #   local-qwen-llamacpp-re — the AGENTIC RE model. Its context holds decompiled
  #     malware bodies, extracted strings and C2 indicators. A cloud fallback would
  #     silently ship all of that to a third party at the exact moment the local
  #     model failed — turning an availability feature into a data-egress incident,
  #     and defeating the air-gap that is the whole reason RE runs locally.
  #     RE must fail loudly and stay offline. Guarded by
  #     pipeline/tests/test_litellm_fallbacks.py.
  fallbacks: [{"local-qwen": ["haiku-fallback"]}]

general_settings:
  master_key: "{{ litellm_master_key | mandatory }}"
  database_url: "os.environ/DATABASE_URL"
