ANTHROPIC_API_KEY={{ anthropic_api_key }}
# Lamware eval workspace key (spend-capped), used ONLY by the eval-* aliases.
# Empty until set in the vault, so a call fails with an auth error rather than
# falling back to the production key above.
ANTHROPIC_RESEARCH_API_KEY={{ anthropic_research_api_key | default('') }}
DATABASE_URL=postgresql://{{ litellm_db_user }}:{{ litellm_db_password }}@127.0.0.1:5432/{{ litellm_db_name }}
