{# A route in litellm_anthropic_wif_routes authenticates through the anthropic-wif
   forwarder with a short-lived federated token (ADR-033); its key is not written. #}
{% if 'production' not in litellm_anthropic_wif_routes %}
ANTHROPIC_API_KEY={{ anthropic_api_key }}
{% endif %}
{% if 'eval' not in litellm_anthropic_wif_routes %}
# Lamware eval workspace key (spend-capped), used ONLY by the eval-* aliases.
# Empty until set in the vault, so a call fails with an auth error rather than
# falling back to the production key above.
ANTHROPIC_RESEARCH_API_KEY={{ anthropic_research_api_key | default('') }}
{% endif %}
DATABASE_URL=postgresql://{{ litellm_db_user }}:{{ litellm_db_password }}@127.0.0.1:5432/{{ litellm_db_name }}
{# The operator's provider credentials (ADR-038), referenced as os.environ/NAME by
   litellm_operator_models. Names and values are checked by tasks/operator-models.yml. #}
{% for name, value in (litellm_operator_env | default({})).items() %}
{{ name }}={{ value }}
{% endfor %}
