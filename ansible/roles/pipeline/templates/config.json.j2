{
  "malfind_enabled": {{ pipeline_malfind_enabled | default(true) | to_json }},
  "malfind_max_candidates": {{ pipeline_malfind_max_candidates | default(5) }},
  "malfind_min_size": {{ pipeline_malfind_min_size | default(256) }},
  "malfind_max_size": {{ pipeline_malfind_max_size | default(10485760) }},
  "malfind_min_score": {{ pipeline_malfind_min_score | default(2) }},
  "malfind_benign_processes": {{ (pipeline_malfind_benign_processes | default(['csrss.exe', 'smss.exe', 'MsMpEng.exe', 'fontdrvhost.exe'])) | to_json }},

  "cape_api_url": {{ cape_api_url | to_json }},
  "triage_cmd": "{{ triage_install_dir }}/run-triage",
  "volatility_cmd": "{{ volatility_install_dir }}/run-volatility",
  "ghidra_cmd": "{{ ghidra_install_dir }}/run-ghidra",
  "dotnet_cmd": "{{ dotnet_analysis_install_dir | default('/opt/dotnet-analysis') }}/run-dotnet-analysis",
  "go_cmd": "{{ go_analysis_install_dir | default('/opt/go-analysis') }}/run-go-analysis",
  "pyinstaller_cmd": "{{ pyinstaller_analysis_install_dir | default('/opt/pyinstaller-analysis') }}/run-pyinstaller-analysis",
  "java_cmd": "{{ java_analysis_install_dir | default('/opt/java-analysis') }}/run-java-analysis",
  "office_cmd": "{{ office_macro_analysis_install_dir | default('/opt/office-macro-analysis') }}/run-office-analysis",
  "powershell_cmd": "{{ powershell_analysis_install_dir | default('/opt/powershell-analysis') }}/run-powershell-analysis",
  "screenshot_cmd": "{{ screenshot_analysis_install_dir | default('/opt/screenshot-analysis') }}/run-screenshot-analysis",
  "pdf_cmd": "{{ pdf_generation_install_dir | default('/opt/pdf-generation') }}/run-pdf-generation",
  "interpret_cmd": "{{ interpret_install_dir | default('/opt/interpret') }}/run-interpret",
  "pcap_cmd": "{{ pcap_analysis_install_dir | default('/opt/pcap-analysis') }}/run-pcap-analysis",

  "interpret_enabled": {{ (interpret_enabled | default(true)) | to_json }},
  "interpret_timeout": {{ interpret_timeout | default(300) }},
  "reports_dir": {{ pipeline_reports_dir | to_json }},
  "cape_poll_interval": {{ pipeline_cape_poll_interval }},
  "cape_timeout": {{ pipeline_cape_timeout }},
  "pcap_enabled": {{ (pipeline_pcap_enabled | default(true)) | to_json }},
  "pcap_timeout": {{ pipeline_pcap_timeout | default(120) }},
  "evasion_hunter_enabled": {{ (pipeline_evasion_hunter_enabled | default(true)) | to_json }},
  "evasion_max_signatures": {{ pipeline_evasion_max_signatures | default(5) }},
  "evasion_min_binary_size": {{ pipeline_evasion_min_binary_size | default(51200) }},
  "volatility_ramdisk": {{ (pipeline_volatility_ramdisk | default('')) | to_json }},
  "volatility_parallel_workers": {{ pipeline_volatility_parallel_workers | default(3) }},

  "interpret": {
    "model": {{ interpret_model | default('claude-sonnet-4-6') | to_json }},
    "escalation_threshold": {{ interpret_escalation_threshold | default(5) }},
    "escalation_model": {{ interpret_escalation_model | default('claude-opus-4-6') | to_json }},
    "max_output_tokens": {{ interpret_max_output_tokens | default(2048) }},
    "max_tool_calls": {{ interpret_max_tool_calls | default(10) }},
    "max_imports": {{ interpret_max_imports | default(200) }},
    "max_strings": {{ interpret_max_strings | default(100) }},
    "max_string_length": {{ interpret_max_string_length | default(500) }},
    "summary_model": {{ pipeline_summary_model | default('local-qwen') | to_json }},
    "plain_english_model": {{ pipeline_plain_english_model | default('local-qwen') | to_json }}
  },
  "volatility_triggers": {{ pipeline_volatility_triggers | to_json }},
  "volatility_extra_plugins": {{ pipeline_volatility_extra_plugins | default({}) | to_json }},

  "db_host": {{ (postgres_listen_address | default('127.0.0.1')) | to_json }},
  "db_port": {{ postgres_port | default(5432) }},
  "db_name": {{ (postgres_db_name | default('malware_analysis')) | to_json }},
  "db_user": {{ (postgres_db_user | default('pipeline')) | to_json }},
  "relationship_max_ioc_frequency": {{ pipeline_relationship_max_ioc_frequency | default(20) }},
  "relationship_ssdeep_threshold": {{ pipeline_relationship_ssdeep_threshold | default(80) }}
}
