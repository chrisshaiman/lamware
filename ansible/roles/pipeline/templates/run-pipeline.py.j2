def run_pipeline(sample_path: Path, task_id: str, original_name: str = "") -> dict:
    """Execute the four-stage analysis pipeline."""
    report = {
        "task_id": task_id,
        "sample": str(sample_path),
        "sample_name": original_name or sample_path.name,
        "started_at": datetime.now(timezone.utc).isoformat(),
    }

    output_dir = REPORTS_DIR / task_id
    output_dir.mkdir(parents=True, exist_ok=True)

    # Stage 1: Triage (always)
    print(f"\n[Stage 1] Triage: {report['sample_name']}")
    triage_result = run_triage(sample_path, output_dir)
    report.update(triage_result)
    cape_tags = derive_tags_from_triage(triage_result)
    cape_package = derive_package_from_triage(triage_result)
    cape_filename = derive_filename(sample_path, cape_package, original_name)
    print(f"  Tags: {cape_tags}")
    if cape_package:
        print(f"  Package: {cape_package}")
    print(f"  Filename: {cape_filename}")

    # Stage 2: Cape (always, with triage-informed tags, package, and filename)
    print(f"\n[Stage 2] Cape: submitting with tags={cape_tags}, package={cape_package or 'auto'}, memory=1")
    try:
        cape_task_id = submit_to_cape(
            sample_path,
            tags=cape_tags,
            package=cape_package,
            filename=cape_filename,
            custom=f"pipeline_task_id={task_id}",
        )
        print(f"  Cape task ID: {cape_task_id}")
        cape_data = poll_cape_task(cape_task_id)
        report["cape"] = {
            "task_id": cape_task_id,
            "status": cape_data.get("status", "unknown"),
        }

        # Extract rich intelligence from Cape's full report
        if cape_data.get("status") == "reported":
            print("  Extracting Cape intelligence (signatures, network, configs)...")
            cape_intel = extract_cape_intel(cape_data)
            report["cape"].update(cape_intel)
            sig_count = len(cape_intel.get("signatures", []))
            ttp_count = len(cape_intel.get("mitre_ttps", []))
            net_keys = list(cape_intel.get("network", {}).keys())
            payloads = cape_intel.get("payloads_extracted", 0)
            print(f"  Signatures: {sig_count}, TTPs: {ttp_count}, Network: {net_keys}, Payloads: {payloads}")

    except Exception as e:
        print(f"  [!] Cape submission failed: {e}", file=sys.stderr)
        report["cape"] = {"task_id": None, "status": "error", "error": str(e)}
        cape_data = {}

    # Stage 3: Volatility (triggered by Cape signatures)
    print(f"\n[Stage 3] Volatility: checking triggers...")
    if should_run_volatility(cape_data):
        print("  Triggered — running Volatility 3")
        report["volatility"] = run_volatility(cape_data, output_dir)
    else:
        print("  Not triggered (stub — awaiting sub-project 3)")
        report["volatility"] = {"triggered": False}

    # Stage 3.5: Shellcode filtering (from malfind dumps)
    shellcode_candidates = []
    if MALFIND_ENABLED and report.get("volatility", {}).get("triggered"):
        malfind_dump_dir = output_dir / "malfind_dumps"
        malfind_output = report.get("volatility", {}).get("plugins", {}).get("malfind", [])
        print(f"\n[Stage 3.5] Shellcode filtering: scanning malfind dumps...")
        shellcode_candidates = filter_malfind_dumps(malfind_dump_dir, malfind_output)

    # Stage 4: Ghidra (triggered by dropped payloads)
    print(f"\n[Stage 4] Ghidra: checking triggers...")
    if should_run_ghidra(cape_data, sample_path):
        print("  Triggered — running Ghidra headless")
        report["ghidra"] = run_ghidra(cape_data, output_dir, sample_path,
                                      shellcode_candidates=shellcode_candidates)
    else:
        print("  Not triggered")
        report["ghidra"] = {"triggered": False}

    # Stage 4.5: LLM Interpretation (agentic, after Ghidra)
    ghidra_data = report.get("ghidra", {})
    analyzed_files = ghidra_data.get("analyzed_files", [])
    successful = [f for f in analyzed_files if f.get("analysis_success")]

    if successful:
        print(f"\n[Stage 4.5] LLM Interpretation: analyzing Ghidra output...")
        report["llm_interpretation"] = run_interpret(successful[0], output_dir)
        interp = report["llm_interpretation"]
        if interp.get("enabled") and interp.get("analysis"):
            calls = interp.get("tool_calls_used", 0)
            influenced = interp.get("possible_prompt_influence", False)
            family = interp.get("analysis", {}).get("malware_family_guess", "?")
            print(f"  Family guess: {family}")
            print(f"  Tool calls: {calls}, Influence flag: {influenced}")
        elif interp.get("error"):
            print(f"  [!] Error: {interp['error']}")
    else:
        if INTERPRET_ENABLED and ghidra_data.get("triggered"):
            print(f"\n[Stage 4.5] LLM Interpretation: skipped (no successful Ghidra analysis)")
            report["llm_interpretation"] = {"enabled": True, "reason": "no_ghidra_data"}
        else:
            report["llm_interpretation"] = {"enabled": INTERPRET_ENABLED,
                                            "reason": "ghidra_not_triggered"}

    # IOC extraction — pull actionable indicators from all stages
    print(f"\n[IOC Extraction] Scanning all stages for indicators...")
    report["extracted_iocs"] = extract_iocs(report)
    ioc_count = len(report["extracted_iocs"])
    ioc_types = {}
    for ioc in report["extracted_iocs"]:
        t = ioc["type"]
        ioc_types[t] = ioc_types.get(t, 0) + 1
    print(f"  Found {ioc_count} IOCs: {ioc_types}")

    # Stage 5: Executive summary (single-shot LLM, after all stages)
    if INTERPRET_ENABLED:
        print(f"\n[Stage 5] Executive Summary: generating...")
        report["executive_summary"] = run_summarize(report)
        summary = report["executive_summary"]
        if summary.get("executive_summary"):
            severity = summary.get("severity", "?")
            findings = len(summary.get("key_findings", []))
            print(f"  Severity: {severity}, Key findings: {findings}")
        elif summary.get("error"):
            print(f"  [!] Error: {summary['error']}")
    else:
        report["executive_summary"] = {"enabled": False, "reason": "disabled_by_config"}

    # Write merged report (includes executive summary)
    report["completed_at"] = datetime.now(timezone.utc).isoformat()
    report_path = write_report(task_id, report, REPORTS_DIR)
    print(f"\n[Done] JSON report: {report_path}")

    # Stage 6: PDF report generation
    print(f"\n[Stage 6] PDF Report: generating...")
    pdf_path = report_path.parent / "report.pdf"
    try:
        result = subprocess.run(
            ["{{ pipeline_install_dir }}/generate-report.py", str(report_path), str(pdf_path)],
            capture_output=True,
            text=True,
            timeout=60,
        )
        if result.returncode == 0:
            print(f"  PDF written to: {pdf_path}")
        else:
            print(f"  [!] PDF generation failed: {result.stderr[:200]}", file=sys.stderr)
    except subprocess.TimeoutExpired:
        print("  [!] PDF generation timed out (60s)", file=sys.stderr)
    except Exception as e:
        print(f"  [!] PDF generation error: {e}", file=sys.stderr)

    return report


def main():
    parser = argparse.ArgumentParser(
        prog="run-pipeline",
        description="Run the four-stage malware analysis pipeline.",
    )
    parser.add_argument("sample", type=Path, help="Path to the malware sample")
    parser.add_argument("--task-id", default=None,
                        help="Pipeline task ID (auto-generated if not set)")
    parser.add_argument("--filename", default="",
                        help="Original filename (used for Cape submission and reporting)")
    args = parser.parse_args()

    if not args.sample.exists():
        print(f"Error: file not found: {args.sample}", file=sys.stderr)
        sys.exit(1)

    task_id = args.task_id or uuid.uuid4().hex[:12]
    report = run_pipeline(args.sample, task_id, original_name=args.filename)

    # Print summary
    triage = report.get("triage", {})
    yara_count = len(triage.get("yara_matches", []))
    cape_status = report.get("cape", {}).get("status", "n/a")
    vol_triggered = report.get("volatility", {}).get("triggered", False)
    ghidra_triggered = report.get("ghidra", {}).get("triggered", False)

    llm_enabled = report.get("llm_interpretation", {}).get("enabled", False)
    llm_family = report.get("llm_interpretation", {}).get("analysis", {}).get("malware_family_guess", "n/a")

    print(f"\nSummary:")
    print(f"  Triage:     {yara_count} YARA matches")
    print(f"  Cape:       {cape_status}")
    print(f"  Volatility: {'triggered' if vol_triggered else 'not triggered'}")
    print(f"  Ghidra:     {'triggered' if ghidra_triggered else 'not triggered'}")
    print(f"  LLM:        {llm_family if llm_enabled else 'disabled'}")


if __name__ == "__main__":
    main()
