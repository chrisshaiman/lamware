VOLATILITY_EXTRA_PLUGINS = {{ pipeline_volatility_extra_plugins | default({}) | to_json }}


# -------------------------------------------------------------------------
# Stage 1: Triage (always)
# -------------------------------------------------------------------------

def run_triage(sample_path: Path, output_dir: Path) -> dict:
    """Run containerized triage analysis. Returns triage JSON."""
    try:
        result = subprocess.run(
            [TRIAGE_CMD, str(sample_path), str(output_dir)],
            capture_output=True,
            text=True,
            timeout=300,
        )
        if result.returncode != 0:
            print(f"  [!] Triage failed: {result.stderr[:200]}", file=sys.stderr)
            return {"error": "triage failed", "stderr": result.stderr[:500]}
        return json.loads(result.stdout)
    except subprocess.TimeoutExpired:
        print("  [!] Triage timed out (300s)", file=sys.stderr)
        return {"error": "triage timeout"}
    except json.JSONDecodeError as e:
        print(f"  [!] Triage output not valid JSON: {e}", file=sys.stderr)
        return {"error": "invalid triage output"}


def derive_tags_from_triage(triage_result: dict) -> list[str]:
    """Extract Cape routing tags from triage results."""
    triage = triage_result.get("triage", {})
    tags = triage.get("routing_tags_added", [])
    if "x64" not in tags:
        tags.insert(0, "x64")
    return tags


def derive_package_from_triage(triage_result: dict) -> str:
    """Derive Cape analysis package from triage file type detection.

    Cape uses the 'package' field to select the right analysis module.
    Without it, Cape falls back to filename extension — which fails when
    the sample has no extension (e.g., 'binary').
    """
    triage = triage_result.get("triage", {})
    file_type = triage.get("file_type", "").lower()
    file_mime = triage.get("file_mime", "").lower()

    # PE executables
    if "pe32" in file_type or file_mime == "application/x-dosexec":
        if "dll" in file_type:
            return "dll"
        return "exe"

    # Scripts
    if any(kw in file_type for kw in ["powershell", "ps1"]):
        return "ps1"
    if "python" in file_type:
        return "python"
    if "batch" in file_type or "dos batch" in file_type:
        return "bat"
    if "vbscript" in file_type or file_mime == "text/vbscript":
        return "vbs"
    if "javascript" in file_type or file_mime == "application/javascript":
        return "js"

    # Documents
    if any(kw in file_type for kw in ["word", "document", "openxml"]):
        return "doc"
    if any(kw in file_type for kw in ["excel", "spreadsheet"]):
        return "xls"
    if "pdf" in file_type or file_mime == "application/pdf":
        return "pdf"
    if "rtf" in file_type:
        return "doc"

    # Archives
    if "zip" in file_type or file_mime == "application/zip":
        return "zip"
    if "rar" in file_type:
        return "rar"

    # .NET / Java
    if "msil" in file_type or ".net" in file_type:
        return "exe"
    if "java" in file_type or file_mime == "application/java-archive":
        return "jar"

    # If triage detected it as ASCII text, check YARA for hints
    if "ascii text" in file_type or "text/plain" in file_mime:
        yara_matches = triage.get("yara_matches", [])
        rule_names = [m.get("rule", "").lower() for m in yara_matches]
        if any("base64" in r or "powershell" in r for r in rule_names):
            return "ps1"

    # Unknown — let Cape auto-detect
    return ""


# -------------------------------------------------------------------------
# Stage 2: Cape dynamic analysis (always)
# -------------------------------------------------------------------------

def cape_headers() -> dict:
    """Build Cape API auth headers."""
    if not CAPE_API_KEY or CAPE_API_KEY.startswith("PLACEHOLDER"):
        return {}
    return {"Authorization": f"Token {CAPE_API_KEY}"}


def derive_filename(sample_path: Path, package: str, original_name: str = "") -> str:
    """Derive a meaningful filename for Cape submission.

    Priority: original_name (from sample-feeder) > sample_path name with
    triage-derived extension > sample_path name as-is.
    """
    if original_name:
        return original_name
    name = sample_path.name
    if "." not in name and package:
        # No extension — append one from the detected package
        ext_map = {
            "exe": ".exe", "dll": ".dll", "ps1": ".ps1", "bat": ".bat",
            "vbs": ".vbs", "js": ".js", "doc": ".doc", "xls": ".xls",
            "pdf": ".pdf", "zip": ".zip", "rar": ".rar", "jar": ".jar",
            "python": ".py",
        }
        ext = ext_map.get(package, "")
        if ext:
            name = f"{name}{ext}"
    return name


def submit_to_cape(sample_path: Path, tags: list[str], package: str = "",
                   filename: str = "", custom: str = "") -> int:
    """Submit sample to Cape API. Returns task ID."""
    url = f"{CAPE_API_URL}/tasks/create/file/"
    submit_name = filename or sample_path.name
    data = {
        "tags": ",".join(tags),
        "memory": "1",
        "custom": custom,
    }
    if package:
        data["package"] = package
    with sample_path.open("rb") as fh:
        resp = requests.post(
            url,
            files={"file": (submit_name, fh)},
            data=data,
            headers=cape_headers(),
            timeout=30,
        )
    resp.raise_for_status()
    result = resp.json()
    if result.get("error"):
        raise ValueError(f"Cape submission error: {result.get('error_value', result)}")
    return result["data"]["task_ids"][0]


def poll_cape_task(task_id: int) -> dict:
    """Poll Cape API until task is reported or timeout."""
    url = f"{CAPE_API_URL}/tasks/view/{task_id}/"
    start = time.time()
    last_status = ""

    while time.time() - start < CAPE_TIMEOUT:
        try:
            resp = requests.get(url, headers=cape_headers(), timeout=10)
            resp.raise_for_status()
            data = resp.json().get("data", {})
            status = data.get("status", "unknown")

            if status != last_status:
                elapsed = int(time.time() - start)
                print(f"  Cape task {task_id}: {status} ({elapsed}s)")
                last_status = status

            if status == "reported":
                return data

        except requests.RequestException as e:
            print(f"  [!] Cape API error: {e}", file=sys.stderr)

        time.sleep(CAPE_POLL_INTERVAL)

    print(f"  [!] Cape timeout after {CAPE_TIMEOUT}s", file=sys.stderr)
    return {"status": "timeout", "id": task_id}


# -------------------------------------------------------------------------
# Stage 3: Volatility memory forensics
# -------------------------------------------------------------------------

def get_cape_signatures(cape_data: dict) -> list[str]:
    """Extract signature names from Cape task data."""
    # Cape stores signatures in the full report, not the task view.
    # Check the storage path for the report JSON.
    task_id = cape_data.get("id") or cape_data.get("task_id")
    if not task_id:
        return []
    report_path = Path(f"/opt/CAPEv2/storage/analyses/{task_id}/reports/report.json")
    if not report_path.exists():
        return []
    try:
        with report_path.open() as f:
            report = json.load(f)
        return [s.get("name", "") for s in report.get("signatures", [])]
    except (json.JSONDecodeError, KeyError):
        return []


def should_run_volatility(cape_data: dict) -> bool:
    """Check if Cape signatures trigger Volatility analysis."""
    if cape_data.get("status") != "reported":
        return False
    if not Path(VOLATILITY_CMD).exists():
        return False
    sigs = get_cape_signatures(cape_data)
    return any(sig in VOLATILITY_TRIGGERS for sig in sigs)


def get_memory_dump_path(cape_data: dict) -> Path | None:
    """Find the memory dump from Cape's analysis storage."""
    task_id = cape_data.get("id") or cape_data.get("task_id")
    if not task_id:
        return None
    # Cape stores memory dumps at storage/analyses/<id>/memory.dmp
    dump_path = Path(f"/opt/CAPEv2/storage/analyses/{task_id}/memory.dmp")
    if dump_path.exists():
        return dump_path
    return None


def determine_extra_plugins(cape_data: dict) -> list[str]:
    """Determine which extra Volatility plugins to run based on triggers."""
    sigs = get_cape_signatures(cape_data)
    extras = set()
    for category, config in VOLATILITY_EXTRA_PLUGINS.items():
        triggers = config.get("triggers", [])
        plugins = config.get("plugins", [])
        if any(sig in triggers for sig in sigs):
            extras.update(plugins)
    return sorted(extras)


def run_single_plugin(dump_path: Path, plugin: str, output_dir: Path) -> dict:
    """Run a single Volatility plugin. Returns parsed JSON or error."""
    # malfind and vadinfo scan every memory region — need longer timeout
    # on 4GB+ dumps these can take 10-15 minutes
    plugin_timeout = 600
    try:
        result = subprocess.run(
            [VOLATILITY_CMD, str(dump_path), plugin, str(output_dir)],
            capture_output=True,
            text=True,
            timeout=plugin_timeout,
        )
        if result.returncode != 0:
            return {"error": result.stderr[:200]}
        return json.loads(result.stdout)
    except subprocess.TimeoutExpired:
        return {"error": f"timeout ({plugin_timeout}s)"}
    except json.JSONDecodeError:
        # Volatility JSON output may have extra lines — try to extract
        lines = result.stdout.strip().split("\n")
        for line in lines:
            try:
                return json.loads(line)
            except json.JSONDecodeError:
                continue
        return {"error": "invalid JSON output", "raw": result.stdout[:500]}


def run_volatility(cape_data: dict, output_dir: Path) -> dict:
    """Run Volatility 3 plugins on the memory dump."""
    dump_path = get_memory_dump_path(cape_data)
    if not dump_path:
        return {"triggered": True, "error": "memory dump not found"}

    sigs = get_cape_signatures(cape_data)
    trigger_sigs = [s for s in sigs if s in VOLATILITY_TRIGGERS]
    extra_plugins = determine_extra_plugins(cape_data)
    all_plugins = VOLATILITY_STANDARD_PLUGINS + extra_plugins

    result = {
        "triggered": True,
        "trigger_signatures": trigger_sigs,
        "plugins_run": [p.replace("windows.", "") for p in all_plugins],
        "plugins": {},
        "summary": {
            "injected_processes": 0,
            "suspicious_connections": 0,
        },
    }

    for plugin in all_plugins:
        short_name = plugin.replace("windows.", "")
        print(f"    Running {plugin}...")
        plugin_output = run_single_plugin(dump_path, plugin, output_dir)
        result["plugins"][short_name] = plugin_output

        # Build summary from key plugins
        if short_name == "malfind" and isinstance(plugin_output, list):
            result["summary"]["injected_processes"] = len(plugin_output)
        elif short_name == "netscan" and isinstance(plugin_output, list):
            result["summary"]["suspicious_connections"] = len(plugin_output)

    # Clean up memory dump immediately after processing
    print(f"    Cleaning up memory dump ({dump_path.stat().st_size // (1024*1024)} MB)...")
    dump_path.unlink(missing_ok=True)

    return result


# -------------------------------------------------------------------------
# Stage 4: Ghidra headless static analysis
#
# SECURITY: When Ghidra output is later sent to an LLM for interpretation,
# all strings/code from the binary are adversary-controlled. The LLM
# interpretation layer (future) must:
#   1. Treat all decompiled code as untrusted (UNTRUSTED_CODE delimiters)
#   2. Never let LLM output modify verdicts or trigger pipeline actions
#   3. Log raw prompts and responses for audit
#   4. Use triage/Cape/Volatility for maliciousness — Ghidra+LLM for understanding
# -------------------------------------------------------------------------

# Cape signatures that indicate dropped/unpacked payloads worth analyzing
GHIDRA_TRIGGERS = [
    "packed_binary",
    "injection_write_process",
    "injection_rwx",
    "reflective_dll_loading",
    "shellcode_execution",
    "drops_exe",
    "creates_exe",
]


def get_dropped_pe_files(cape_data: dict) -> list[Path]:
    """Find PE files dropped during Cape analysis."""
    task_id = cape_data.get("id") or cape_data.get("task_id")
    if not task_id:
        return []
    dropped_dir = Path(f"/opt/CAPEv2/storage/analyses/{task_id}/dropped")
    if not dropped_dir.exists():
        return []
    pe_files = []
    for f in dropped_dir.iterdir():
        if f.is_file() and f.stat().st_size > 1024:  # skip tiny files
            # Check for PE magic bytes (MZ header)
            try:
                with f.open("rb") as fh:
                    magic = fh.read(2)
                if magic == b"MZ":
                    pe_files.append(f)
            except (OSError, PermissionError):
                continue
    return pe_files


def get_original_sample_path(cape_data: dict) -> Path | None:
    """Get the original submitted sample from Cape's storage."""
    task_id = cape_data.get("id") or cape_data.get("task_id")
    if not task_id:
        return None
    binary_path = Path(f"/opt/CAPEv2/storage/analyses/{task_id}/binary")
    if not binary_path.exists():
        return None
    # Check if it's a PE
    try:
        with binary_path.open("rb") as fh:
            if fh.read(2) == b"MZ":
                return binary_path
    except (OSError, PermissionError):
        pass
    return None


def should_run_ghidra(cape_data: dict, sample_path: Path) -> bool:
    """Check if Ghidra analysis should run.

    Triggers when:
    1. Cape found dropped PEs + injection/packing signatures, OR
    2. No dropped PEs but the original sample is a PE (analyze the packed binary)
    """
    if cape_data.get("status") != "reported":
        return False
    if not Path(GHIDRA_CMD).exists():
        return False

    sigs = get_cape_signatures(cape_data)
    has_trigger = any(sig in GHIDRA_TRIGGERS for sig in sigs)
    has_dropped_pes = len(get_dropped_pe_files(cape_data)) > 0
    original_is_pe = get_original_sample_path(cape_data) is not None

    # Dropped PEs with trigger signatures — highest value analysis
    if has_trigger and has_dropped_pes:
        return True
    # Original sample is a PE — analyze even without dropped files
    if original_is_pe:
        return True

    return False


def run_ghidra_on_file(pe_path: Path, output_dir: Path) -> dict:
    """Run Ghidra headless on a single PE file."""
    try:
        result = subprocess.run(
            [GHIDRA_CMD, str(pe_path), str(output_dir)],
            capture_output=True,
            text=True,
            timeout=600,
        )
        if result.returncode != 0:
            return {"error": result.stderr[:200], "filename": pe_path.name}
        output = json.loads(result.stdout)
        return output
    except subprocess.TimeoutExpired:
        return {"error": "timeout (600s)", "filename": pe_path.name}
    except json.JSONDecodeError:
        return {"error": "invalid JSON output", "filename": pe_path.name,
                "raw": result.stdout[:500]}


def run_ghidra(cape_data: dict, output_dir: Path, sample_path: Path) -> dict:
    """Run Ghidra headless on dropped PEs and/or the original sample."""
    pe_files = get_dropped_pe_files(cape_data)
    original_pe = get_original_sample_path(cape_data)

    # If no dropped PEs, analyze the original sample
    if not pe_files and original_pe:
        pe_files = [original_pe]
        trigger_reason = "original_sample_is_pe"
    elif pe_files:
        trigger_reason = "dropped_pe_with_signatures"
    else:
        return {"triggered": True, "error": "no PE files found"}

    sigs = get_cape_signatures(cape_data)
    trigger_sigs = [s for s in sigs if s in GHIDRA_TRIGGERS]

    result = {
        "triggered": True,
        "trigger_reason": "dropped_pe_with_signatures",
        "trigger_signatures": trigger_sigs,
        "analyzed_files": [],
    }

    # Analyze up to 5 dropped PEs (avoid spending hours on prolific droppers)
    for pe_path in pe_files[:5]:
        print(f"    Analyzing {pe_path.name}...")
        file_result = run_ghidra_on_file(pe_path, output_dir)
        result["analyzed_files"].append(file_result)

    return result


# -------------------------------------------------------------------------
# Stage 4.5: LLM Interpretation (agentic loop)
#
# The orchestrator brokers JSON lines between two containers:
#   - interpret container (--network=host) holds the Claude conversation
#   - Ghidra tool container (--network=none) executes per-query
#
# Tool arguments are validated via regex whitelist before reaching Ghidra.
# -------------------------------------------------------------------------

def validate_tool_args(tool_name: str, args: dict) -> str | None:
    """Validate tool arguments against regex whitelist. Returns error or None."""
    validators = TOOL_ARG_VALIDATORS.get(tool_name)
    if validators is None:
        return f"Unknown tool: {tool_name}"
    for arg_name, arg_value in args.items():
        pattern = validators.get(arg_name)
        if pattern is None:
            continue
        if not re.match(pattern, str(arg_value)):
            return f"Invalid {arg_name}: must match {pattern}"
    if "range" in args:
        try:
            if int(args["range"]) > 4096:
                return "range must be <= 4096"
        except (ValueError, TypeError):
            return "range must be numeric"
    if "length" in args:
        try:
            if int(args["length"]) > 65536:
                return "length must be <= 65536"
        except (ValueError, TypeError):
            return "length must be numeric"
    return None


def run_ghidra_tool(project_dir: str, program_name: str,
                    tool_name: str, tool_args: dict) -> dict:
    """Execute a single Ghidra tool call in a container."""
    try:
        result = subprocess.run(
            [GHIDRA_CMD, "--tool", project_dir, program_name,
             tool_name, json.dumps(tool_args)],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if result.returncode != 0:
            return {"error": result.stderr[:200]}
        return json.loads(result.stdout)
    except subprocess.TimeoutExpired:
        return {"error": "Ghidra tool timeout (120s)"}
    except json.JSONDecodeError:
        return {"error": "Invalid JSON from Ghidra tool",
                "raw": result.stdout[:500] if result else ""}


def check_prompt_influence(analysis: dict) -> bool:
    """Check if LLM response shows signs of prompt injection influence."""
    text = json.dumps(analysis).lower()
    return any(kw in text for kw in PROMPT_INFLUENCE_KEYWORDS)


def run_interpret(ghidra_result: dict, output_dir: Path) -> dict:
    """Run the agentic LLM interpretation loop.

    Starts the interpret container (long-running, stdin/stdout pipes),
    sends Ghidra data, brokers tool calls to Ghidra containers, and
    collects the final analysis.
    """
    if not INTERPRET_ENABLED:
        return {"enabled": False, "reason": "disabled_by_config"}
    if not Path(INTERPRET_CMD).exists():
        return {"enabled": False, "reason": "interpret_cmd_not_found"}

    project_dir = ghidra_result.get("project_dir", "")
    program_name = ghidra_result.get("program_name", "")

    start_time = time.time()

    # Start interpret container (long-running, communicates via stdin/stdout)
    try:
        proc = subprocess.Popen(
            [INTERPRET_CMD],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
        )
    except OSError as e:
        return {"enabled": True, "error": f"Failed to start interpret container: {e}"}

    # Send init message
    init_msg = json.dumps({
        "type": "init",
        "ghidra_data": ghidra_result,
        "config": INTERPRET_CONFIG,
    })
    proc.stdin.write(init_msg + "\n")
    proc.stdin.flush()

    # Audit log
    audit_dir = output_dir / "llm_audit"
    audit_dir.mkdir(parents=True, exist_ok=True)
    tool_call_log = []

    try:
        while True:
            # Check timeout
            elapsed = time.time() - start_time
            if elapsed > INTERPRET_TIMEOUT:
                proc.stdin.write(json.dumps({"type": "force_final", "reason": "timeout"}) + "\n")
                proc.stdin.flush()

            # Read response from interpret container
            line = proc.stdout.readline().strip()
            if not line:
                break

            try:
                msg = json.loads(line)
            except json.JSONDecodeError:
                continue

            msg_type = msg.get("type")

            if msg_type == "final":
                analysis = msg.get("analysis", {})
                duration = time.time() - start_time
                influenced = check_prompt_influence(analysis) if analysis else False

                result = {
                    "enabled": True,
                    "provider": "anthropic",
                    "model_initial": INTERPRET_CONFIG["model"],
                    "model_final": msg.get("model_used", INTERPRET_CONFIG["model"]),
                    "escalated": msg.get("model_used", "") != INTERPRET_CONFIG["model"],
                    "tool_calls_used": msg.get("tool_calls_used", 0),
                    "duration_seconds": round(duration, 1),
                    "possible_prompt_influence": influenced,
                    "analysis": analysis,
                    "audit": {"tool_call_log": str(audit_dir / "tool_calls.json")},
                }

                # Save audit log
                with (audit_dir / "tool_calls.json").open("w") as f:
                    json.dump(tool_call_log, f, indent=2)

                return result

            elif msg_type == "tool_call":
                tool_name = msg.get("tool", "")
                tool_args = msg.get("args", {})
                print(f"    Tool call: {tool_name}({json.dumps(tool_args)[:80]})")

                # Validate arguments
                error = validate_tool_args(tool_name, tool_args)
                if error:
                    print(f"    [!] Validation failed: {error}")
                    response = {"type": "tool_error", "tool": tool_name, "error": error}
                    tool_call_log.append({"tool": tool_name, "args": tool_args, "error": error})
                else:
                    # Execute Ghidra tool in container
                    tool_result = run_ghidra_tool(project_dir, program_name, tool_name, tool_args)
                    response = {"type": "tool_result", "tool": tool_name, "result": tool_result}
                    tool_call_log.append({"tool": tool_name, "args": tool_args, "result": tool_result})

                proc.stdin.write(json.dumps(response) + "\n")
                proc.stdin.flush()

            elif msg_type == "status":
                print(f"    LLM: {msg.get('message', '')}")

    except Exception as e:
        return {"enabled": True, "error": f"Interpret loop error: {e}"}
    finally:
        try:
            proc.terminate()
            proc.wait(timeout=5)
        except Exception:
            proc.kill()

    return {"enabled": True, "error": "Interpret container exited without final result"}


# -------------------------------------------------------------------------
# Report output
# -------------------------------------------------------------------------

def write_report(task_id: str, report: dict, reports_dir: Path) -> Path:
    """Write merged report to disk."""
    report_dir = reports_dir / task_id
    report_dir.mkdir(parents=True, exist_ok=True)
    report_path = report_dir / "report.json"
    with report_path.open("w") as f:
        json.dump(report, f, indent=2, default=str)
    return report_path


# -------------------------------------------------------------------------
# Main pipeline
# -------------------------------------------------------------------------

def run_pipeline(sample_path: Path, task_id: str, original_name: str = "") -> dict:
    """Execute the four-stage analysis pipeline."""
    report = {
        "task_id": task_id,
        "sample": str(sample_path),
        "sample_name": original_name or sample_path.name,
        "started_at": datetime.now(timezone.utc).isoformat(),
    }

    output_dir = REPORTS_DIR / task_id
    output_dir.mkdir(parents=True, exist_ok=True)

    # Stage 1: Triage (always)
    print(f"\n[Stage 1] Triage: {report['sample_name']}")
    triage_result = run_triage(sample_path, output_dir)
    report.update(triage_result)
    cape_tags = derive_tags_from_triage(triage_result)
    cape_package = derive_package_from_triage(triage_result)
    cape_filename = derive_filename(sample_path, cape_package, original_name)
    print(f"  Tags: {cape_tags}")
    if cape_package:
        print(f"  Package: {cape_package}")
    print(f"  Filename: {cape_filename}")

    # Stage 2: Cape (always, with triage-informed tags, package, and filename)
    print(f"\n[Stage 2] Cape: submitting with tags={cape_tags}, package={cape_package or 'auto'}, memory=1")
    try:
        cape_task_id = submit_to_cape(
            sample_path,
            tags=cape_tags,
            package=cape_package,
            filename=cape_filename,
            custom=f"pipeline_task_id={task_id}",
        )
        print(f"  Cape task ID: {cape_task_id}")
        cape_data = poll_cape_task(cape_task_id)
        report["cape"] = {
            "task_id": cape_task_id,
            "status": cape_data.get("status", "unknown"),
        }
    except Exception as e:
        print(f"  [!] Cape submission failed: {e}", file=sys.stderr)
        report["cape"] = {"task_id": None, "status": "error", "error": str(e)}
        cape_data = {}

    # Stage 3: Volatility (triggered by Cape signatures)
    print(f"\n[Stage 3] Volatility: checking triggers...")
    if should_run_volatility(cape_data):
        print("  Triggered — running Volatility 3")
        report["volatility"] = run_volatility(cape_data, output_dir)
    else:
        print("  Not triggered (stub — awaiting sub-project 3)")
        report["volatility"] = {"triggered": False}

    # Stage 4: Ghidra (triggered by dropped payloads)
    print(f"\n[Stage 4] Ghidra: checking triggers...")
    if should_run_ghidra(cape_data, sample_path):
        print("  Triggered — running Ghidra headless")
        report["ghidra"] = run_ghidra(cape_data, output_dir, sample_path)
    else:
        print("  Not triggered")
        report["ghidra"] = {"triggered": False}

    # Stage 4.5: LLM Interpretation (agentic, after Ghidra)
    ghidra_data = report.get("ghidra", {})
    analyzed_files = ghidra_data.get("analyzed_files", [])
    successful = [f for f in analyzed_files if f.get("analysis_success")]

    if successful:
        print(f"\n[Stage 4.5] LLM Interpretation: analyzing Ghidra output...")
        report["llm_interpretation"] = run_interpret(successful[0], output_dir)
        interp = report["llm_interpretation"]
        if interp.get("enabled") and interp.get("analysis"):
            calls = interp.get("tool_calls_used", 0)
            influenced = interp.get("possible_prompt_influence", False)
            family = interp.get("analysis", {}).get("malware_family_guess", "?")
            print(f"  Family guess: {family}")
            print(f"  Tool calls: {calls}, Influence flag: {influenced}")
        elif interp.get("error"):
            print(f"  [!] Error: {interp['error']}")
    else:
        if INTERPRET_ENABLED and ghidra_data.get("triggered"):
            print(f"\n[Stage 4.5] LLM Interpretation: skipped (no successful Ghidra analysis)")
            report["llm_interpretation"] = {"enabled": True, "reason": "no_ghidra_data"}
        else:
            report["llm_interpretation"] = {"enabled": INTERPRET_ENABLED,
                                            "reason": "ghidra_not_triggered"}

    # Write merged report
    report["completed_at"] = datetime.now(timezone.utc).isoformat()
    report_path = write_report(task_id, report, REPORTS_DIR)
    print(f"\n[Done] Report: {report_path}")

    return report


def main():
    parser = argparse.ArgumentParser(
        prog="run-pipeline",
        description="Run the four-stage malware analysis pipeline.",
    )
    parser.add_argument("sample", type=Path, help="Path to the malware sample")
    parser.add_argument("--task-id", default=None,
                        help="Pipeline task ID (auto-generated if not set)")
    parser.add_argument("--filename", default="",
                        help="Original filename (used for Cape submission and reporting)")
    args = parser.parse_args()

    if not args.sample.exists():
        print(f"Error: file not found: {args.sample}", file=sys.stderr)
        sys.exit(1)

    task_id = args.task_id or uuid.uuid4().hex[:12]
    report = run_pipeline(args.sample, task_id, original_name=args.filename)

    # Print summary
    triage = report.get("triage", {})
    yara_count = len(triage.get("yara_matches", []))
    cape_status = report.get("cape", {}).get("status", "n/a")
    vol_triggered = report.get("volatility", {}).get("triggered", False)
    ghidra_triggered = report.get("ghidra", {}).get("triggered", False)

    llm_enabled = report.get("llm_interpretation", {}).get("enabled", False)
    llm_family = report.get("llm_interpretation", {}).get("analysis", {}).get("malware_family_guess", "n/a")

    print(f"\nSummary:")
    print(f"  Triage:     {yara_count} YARA matches")
    print(f"  Cape:       {cape_status}")
    print(f"  Volatility: {'triggered' if vol_triggered else 'not triggered'}")
    print(f"  Ghidra:     {'triggered' if ghidra_triggered else 'not triggered'}")
    print(f"  LLM:        {llm_family if llm_enabled else 'disabled'}")


if __name__ == "__main__":
    main()
