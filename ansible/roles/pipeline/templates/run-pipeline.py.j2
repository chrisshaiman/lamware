INTERPRET_CMD = "{{ interpret_install_dir | default('/opt/interpret') }}/run-interpret"
INTERPRET_ENABLED = {{ (interpret_enabled | default(true)) | to_json }}
INTERPRET_TIMEOUT = {{ interpret_timeout | default(300) }}
INTERPRET_CONFIG = {
    "model": "{{ interpret_model | default('claude-sonnet-4-6') }}",
    "escalation_threshold": {{ interpret_escalation_threshold | default(5) }},
    "escalation_model": "{{ interpret_escalation_model | default('claude-opus-4-6') }}",
    "max_output_tokens": {{ interpret_max_output_tokens | default(2048) }},
    "max_tool_calls": {{ interpret_max_tool_calls | default(10) }},
    "max_imports": {{ interpret_max_imports | default(200) }},
    "max_strings": {{ interpret_max_strings | default(100) }},
    "max_string_length": {{ interpret_max_string_length | default(500) }},
}
REPORTS_DIR = Path("{{ pipeline_reports_dir }}")
CAPE_POLL_INTERVAL = {{ pipeline_cape_poll_interval }}
CAPE_TIMEOUT = {{ pipeline_cape_timeout }}

# Tool argument validation — regex whitelist per tool
TOOL_ARG_VALIDATORS = {
    "decompile_function": {"name": r"^.{1,200}$"},
    "get_xrefs_to": {"name": r"^.{1,200}$"},
    "get_xrefs_from": {"name": r"^.{1,200}$"},
    "get_strings_at": {"address": r"^0x[0-9a-fA-F]{1,16}$", "range": r"^[0-9]{1,6}$"},
    "list_functions": {"filter": r"^[A-Za-z0-9_*?]{0,100}$"},
    "get_data_at": {"address": r"^0x[0-9a-fA-F]{1,16}$", "length": r"^[0-9]{1,5}$"},
}
PROMPT_INFLUENCE_KEYWORDS = ["benign", "not malicious", "false positive", "harmless", "safe to run"]

# Volatility trigger signatures — Cape signature names that trigger Stage 3
VOLATILITY_TRIGGERS = {{ pipeline_volatility_triggers | to_json }}

# Standard Volatility plugins (always run when triggered)
VOLATILITY_STANDARD_PLUGINS = [
    "windows.psscan",
    "windows.pstree",
    "windows.malfind",
    "windows.cmdline",
    "windows.netscan",
    "windows.dlllist",
