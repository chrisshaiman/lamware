#!/bin/bash
# =============================================================================
# run-pipeline — convenience wrapper
# Passes sample path to the pipeline orchestrator script.
#
# Usage: run-pipeline <sample_path> [--task-id <id>]
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

# Unbuffered output so progress is visible in real time
export PYTHONUNBUFFERED=1

exec python3 {{ pipeline_install_dir }}/run-pipeline.py "$@"
