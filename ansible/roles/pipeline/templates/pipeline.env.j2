# Pipeline runtime secrets — sourced by the run-pipeline wrapper (set -a; . pipeline.env).
# Rendered by Ansible from the vault; NEVER commit a real value. Add future pipeline
# secrets here as KEY='{{ "{{ value }}" }}' lines.
CAPE_API_KEY='{{ cape_api_key }}'
PIPELINE_DB_PASSWORD='{{ pipeline_db_password }}'
# Reads LiteLLM's spend log for each run's cost (ADR-037); read-only viewer key.
LAMWARE_LITELLM_SPEND_KEY={{ litellm_scoped['pipeline-spend'] | mandatory }}
