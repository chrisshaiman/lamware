"""
Stage 4 (Java): CFR decompilation for JAR/class files.

Detects Java archives via file type and YARA rules, then runs
CFR to decompile Java bytecode to readable source code.

Author: Christopher Shaiman
License: Apache 2.0
"""

import json
import subprocess
from pathlib import Path


JAVA_YARA_INDICATORS = [
    "java", "jar_file", "jrat", "adwind", "strrat",
]


def is_java_binary(report: dict) -> bool:
    """Check if the sample is a Java JAR file."""
    triage = report.get("triage", {})

    # Check file type
    file_type = (triage.get("file_type", "") or "").lower()
    if "java archive" in file_type or "jar data" in file_type:
        return True

    # Check MIME type
    file_mime = (triage.get("file_mime", "") or "").lower()
    if file_mime in ("application/java-archive", "application/x-java-archive"):
        return True

    # Check filename extension — JARs are ZIP archives internally,
    # so file/magic often returns "Zip archive" instead of "Java archive"
    sample_name = report.get("sample_name", "")
    if sample_name.lower().endswith(".jar"):
        return True

    # Check YARA matches
    for match in triage.get("yara_matches", []):
        rule = match.get("rule", "").lower()
        if any(indicator in rule for indicator in JAVA_YARA_INDICATORS):
            return True

    return False


def run_java_analysis(binary_path: Path, output_dir: Path,
                      java_cmd: str, timeout: int = 120) -> dict:
    """Run CFR decompilation on a Java JAR file.

    Returns structured JSON with decompiled Java source, class listing,
    manifest metadata, and strings of interest.
    """
    try:
        result = subprocess.run(
            [java_cmd, str(binary_path), str(output_dir)],
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except FileNotFoundError:
        return {"error": f"java analysis command not found: {java_cmd}",
                "analysis_success": False}
    except subprocess.TimeoutExpired:
        return {"error": f"java analysis timed out ({timeout}s)",
                "analysis_success": False}

    # Try parsing stdout as JSON first
    try:
        output = json.loads(result.stdout)
        return output
    except json.JSONDecodeError:
        pass

    if result.returncode != 0:
        return {"error": f"java analysis failed: {result.stderr[:300]}",
                "analysis_success": False}

    return {"error": f"No valid JSON in java output: {result.stdout[:200]}",
            "analysis_success": False}
