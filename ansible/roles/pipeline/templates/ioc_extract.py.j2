def map_iocs_to_techniques(report: dict, iocs: list[dict]) -> list[dict]:
    """Map IOCs to MITRE techniques using programmatic rules.

    Returns list of mapping dicts ready for db_ingest:
    {ioc_type, ioc_value, technique_id, technique_name, evidence, method, confidence}
    """
    mappings = []
    seen = set()  # dedup by (ioc_value, technique_id)

    for ioc in iocs:
        ioc_type = ioc.get("type", "")
        ioc_value = ioc.get("value", "")
        ioc_source = ioc.get("source", "")
        ioc_context = ioc.get("context", "").lower()

        for rule in IOC_TECHNIQUE_RULES:
            # Match IOC type
            if rule.get("ioc_type") and rule["ioc_type"] != ioc_type:
                continue
            # Match source (if specified)
            if rule.get("source") and rule["source"] != ioc_source:
                continue
            # Match context substring (if specified)
            if rule.get("context_contains") and rule["context_contains"].lower() not in ioc_context:
                continue
            # Match value substring (if specified)
            if rule.get("value_contains") and rule["value_contains"].lower() not in ioc_value.lower():
                continue

            key = (ioc_value, rule["technique"])
            if key in seen:
                continue
            seen.add(key)

            mappings.append({
                "ioc_type": ioc_type,
                "ioc_value": ioc_value,
                "technique_id": rule["technique"],
                "technique_name": rule.get("technique_name", ""),
                "evidence": rule["evidence"],
                "method": "programmatic",
                "confidence": "high",
            })

    return mappings
