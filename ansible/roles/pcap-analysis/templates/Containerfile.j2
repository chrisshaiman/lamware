# PCAP analysis container — Zeek + Suricata for network traffic analysis
# Reads PCAP files, produces structured logs and IDS alerts.
# Built locally by Ansible. Never pulled from a registry.
#
# Hermetic (ADR-023): built with --network=none. The base image is pinned by
# digest. lamware-fetch resolved two package sets before the build: `main`
# (Suricata, python3, jq) from a pinned Ubuntu snapshot, and `zeek` from the
# openSUSE OBS repo, verified against the role's checksummed signing key. The
# image no longer configures any repo, so gnupg and ca-certificates, which were
# here only to add the Zeek repo, are gone, as curl went before them: fewer
# tools in a container that parses attacker-controlled PCAPs.
FROM {{ pcap_analysis_base_image }}

# Each set was resolved against this base on its own, so each installs on its
# own. A package both sets need is the same version in both (same snapshot);
# the second dpkg -i reinstalls it unchanged.
COPY debs/main/ /tmp/debs/main/
COPY debs/zeek/ /tmp/debs/zeek/
RUN dpkg -i /tmp/debs/main/*.deb \
    && dpkg -i /tmp/debs/zeek/*.deb \
    && rm -rf /tmp/debs

ENV PATH="/opt/zeek/bin:${PATH}"

COPY analyze-pcap.py /opt/analyze-pcap.py
COPY suricata.yaml /etc/suricata/suricata.yaml
RUN chmod +x /opt/analyze-pcap.py

# Create working directories
RUN mkdir -p /output /rules /nonexistent && chmod 777 /nonexistent /output
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/analyze-pcap.py"]
