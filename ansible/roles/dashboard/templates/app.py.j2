@app.route("/")
def index():
    """Dashboard home — recent analyses list."""
    search = request.args.get("q", "").strip()
    # Escape LIKE metacharacters in search term
    safe_search = search.replace("%", r"\%").replace("_", r"\_") if search else ""

    with db_connection() as cur:
        if search:
            cur.execute("""
                SELECT a.id, a.task_id, s.sha256, s.filename, s.file_type,
                       a.malware_family_guess, a.severity, a.malscore,
                       a.started_at, a.completed_at, a.interpret_tool_calls,
                       (SELECT COUNT(*) FROM analysis_iocs ai WHERE ai.analysis_id = a.id) AS ioc_count,
                       (SELECT COUNT(*) FROM analysis_techniques at2 WHERE at2.analysis_id = a.id) AS technique_count,
                       (SELECT COUNT(*) FROM signatures sg WHERE sg.analysis_id = a.id) AS sig_count
                FROM analyses a
                JOIN samples s ON s.id = a.sample_id
                WHERE s.sha256 ILIKE %s ESCAPE '\\'
                   OR s.filename ILIKE %s ESCAPE '\\'
                   OR a.malware_family_guess ILIKE %s ESCAPE '\\'
                   OR a.task_id ILIKE %s ESCAPE '\\'
                ORDER BY a.started_at DESC
                LIMIT 50
            """, (f"%{safe_search}%", f"%{safe_search}%", f"%{safe_search}%", f"%{safe_search}%"))
        else:
            cur.execute("""
                SELECT a.id, a.task_id, s.sha256, s.filename, s.file_type,
                       a.malware_family_guess, a.severity, a.malscore,
                       a.started_at, a.completed_at, a.interpret_tool_calls,
                       (SELECT COUNT(*) FROM analysis_iocs ai WHERE ai.analysis_id = a.id) AS ioc_count,
                       (SELECT COUNT(*) FROM analysis_techniques at2 WHERE at2.analysis_id = a.id) AS technique_count,
                       (SELECT COUNT(*) FROM signatures sg WHERE sg.analysis_id = a.id) AS sig_count
                FROM analyses a
                JOIN samples s ON s.id = a.sample_id
                ORDER BY a.started_at DESC
                LIMIT 50
            """)

        analyses = cur.fetchall()

    rows = ""
    for a in analyses:
        sha_short = a["sha256"][:16] + "..." if a["sha256"] else "?"
        started = a["started_at"].strftime("%Y-%m-%d %H:%M") if a["started_at"] else "?"
        rows += f"""<tr>
            <td><a href="/analysis/{a['id']}">{escape(a['task_id'])}</a></td>
            <td class="mono">{escape(sha_short)}</td>
            <td>{escape(a['filename'] or '?')}</td>
            <td>{escape(a['malware_family_guess'] or '?')}</td>
            <td>{severity_badge(a['severity'])}</td>
            <td>{a['malscore'] or '?'}</td>
            <td>{a['ioc_count']}</td>
            <td>{a['technique_count']}</td>
            <td>{a['sig_count']}</td>
            <td>{started}</td>
        </tr>"""

    return render_template_string("""{% raw %}<!DOCTYPE html><html><head>
        <title>Malware Analysis Dashboard</title>
        <style>{{ css }}</style>
    </head><body>
        <header>
            <h1>Malware Analysis Dashboard</h1>
            <nav><a href="/">Analyses</a> <a href="/status">Status</a> <a href="/iocs">IOCs</a> <a href="/techniques">ATT&CK</a></nav>
            <form action="/" method="get" style="margin-left:auto;">
                <input class="search-box" name="q" placeholder="Search hash, filename, family..." value="{{ search }}">
            </form>
        </header>
        <div class="container">
            <h2>Recent Analyses</h2>
            <table>
                <tr><th>Task</th><th>SHA256</th><th>Filename</th><th>Family</th>
                    <th>Severity</th><th>Score</th><th>IOCs</th><th>ATT&CK</th>
                    <th>Sigs</th><th>Date</th></tr>
                {{ rows }}
            </table>
        </div>
    </body></html>{% endraw %}""", css=Markup(CSS), rows=Markup(rows), search=search)


@app.route("/analysis/<int:analysis_id>")
def analysis_detail(analysis_id):
    """Detailed view of a single analysis."""
    with db_connection() as cur:
        # Main analysis
        cur.execute("""
            SELECT a.*, s.sha256, s.filename, s.file_type, s.file_mime, s.entropy, s.ssdeep
            FROM analyses a JOIN samples s ON s.id = a.sample_id
            WHERE a.id = %s
        """, (analysis_id,))
        a = cur.fetchone()
        if not a:
            abort(404)

        # IOCs
        cur.execute("""
            SELECT iv.id AS ioc_id, iv.type, iv.value, ai.source_stage, ai.context
            FROM analysis_iocs ai
            JOIN ioc_values iv ON iv.id = ai.ioc_id
            WHERE ai.analysis_id = %s
            ORDER BY ai.source_stage, iv.type
        """, (analysis_id,))
        iocs = cur.fetchall()

        # Techniques
        cur.execute("""
            SELECT tv.technique_id, tv.technique_name, tv.tactics, at2.source_stage, at2.source_detail
            FROM analysis_techniques at2
            JOIN technique_values tv ON tv.id = at2.technique_id
            WHERE at2.analysis_id = %s
            ORDER BY tv.technique_id
        """, (analysis_id,))
        techniques = cur.fetchall()

        # Capabilities
        cur.execute("""
            SELECT description, source_stage FROM capabilities
            WHERE analysis_id = %s
        """, (analysis_id,))
        capabilities = cur.fetchall()

        # Signatures (top 20 by severity)
        cur.execute("""
            SELECT name, severity, description FROM signatures
            WHERE analysis_id = %s ORDER BY severity DESC LIMIT 20
        """, (analysis_id,))
        signatures = cur.fetchall()

        # IOC-technique mappings
        cur.execute("""
            SELECT itm.ioc_id, tv.technique_id, tv.technique_name,
                   itm.evidence, itm.method, itm.confidence
            FROM ioc_technique_mappings itm
            JOIN technique_values tv ON tv.id = itm.technique_id
            WHERE itm.analysis_id = %s
        """, (analysis_id,))
        ioc_tech_maps = cur.fetchall()

        # Build lookup: ioc_id → list of technique mappings
        ioc_techniques = {}
        for m in ioc_tech_maps:
            ioc_id = m["ioc_id"]
            if ioc_id not in ioc_techniques:
                ioc_techniques[ioc_id] = []
            ioc_techniques[ioc_id].append(m)

        # Network events
        cur.execute("""
            SELECT event_type, dns_query, dns_type, http_method, http_url, http_host,
                   src_ip, src_port, dst_ip, dst_port
            FROM network_events WHERE analysis_id = %s LIMIT 50
        """, (analysis_id,))
        network = cur.fetchall()

    # Extract cross-correlation findings from report JSON
    report_json = a.get("report_json") or {}
    correlations = report_json.get("cross_correlations", [])

    # Build cross-correlation rows
    corr_rows = ""
    for c in correlations:
        sev = c.get("severity", "info")
        sev_color = {"critical": "#da3633", "high": "#d29922", "medium": "#3fb950",
                     "low": "#388bfd"}.get(sev, "#8b949e")
        sources = ", ".join(c.get("sources", []))
        mitre = c.get("mitre", "")
        detail = c.get("detail", "")
        before_data = c.get("before", "")
        after_data = c.get("after", "")
        corr_rows += f"""<tr>
            <td><span style="color:{sev_color};font-weight:bold;text-transform:uppercase;">{escape(sev)}</span></td>
            <td><strong>{escape(c.get('title', ''))}</strong></td>
            <td style="font-size:11px;">{escape(sources)}</td>
            <td style="font-size:11px;">{escape(mitre)}</td>
        </tr>"""
        if detail or before_data or after_data:
            extra = ""
            if before_data:
                extra += f"<strong>Before:</strong> {escape(str(before_data)[:200])}<br>"
            if after_data:
                extra += f"<strong>After:</strong> {escape(str(after_data)[:200])}<br>"
            if detail:
                extra += escape(str(detail)[:300])
            corr_rows += f"""<tr><td colspan="4" style="padding-left:24px;font-size:11px;color:#8b949e;border-bottom:1px solid #30363d;">{extra}</td></tr>"""

    # Build IOC rows with linked MITRE techniques
    ioc_rows = ""
    for ioc in iocs:
        # Linked techniques for this IOC
        linked = ioc_techniques.get(ioc["ioc_id"], [])
        tech_badges = ""
        for m in linked:
            method_class = "method-llm" if m["method"] == "llm" else "method-programmatic"
            method_label = "AI" if m["method"] == "llm" else ""
            tech_badges += (
                f'<span class="tag" title="{escape(m["evidence"] or "")}">'
                f'{escape(m["technique_id"])}'
                f'<span class="method-badge {method_class}">{method_label}</span>'
                f'</span> '
            )

        ioc_rows += f"""<tr>
            <td>{source_badge(ioc['source_stage'])}</td>
            <td>{escape(ioc['type'])}</td>
            <td class="mono">{escape(ioc['value'])}</td>
            <td style="font-size:11px;color:#8b949e;">{escape(ioc['context'] or '')}{' ' + tech_badges if tech_badges else ''}</td>
        </tr>"""

    # Build technique rows
    tech_rows = ""
    for t in techniques:
        tactics = ", ".join(t["tactics"]) if t["tactics"] else ""
        tech_rows += f"""<tr>
            <td>{source_badge(t['source_stage'])}</td>
            <td><strong>{escape(t['technique_id'])}</strong></td>
            <td>{escape(t['technique_name'])}</td>
            <td style="font-size:11px;">{escape(tactics)}</td>
        </tr>"""

    # Build capability rows
    cap_rows = ""
    for c in capabilities:
        cap_rows += f"<li>{source_badge(c['source_stage'])} {escape(c['description'])}</li>"

    # Build signature rows
    sig_rows = ""
    for s in signatures:
        sev_color = {3: "#da3633", 2: "#d29922", 1: "#3fb950"}.get(s["severity"], "#666")
        sig_rows += f"""<tr>
            <td><span style="color:{sev_color};font-weight:bold;">{s['severity']}</span></td>
            <td>{escape(s['name'])}</td>
            <td style="font-size:11px;">{escape((s['description'] or '')[:150])}</td>
        </tr>"""

    # Build network rows — filter known benign Windows noise
    benign_domains = {
        "connectivity.microsoft.com", "settings-win.data.microsoft.com",
        "mobile.events.data.microsoft.com", "msedge.api.cdp.microsoft.com",
        "storeedge.microsoft.com", "v10.events.data.microsoft.com",
        "watson.telemetry.microsoft.com", "www.msftconnecttest.com",
        "ipv6.msftconnecttest.com", "msftconnecttest.com",
        "www.bing.com", "bing.com", "dns.msftncsi.com",
        "login.live.com", "windowsupdate.com", "ctldl.windowsupdate.com",
        "ocsp.digicert.com", "crl.microsoft.com", "time.windows.com",
    }
    net_rows = ""
    for n in network:
        if n["event_type"] == "dns":
            query = n["dns_query"] or ""
            if query.lower() in benign_domains:
                continue
            net_rows += f"<tr><td>DNS</td><td>{escape(query)}</td><td>{escape(n['dns_type'] or '')}</td></tr>"
        elif n["event_type"] == "http":
            net_rows += f"<tr><td>HTTP</td><td>{escape(n['http_method'])} {escape(n['http_url'])}</td><td>{escape(n['http_host'] or '')}</td></tr>"
        elif n["event_type"] == "tcp":
            net_rows += f"<tr><td>TCP</td><td>{escape(n['src_ip'])}:{n['src_port']} → {escape(n['dst_ip'])}:{n['dst_port']}</td><td></td></tr>"

    sha_short = a["sha256"][:16] + "..." if a["sha256"] else "?"
    pdf_link = f"/pdf/{a['task_id']}" if a["pdf_generated"] else ""

    return render_template_string("""{% raw %}<!DOCTYPE html><html><head>
        <title>Analysis {{ task_id }} — Dashboard</title>
        <style>{{ css }}</style>
    </head><body>
        <header>
            <h1>Malware Analysis Dashboard</h1>
            <nav><a href="/">Analyses</a> <a href="/status">Status</a> <a href="/iocs">IOCs</a> <a href="/techniques">ATT&CK</a></nav>
        </header>
        <div class="container">
            <h2>Analysis: {{ task_id }}</h2>
            <div class="stat-grid">
                <div class="stat-box"><div class="number">{{ severity_badge }}</div><div class="label">Severity</div></div>
                <div class="stat-box"><div class="number">{{ malscore }}</div><div class="label">Malscore</div></div>
                <div class="stat-box"><div class="number">{{ ioc_count }}</div><div class="label">IOCs</div></div>
                <div class="stat-box"><div class="number">{{ tech_count }}</div><div class="label">ATT&CK</div></div>
                <div class="stat-box"><div class="number">{{ sig_count }}</div><div class="label">Signatures</div></div>
                <div class="stat-box"><div class="number">{{ tool_calls }}</div><div class="label">AI Tool Calls</div></div>
            </div>

            <div class="card">
                <h3>Sample</h3>
                <table>
                    <tr><td style="width:120px;color:#8b949e;">SHA256</td><td class="mono">{{ sha256 }}</td></tr>
                    <tr><td style="color:#8b949e;">Filename</td><td>{{ filename }}</td></tr>
                    <tr><td style="color:#8b949e;">Family</td><td><strong>{{ family }}</strong></td></tr>
                    <tr><td style="color:#8b949e;">File Type</td><td>{{ file_type }}</td></tr>
                    {% if pdf_link %}<tr><td style="color:#8b949e;">PDF Report</td><td><a href="{{ pdf_link }}">Download PDF</a></td></tr>{% endif %}
                </table>
            </div>

            {% if executive_summary %}
            <div class="card">
                <h3>Executive Summary</h3>
                <div class="narrative">{{ executive_summary }}</div>
            </div>
            {% endif %}

            {% if corr_rows %}
            <div class="card">
                <h3>Cross-Tool Correlation Findings</h3>
                <table><tr><th>Severity</th><th>Finding</th><th>Sources</th><th>MITRE</th></tr>{{ corr_rows }}</table>
            </div>
            {% endif %}

            {% if narrative %}
            <div class="card">
                <h3>AI Reverse Engineering Analysis</h3>
                <div class="narrative">{{ narrative }}</div>
            </div>
            {% endif %}

            {% if ioc_rows %}
            <div class="card">
                <h3>Indicators of Compromise ({{ ioc_count }})</h3>
                <table><tr><th>Source</th><th>Type</th><th>Value</th><th>Context</th></tr>{{ ioc_rows }}</table>
            </div>
            {% endif %}

            {% if tech_rows %}
            <div class="card">
                <h3>MITRE ATT&CK ({{ tech_count }})</h3>
                <table><tr><th>Source</th><th>ID</th><th>Technique</th><th>Tactics</th></tr>{{ tech_rows }}</table>
            </div>
            {% endif %}

            {% if cap_rows %}
            <div class="card">
                <h3>Capabilities</h3>
                <ul style="list-style:none;padding:0;">{{ cap_rows }}</ul>
            </div>
            {% endif %}

            {% if sig_rows %}
            <div class="card">
                <h3>Behavioral Signatures (Cape)</h3>
                <table><tr><th>Sev</th><th>Name</th><th>Description</th></tr>{{ sig_rows }}</table>
            </div>
            {% endif %}

            {% if net_rows %}
            <div class="card">
                <h3>Network Activity</h3>
                <table><tr><th>Type</th><th>Detail</th><th>Host</th></tr>{{ net_rows }}</table>
            </div>
            {% endif %}
        </div>
    </body></html>{% endraw %}""",
        css=Markup(CSS), task_id=a["task_id"],
        severity_badge=Markup(severity_badge(a["severity"])),
        malscore=a["malscore"] or "?",
        ioc_count=len(iocs), tech_count=len(techniques), sig_count=len(signatures),
        tool_calls=a["interpret_tool_calls"] or 0,
        sha256=escape(a["sha256"]), filename=escape(a["filename"] or "?"),
        family=escape(a["malware_family_guess"] or "?"),
