            pass

    # Read daily cost from database
    daily_cost = 0.0
    weekly_cost = 0.0
    try:
        with db_connection() as cur:
            cur.execute("""
                SELECT COALESCE(SUM(llm_cost_usd), 0) AS total
                FROM analyses
                WHERE started_at > NOW() - INTERVAL '1 day'
            """)
            daily_cost = float(cur.fetchone()["total"])
            cur.execute("""
                SELECT COALESCE(SUM(llm_cost_usd), 0) AS total
                FROM analyses
                WHERE started_at > NOW() - INTERVAL '7 days'
            """)
            weekly_cost = float(cur.fetchone()["total"])
    except Exception as e:
        import traceback
        app.logger.error(f"Cost query failed: {e}\n{traceback.format_exc()}")

    # Network monitor details
    net = {}
    net_path = Path("/opt/network-monitor/status.json")
    if net_path.exists():
        try:
            with open(net_path) as f:
                net = json.load(f)
        except Exception:
            pass

    # Latest digest
    digest = {}
    digest_path = Path("/opt/ntfy-alerts/latest-digest.json")
    try:
        if digest_path.exists():
            with open(digest_path) as f:
                digest = json.load(f)
    except Exception:
        pass

    return render_template_string("""{% raw %}<!DOCTYPE html><html><head>
        <title>Operational Alerts — Dashboard</title>
        <style>{{ css }}</style>
    </head><body>
        {{ alert_banner }}
        <header>
            <h1>Malware Analysis Dashboard</h1>
            <nav>
                <a href="/">Analyses</a>
                <a href="/status">Status</a>
                <a href="/iocs">IOCs</a>
                <a href="/techniques">ATT&CK</a>
                <a href="/alerts" style="color:#f0883e;">Alerts</a>
            </nav>
        </header>
        <div class="container">
            <h2>Operational Health</h2>

            <div class="stat-grid">
                <div class="stat-box">
                    <div class="number" style="color:{{ '#da3633' if net_status == 'alert' else '#3fb950' if net_status == 'ok' else '#8b949e' }};">
                        {{ net_status|upper }}</div>
                    <div class="label">Network (Air-Gap)</div>
                </div>
                <div class="stat-box">
                    <div class="number" style="color:{{ '#da3633' if paused else '#3fb950' }};">
                        {{ 'PAUSED' if paused else 'ACTIVE' }}</div>
                    <div class="label">Auto-Feeder</div>
                </div>
                <div class="stat-box">
                    <div class="number" style="color:{{ '#da3633' if disk > 80 else '#d29922' if disk > 70 else '#3fb950' }};">
                        {{ disk }}%</div>
                    <div class="label">Disk Usage</div>
                </div>
                <div class="stat-box">
                    <div class="number">${{ '%.2f'|format(daily_cost) }}</div>
                    <div class="label">Cost Today</div>
                </div>
            </div>

            <div class="card">
                <h3>Network Monitor</h3>
                <p>Last check: {{ net_last_check or 'never' }}</p>
                <p>Detonation → Internet: {{ net_det_internet_drop }} dropped, {{ net_det_internet_accept }} accepted</p>
                <p>Detonation → Management: {{ net_det_mgmt_drop }} dropped, {{ net_det_mgmt_accept }} accepted</p>
                {% if net_alert %}<p style="color:#da3633;font-weight:bold;">{{ net_alert }}</p>{% endif %}
            </div>

            <div class="card">
                <h3>Auto-Feeder</h3>
                <p>Samples today: {{ feeder_today_samples }} | Total: {{ feeder_total }}</p>
                <p>Cost today: ${{ '%.2f'|format(feeder_today_cost) }} / ${{ '%.2f'|format(feeder_budget) }}</p>
                <p>Consecutive failures: {{ feeder_failures }}</p>
                {% if feeder_last_failure %}<p>Last failure: {{ feeder_last_failure_reason }} ({{ feeder_last_failure }})</p>{% endif %}
                <p>Last success: {{ feeder_last_success or 'never' }}</p>
            </div>

            <div class="card">
                <h3>Cost Summary</h3>
                <p>Today: ${{ '%.2f'|format(daily_cost) }} | This week: ${{ '%.2f'|format(weekly_cost) }}</p>
            </div>

            {% if digest_html %}
            <div class="card">
                <h3>Latest Daily Digest</h3>
                <div class="narrative" style="font-size:13px;">{{ digest_html }}</div>
                <p style="font-size:11px;color:#8b949e;">Generated: {{ digest_time }}</p>
            </div>
            {% endif %}

            {% if log_errors %}
            <div class="card">
                <h3>Recent Errors (auto-feeder log)</h3>
                <pre>{{ log_errors_text }}</pre>
            </div>
            {% endif %}
        </div>
        <div class="cat-footer">
            <div class="cat" title="Security cat is watching your malware">  /\\_/\\
 ( o.o )
  > ^ <</div>
            <div class="cat-label">security cat is watching</div>
        </div>
    </body></html>{% endraw %}""",
        css=Markup(CSS),
        alert_banner=Markup(render_alert_banner()),
        net_status=net.get("status", "unknown"),
        net_last_check=net.get("last_check", ""),
        net_det_internet_drop=net.get("detonation_to_internet", {}).get("drop_packets", 0),
        net_det_internet_accept=net.get("detonation_to_internet", {}).get("accept_packets", 0),
        net_det_mgmt_drop=net.get("detonation_to_management", {}).get("drop_packets", 0),
        net_det_mgmt_accept=net.get("detonation_to_management", {}).get("accept_packets", 0),
        net_alert=net.get("alert_message", ""),
        paused=alert["paused"],
        disk=alert["disk_percent"],
        daily_cost=daily_cost,
        weekly_cost=weekly_cost,
        feeder_today_samples=feeder.get("today_samples", 0),
        feeder_total=feeder.get("total_samples", 0),
        feeder_today_cost=feeder.get("today_cost_usd", 0),
        feeder_budget=10.0,
        feeder_failures=feeder.get("consecutive_failures", 0),
        feeder_last_failure=feeder.get("last_failure", ""),
        feeder_last_failure_reason=feeder.get("last_failure_reason", ""),
        feeder_last_success=feeder.get("last_success", ""),
        log_errors=bool(log_errors),
        log_errors_text="\n".join(log_errors),
        digest_html=Markup(render_markdown(digest.get("text", ""))),
        digest_time=digest.get("generated_at", ""),
    )


if __name__ == "__main__":
    app.run(host="{{ dashboard_bind }}", port={{ dashboard_port }}, debug=False)
