@app.route("/pdf/<task_id>")
def download_pdf(task_id):
    """Download the PDF report for an analysis."""
    import os
    pdf_path = os.path.realpath(os.path.join(REPORTS_DIR, task_id, "report.pdf"))
    # Prevent path traversal — resolved path must stay within REPORTS_DIR
    if not pdf_path.startswith(os.path.realpath(REPORTS_DIR)):
        abort(404)
    if not os.path.exists(pdf_path):
        abort(404)
    with open(pdf_path, "rb") as f:
        pdf_bytes = f.read()
    # Sanitize task_id for Content-Disposition header
    safe_name = "".join(c for c in task_id if c.isalnum() or c in "-_.")
    return Response(pdf_bytes, mimetype="application/pdf",
                    headers={"Content-Disposition": f"attachment; filename={safe_name}-report.pdf"})


