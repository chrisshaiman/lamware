@app.route("/iocs")
def iocs_list():
    """IOC browser — see all IOCs with cross-sample correlation."""
    search = request.args.get("q", "").strip()
    ioc_type = request.args.get("type", "").strip()
    safe_search = search.replace("%", r"\%").replace("_", r"\_") if search else ""

    with db_connection() as cur:
        query = """
            SELECT iv.id, iv.type, iv.value, iv.first_seen, iv.last_seen,
                   COUNT(DISTINCT a.sample_id) AS sample_count,
                   COUNT(DISTINCT a.id) AS analysis_count,
                   array_agg(DISTINCT a.malware_family_guess)
                       FILTER (WHERE a.malware_family_guess IS NOT NULL) AS families
            FROM ioc_values iv
            JOIN analysis_iocs ai ON ai.ioc_id = iv.id
            JOIN analyses a ON a.id = ai.analysis_id
        """
        params = []
        wheres = []

        if search:
            wheres.append("iv.value ILIKE %s ESCAPE '\\\\'")
            params.append(f"%{safe_search}%")
        if ioc_type:
            wheres.append("iv.type = %s")
            params.append(ioc_type)

        if wheres:
            query += " WHERE " + " AND ".join(wheres)

        query += """
            GROUP BY iv.id, iv.type, iv.value, iv.first_seen, iv.last_seen
            ORDER BY sample_count DESC, iv.last_seen DESC
            LIMIT 100
        """

        cur.execute(query, params)
        iocs = cur.fetchall()

        # Get distinct types for filter
        cur.execute("SELECT DISTINCT type FROM ioc_values ORDER BY type")
        types = [r["type"] for r in cur.fetchall()]

    rows = ""
    for ioc in iocs:
        families = ", ".join(ioc["families"]) if ioc["families"] else ""
        first = ioc["first_seen"].strftime("%Y-%m-%d") if ioc["first_seen"] else "?"
        rows += f"""<tr>
            <td>{escape(ioc['type'])}</td>
            <td class="mono">{escape(ioc['value'][:100])}</td>
            <td><strong>{ioc['sample_count']}</strong></td>
            <td style="font-size:11px;">{escape(families)}</td>
            <td>{first}</td>
        </tr>"""

    type_options = "".join(f'<option value="{t}" {"selected" if t == ioc_type else ""}>{t}</option>' for t in types)

    return render_template_string("""{% raw %}<!DOCTYPE html><html><head>
        <title>IOCs — Dashboard</title>
        <style>{{ css }}</style>
    </head><body>
        {{ alert_banner }}
        <header>
            <h1>Malware Analysis Dashboard</h1>
            <nav><a href="/">Analyses</a> <a href="/status">Status</a> <a href="/iocs">IOCs</a> <a href="/techniques">ATT&CK</a> <a href="/alerts">Alerts</a></nav>
            <form action="/iocs" method="get" style="margin-left:auto;display:flex;gap:8px;">
                <select name="type" class="search-box" style="width:150px;">
                    <option value="">All types</option>{{ type_options }}
                </select>
                <input class="search-box" name="q" placeholder="Search IOC value..." value="{{ search }}">
            </form>
        </header>
        <div class="container">
            <h2>Indicators of Compromise</h2>
            <table>
                <tr><th>Type</th><th>Value</th><th>Samples</th><th>Families</th><th>First Seen</th></tr>
                {{ rows }}
            </table>
        </div>
    </body></html>{% endraw %}""", css=Markup(CSS), rows=Markup(rows), search=search, type_options=Markup(type_options), alert_banner=Markup(render_alert_banner()))


