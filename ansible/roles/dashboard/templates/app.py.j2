@app.route("/pdf/<task_id>")
def download_pdf(task_id):
    """Download the PDF report for an analysis."""
    import os
    pdf_path = os.path.realpath(os.path.join(REPORTS_DIR, task_id, "report.pdf"))
    # Prevent path traversal — resolved path must stay within REPORTS_DIR
    if not pdf_path.startswith(os.path.realpath(REPORTS_DIR)):
        abort(404)
    if not os.path.exists(pdf_path):
        abort(404)
    with open(pdf_path, "rb") as f:
        pdf_bytes = f.read()
    # Sanitize task_id for Content-Disposition header
    safe_name = "".join(c for c in task_id if c.isalnum() or c in "-_.")
    return Response(pdf_bytes, mimetype="application/pdf",
                    headers={"Content-Disposition": f"attachment; filename={safe_name}-report.pdf"})


PIPELINE_STAGES = [
    "triage", "cape", "pcap", "volatility", "ghidra",
    "interpret", "summary", "db", "pdf",
]


@app.route("/status")
def pipeline_status():
    """Show running and recently completed pipeline analyses."""
    with db_connection() as cur:
        cur.execute("""
            SELECT a.id, a.task_id, a.pipeline_status, a.current_stage,
                   a.started_at, a.completed_at, a.stage_timings,
                   s.sha256, s.filename, a.severity, a.malware_family_guess
            FROM analyses a
            JOIN samples s ON s.id = a.sample_id
            WHERE a.pipeline_status IN ('running', 'pending')
               OR a.completed_at > NOW() - INTERVAL '2 hours'
               OR a.started_at > NOW() - INTERVAL '2 hours'
            ORDER BY a.started_at DESC
            LIMIT 20
        """)
        analyses = cur.fetchall()

        # Fetch events for running analyses
        running_events = {}
        for a in analyses:
            if a["pipeline_status"] in ("running", "pending"):
                cur.execute("""
                    SELECT stage, status, detail, created_at
                    FROM pipeline_stage_events
                    WHERE analysis_id = %s
                    ORDER BY created_at
                """, (a["id"],))
                running_events[a["id"]] = cur.fetchall()

    rows = ""
    for a in analyses:
        status = a["pipeline_status"] or "completed"
        status_color = {
            "running": "#f9a825", "completed": "#3fb950",
            "failed": "#da3633", "pending": "#8b949e",
        }.get(status, "#8b949e")

        sha_short = a["sha256"][:12] + "..." if a["sha256"] else "?"
        started = a["started_at"].strftime("%H:%M:%S") if a["started_at"] else "?"
        current = a["current_stage"] or ""

        # Build progress bar
        timings = a["stage_timings"] or {}
        events = running_events.get(a["id"], [])
        completed_stages = set()
        for ev in events:
            if ev["status"] == "completed":
                completed_stages.add(ev["stage"])

        progress = ""
        for stage in PIPELINE_STAGES:
            timing = timings.get(stage, "")
            if stage in completed_stages or (status == "completed" and timing):
                color = "#3fb950"
                title = f"{stage}: {timing}s" if timing else stage
            elif stage == current:
                color = "#f9a825"
                title = f"{stage}: running..."
            else:
                color = "#30363d"
                title = stage
            progress += f'<span title="{title}" style="display:inline-block;width:24px;height:12px;background:{color};border-radius:2px;margin:1px;"></span>'

        elapsed = ""
        if a["started_at"] and status == "running":
            from datetime import datetime, timezone
            delta = datetime.now(timezone.utc) - a["started_at"].replace(tzinfo=timezone.utc) if a["started_at"].tzinfo is None else datetime.now(timezone.utc) - a["started_at"]
            elapsed = f"{int(delta.total_seconds())}s"
        elif timings.get("total"):
            elapsed = f"{timings['total']:.0f}s"

        rows += f"""<tr>
            <td><span style="color:{status_color};font-weight:bold;text-transform:uppercase;">{escape(status)}</span></td>
            <td><a href="/analysis/{a['id']}">{escape(a['task_id'])}</a></td>
            <td class="mono" style="font-size:11px;">{escape(sha_short)}</td>
            <td>{escape(a['filename'] or '?')}</td>
            <td>{escape(current)}</td>
            <td>{progress}</td>
            <td>{elapsed}</td>
            <td>{started}</td>
        </tr>"""

    return render_template_string("""{% raw %}<!DOCTYPE html><html><head>
        <title>Pipeline Status — Dashboard</title>
        <style>{{ css }}</style>
        <meta http-equiv="refresh" content="10">
    </head><body>
        <header>
            <h1>Malware Analysis Dashboard</h1>
            <nav>
                <a href="/">Analyses</a>
                <a href="/status">Status</a>
                <a href="/iocs">IOCs</a>
                <a href="/techniques">ATT&CK</a>
            </nav>
        </header>
        <div class="container">
            <h2>Pipeline Status</h2>
            <p style="font-size:11px;color:#8b949e;">Auto-refreshes every 10 seconds. Shows running and recent analyses.</p>
            <table>
                <tr><th>Status</th><th>Task</th><th>SHA256</th><th>Filename</th>
                    <th>Current Stage</th><th>Progress</th><th>Elapsed</th><th>Started</th></tr>
                {{ rows }}
            </table>
        </div>
    </body></html>{% endraw %}""", css=Markup(CSS), rows=Markup(rows))


