#!/usr/bin/env python3
"""
Malware Analysis Dashboard — Flask web application.

Reads structured analysis data from the PostgreSQL database and renders
it in a browser-friendly format. Phase 1: read-only viewer with search.

Runs behind WireGuard (not exposed to the internet).

Author: Christopher Shaiman
License: Apache 2.0
"""

import json
from datetime import datetime
from pathlib import Path

import markdown as md
import psycopg2
import psycopg2.extras
from flask import Flask, render_template_string, request, abort, Response
from markupsafe import Markup

app = Flask(__name__)

# Database config (injected by Ansible)
DB_CONFIG = {
    "host": "{{ postgres_listen_address | default('127.0.0.1') }}",
    "port": {{ postgres_port | default(5432) }},
    "dbname": "{{ postgres_db_name | default('malware_analysis') }}",
    "user": "{{ postgres_db_user | default('pipeline') }}",
    "password": "{{ pipeline_db_password | default('') }}",
}

REPORTS_DIR = "{{ pipeline_reports_dir | default('/opt/pipeline/reports') }}"


def get_db():
    """Get a database connection. Use as context manager: with get_db() as conn."""
    conn = psycopg2.connect(**DB_CONFIG, cursor_factory=psycopg2.extras.RealDictCursor)
    return conn


class db_connection:
    """Context manager for database connections. Auto-closes on exit."""
    def __enter__(self):
        self.conn = psycopg2.connect(**DB_CONFIG, cursor_factory=psycopg2.extras.RealDictCursor)
        self.cur = self.conn.cursor()
        return self.cur
    def __exit__(self, exc_type, exc_val, exc_tb):
        self.cur.close()
        self.conn.close()
        return False


