def severity_badge(s):
    if not s:
        return ""
    css = {"critical": "badge-critical", "high": "badge-high",
           "medium": "badge-medium", "low": "badge-low"}.get(s.lower(), "")
    return f'<span class="badge {css}">{s}</span>'


def source_badge(source):
    color = SOURCE_COLORS.get(source, "#666")
    return f'<span class="badge-source" style="background:{color};">{source}</span>'


def escape(s):
    if s is None:
        return ""
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")


# ---------------------------------------------------------------------------
# Operational alerts — read from status files, no database
# ---------------------------------------------------------------------------

def get_alert_state() -> dict:
    """Read operational alert state from status files."""
    import shutil
    alert = {
        "level": "ok",  # ok, warning, critical
        "message": "",
        "paused": False,
        "network_status": "unknown",
        "disk_percent": 0,
        "auto_feeder": {},
    }

    # Check PAUSE file
    pause_path = Path("/opt/pipeline/PAUSE")
    if pause_path.exists():
        alert["paused"] = True
        alert["level"] = "critical"
        alert["message"] = "Auto-feeder paused"

    # Check network monitor
    try:
        net_status_path = Path("/opt/network-monitor/status.json")
        if net_status_path.exists():
            with open(net_status_path) as f:
                net = json.load(f)
            alert["network_status"] = net.get("status", "unknown")
            if net.get("status") == "alert":
                alert["level"] = "critical"
                alert["message"] = net.get("alert_message", "Network alert")
    except Exception:
        alert["network_status"] = "unknown"

    # Check auto-feeder state
    try:
        feeder_path = Path("/opt/auto-feeder/state.json")
        if feeder_path.exists():
            with open(feeder_path) as f:
                alert["auto_feeder"] = json.load(f)
            failures = alert["auto_feeder"].get("consecutive_failures", 0)
            if failures > 0 and alert["level"] != "critical":
                alert["level"] = "warning"
                alert["message"] = f"{failures} consecutive failure(s)"
    except Exception:
        pass

    # Check disk usage
    try:
        usage = shutil.disk_usage("/opt/pipeline")
        alert["disk_percent"] = round((usage.used / usage.total) * 100, 1)
        if alert["disk_percent"] > 80:
            if alert["level"] != "critical":
                alert["level"] = "critical"
            alert["message"] = f"Disk usage {alert['disk_percent']}%"
        elif alert["disk_percent"] > 70:
            if alert["level"] == "ok":
                alert["level"] = "warning"
    except Exception:
        pass

    return alert


def render_alert_banner() -> str:
    """Generate the alert banner HTML."""
    alert = get_alert_state()
    if alert["level"] == "ok":
        return ""
    msg = escape(alert["message"])
    return f'<div class="alert-banner {alert["level"]}">{msg} — <a href="/alerts">Details</a></div>'


def render_markdown(text):
    """Convert markdown text to safe HTML for narrative display.

    If the text contains a JSON blob (from a failed parse_final_response),
    try to extract the narrative field from it.
    """
    import re as _re
    if not text:
        return ""
    text = str(text)

    # Check if this looks like it contains a JSON blob with a narrative key
    narr_idx = text.find('"narrative"')
    if narr_idx != -1:
        # Try JSON parse of the whole blob first
        first_brace = text.find("{")
        last_brace = text.rfind("}")
        if first_brace != -1 and last_brace > first_brace:
            try:
                parsed = json.loads(text[first_brace:last_brace + 1])
                if isinstance(parsed, dict) and "narrative" in parsed:
                    text = parsed["narrative"]
                    return md.markdown(text, extensions=["nl2br", "fenced_code"])
            except (json.JSONDecodeError, TypeError):
                pass

        # JSON broken — extract everything after "narrative": "
        match = _re.search(r'"narrative"\s*:\s*"', text)
        if match:
            start = match.end()
            # Find the narrative value — may be truncated (no closing quote)
            extracted = []
            i = start
            while i < len(text):
                ch = text[i]
                if ch == '\\' and i + 1 < len(text):
                    next_ch = text[i + 1]
                    if next_ch == 'n':
                        extracted.append('\n')
                    elif next_ch == '"':
                        extracted.append('"')
                    elif next_ch == '\\':
                        extracted.append('\\')
                    else:
                        extracted.append(ch + next_ch)
                    i += 2
                elif ch == '"':
                    break  # end of JSON string value
                else:
                    extracted.append(ch)
                    i += 1
            text = ''.join(extracted)

    return md.markdown(text, extensions=["nl2br", "fenced_code"])


