# PDF report generation container — WeasyPrint + Markdown
# Renders pipeline JSON reports to formatted PDF documents.
# Isolates HTML/CSS rendering from untrusted malware-derived strings.
# Built locally by Ansible. Never pulled from a registry.
#
# Hermetic (ADR-023): built with --network=none. Every input below was downloaded
# and verified by lamware-fetch before the build: the base image by digest, the
# Debian packages from a pinned snapshot, the wheels against requirements.lock.
FROM {{ build_fetch_python_slim }}

COPY debs/main/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb && rm -rf /tmp/debs

COPY wheels/ /tmp/wheels/
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels \
        --require-hashes -r /tmp/requirements.lock \
    && rm -rf /tmp/wheels /tmp/requirements.lock

COPY generate-report.py /opt/generate-report.py
RUN chmod +x /opt/generate-report.py

RUN mkdir -p /output /nonexistent && chmod 777 /nonexistent /output
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/generate-report.py"]
