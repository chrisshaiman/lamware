#!/bin/bash
# =============================================================================
# run-pdf-generation — host-side wrapper for containerized PDF report generation
# Renders pipeline JSON reports to PDF using WeasyPrint in a Podman container.
#
# Usage: run-pdf-generation <report.json> [output.pdf]
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: run-pdf-generation <report.json> [output.pdf]" >&2
    exit 1
fi

REPORT_PATH="$(realpath "$1")"
REPORT_NAME="$(basename "$REPORT_PATH")"
OUTPUT_PDF="${2:-$(dirname "$REPORT_PATH")/report.pdf}"
OUTPUT_DIR="$(dirname "$(realpath -m "$OUTPUT_PDF")")"
OUTPUT_NAME="$(basename "$OUTPUT_PDF")"

if [ ! -f "$REPORT_PATH" ]; then
    echo "Error: report not found: $REPORT_PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Container work dirs (#694). The container runs as 65534:65534 inside the
# pipeline user's rootless userns: host subuid 200000 + 65534 - 1 = 265533
# (/etc/subuid "pipeline:200000:65536"). It must WRITE the PDF and cannot write
# a pipeline-owned dir. That used to be solved with `chmod a+rwx`, which let any
# local user add or replace files in the dir while the job ran.
#   - JOB_DIR is mktemp's private 0700 dir, owned by pipeline: no other local
#     user can reach anything below it. The container never traverses it;
#     podman bind-mounts the subdirs directly.
#   - in/ is pipeline-owned 0755; the container's nobody reads via "other".
#   - out/ is 0700 and chowned to the container's uid with `podman unshare`,
#     so only that uid can write it; chowned back to namespace root (==
#     pipeline) after the run so the copy can read it.
#   - Cleanup uses `podman unshare rm`: files the container wrote are owned by
#     the subuid, which the pipeline user cannot unlink directly.
CONTAINER_UID=65534
CONTAINER_GID=65534
JOB_DIR=""
cleanup() {
    [ -n "$JOB_DIR" ] || return 0
    podman unshare rm -rf "$JOB_DIR" 2>/dev/null || rm -rf "$JOB_DIR" 2>/dev/null || true
}
trap cleanup EXIT
JOB_DIR="$(mktemp -d)"
mkdir -m 0755 "$JOB_DIR/in"
mkdir -m 0700 "$JOB_DIR/out"
podman unshare chown "$CONTAINER_UID:$CONTAINER_GID" "$JOB_DIR/out"
cp "$REPORT_PATH" "$JOB_DIR/in/$REPORT_NAME"
chmod 644 "$JOB_DIR/in/$REPORT_NAME"

podman run --rm \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ pdf_generation_container_memory }} \
    --cpus={{ pdf_generation_container_cpus }} \
    --timeout={{ pdf_generation_container_timeout }} \
    --tmpfs /tmp:size=100m \
    --tmpfs /nonexistent:size=10m \
    --user "$CONTAINER_UID:$CONTAINER_GID" \
    -v "$JOB_DIR/in:/report:ro" \
    -v "$JOB_DIR/out:/output:rw" \
    localhost/pdf-generation:latest \
    "/report/$REPORT_NAME" "/output/$OUTPUT_NAME"

# Hand the container's output back to the pipeline user (namespace uid 0).
podman unshare chown -R 0:0 "$JOB_DIR/out"

# Copy PDF from temp dir to the real output location
if [ -f "$JOB_DIR/out/$OUTPUT_NAME" ]; then
    cp "$JOB_DIR/out/$OUTPUT_NAME" "$OUTPUT_DIR/$OUTPUT_NAME"
    echo "PDF report written to: $OUTPUT_DIR/$OUTPUT_NAME"
else
    echo "Error: PDF was not generated" >&2
    exit 1
fi
