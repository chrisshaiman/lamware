# pipeline-spool.service — processes uploaded samples from the spool directory.
# Triggered by pipeline-spool.path when files appear in /opt/pipeline/spool.
# Runs as the pipeline user — proper security boundary from the API.
#
# Managed by Ansible (api role). Do not edit manually.

[Unit]
Description=Process uploaded samples from spool directory

[Service]
Type=oneshot
User=pipeline
Group=pipeline
SupplementaryGroups=lamware
WorkingDirectory=/tmp
Environment=HOME=/home/pipeline

# Drain the spool. A sample whose run fails is moved to
# {{ api_spool_failed_dir }} with a .failure sidecar and an ntfy alert, so
# it is neither re-detonated in a loop nor able to wedge this unit's trigger
# (#534). The script is root-owned so the pipeline user cannot rewrite what it
# runs. /bin/bash is explicit because network-monitor's process allowlist
# matches this exact command line.
ExecStart=/bin/bash /usr/local/bin/pipeline-spool-run

# Security hardening
NoNewPrivileges=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# ProtectHome omitted — pipeline user's Podman config lives in /home/pipeline
