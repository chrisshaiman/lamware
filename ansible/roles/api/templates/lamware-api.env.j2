# lamware-api environment configuration
# Written by Ansible — do not edit manually.
# Secrets sourced from ansible-vault (vars/secrets.yml).
# Permissions: 0600, owner: {{ api_user }}

LAMWARE_DB_HOST={{ postgres_listen_address | default('127.0.0.1') }}
LAMWARE_DB_PORT={{ postgres_port | default(5432) }}
LAMWARE_DB_NAME={{ postgres_db_name | default('malware_analysis') }}
LAMWARE_DB_USER={{ postgres_db_user | default('pipeline') }}
LAMWARE_DB_PASSWORD={{ pipeline_db_password }}
LAMWARE_REPORTS_DIR={{ pipeline_reports_dir | default('/opt/pipeline/reports') }}
LAMWARE_API_PORT={{ api_port }}
LAMWARE_API_HOST={{ api_host }}
LAMWARE_CORS_ORIGINS=["http://localhost:3000","https://{{ wireguard_address | ansible.utils.ipaddr('address') }}","https://{{ keycloak_hostname }}"]
LAMWARE_KEYCLOAK_URL=http://127.0.0.1:{{ keycloak_port | default(8080) }}/auth
LAMWARE_KEYCLOAK_ISSUER_URL=https://{{ keycloak_hostname }}/auth
LAMWARE_KEYCLOAK_REALM={{ keycloak_realm | default('lamware') }}
LAMWARE_KEYCLOAK_CLIENT_ID={{ keycloak_client_id | default('lamware-web') }}
LAMWARE_ENABLE_DOCS=false
LAMWARE_LITELLM_URL=http://127.0.0.1:{{ litellm_port | default(4000) }}
LAMWARE_LITELLM_KEY={{ litellm_master_key | mandatory }}
LAMWARE_SANDBOX_CMD=sudo -u pipeline /usr/local/bin/run-sandbox
LAMWARE_GHIDRA_CMD=sudo -u pipeline /usr/local/bin/run-ghidra
# run_python limits — single-sourced from the python-sandbox role so the API agrees
# with the container wrapper (run-sandbox). Keep these as the only authoritative values.
LAMWARE_SANDBOX_TIMEOUT_SECONDS={{ python_sandbox_container_timeout | default(30) }}
LAMWARE_SANDBOX_MEMORY_MB={{ python_sandbox_container_memory | default('256m') | regex_replace('[^0-9]', '') }}
LAMWARE_SANDBOX_MAX_SCRIPT_BYTES={{ python_sandbox_max_script_size | default(10240) }}
