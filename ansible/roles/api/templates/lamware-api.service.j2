[Unit]
Description=lamware API (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=exec
User={{ api_user }}
Group={{ api_user }}
SupplementaryGroups=lamware
WorkingDirectory={{ api_install_dir }}
EnvironmentFile={{ api_install_dir }}/lamware-api.env
ExecStart={{ api_install_dir }}/venv/bin/uvicorn app.main:app --host {{ api_host }} --port {{ api_port }}
Restart=always
RestartSec=5

# Security hardening
# NoNewPrivileges intentionally omitted — the investigation agent uses
# sudo -u pipeline to run-sandbox and run-ghidra in the pipeline user's
# rootless Podman. Setting NoNewPrivileges=true would prevent sudo from
# elevating, breaking both investigation tools. See /etc/sudoers.d/lamware-api-investigate.
ProtectSystem=strict
ReadWritePaths={{ api_install_dir }} /opt/pipeline/spool /opt/pipeline/control
ProtectHome=true
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# SystemCallFilter omitted: sudo delegation needs @setuid syscalls

[Install]
WantedBy=multi-user.target
