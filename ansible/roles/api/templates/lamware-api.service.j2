[Unit]
Description=lamware API (FastAPI)
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=exec
User={{ api_user }}
Group={{ api_user }}
SupplementaryGroups=lamware
WorkingDirectory={{ api_install_dir }}
EnvironmentFile={{ api_install_dir }}/lamware-api.env
ExecStart={{ api_install_dir }}/venv/bin/uvicorn app.main:app --host {{ api_host }} --port {{ api_port }}
Restart=always
RestartSec=5

# Security hardening
# NoNewPrivileges intentionally omitted — the investigation agent uses
# sudo -u pipeline to run-sandbox and run-ghidra in the pipeline user's
# rootless Podman. Setting NoNewPrivileges=true would prevent sudo from
# elevating, breaking both investigation tools. See /etc/sudoers.d/lamware-api-investigate.
#
# ProtectHome=false and /home/pipeline in ReadWritePaths: sudo children
# inherit the service's mount namespace. pipeline's rootless Podman storage
# lives at /home/pipeline/.local/share/containers and needs both read and
# write access — ProtectHome=true would make /home/ a read-only bind-mount
# in the namespace, breaking container pulls, image storage, and run state.
# ProtectSystem=strict compensates by keeping /usr, /boot, /etc read-only.
#
# AF_NETLINK in RestrictAddressFamilies: rootless Podman uses netlink
# during user-namespace and network-namespace setup even with --network=none.
# Without AF_NETLINK the namespace syscalls fail before the container starts.
#
# /opt/auto-feeder in ReadWritePaths: the feeder-control endpoints reset the
# consecutive-failures counter in /opt/auto-feeder/state.json (on resume and via
# the Reset-Failures action). ProtectSystem=strict otherwise makes that path
# read-only, so the writes fail with EROFS — resume can't clear backoff and the
# Reset action returns HTTP 500. The PAUSE file lives under /opt/pipeline/control
# (already listed), so pause/resume of the flag itself was unaffected.
ProtectSystem=strict
ReadWritePaths={{ api_install_dir }} /opt/pipeline/spool /opt/pipeline/control /opt/auto-feeder /home/pipeline
ProtectHome=false
PrivateTmp=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# SystemCallFilter omitted: sudo delegation needs @setuid syscalls

[Install]
WantedBy=multi-user.target
