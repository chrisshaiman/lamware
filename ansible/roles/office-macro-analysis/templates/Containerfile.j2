FROM {{ build_fetch_python_slim }}

# Hermetic (ADR-023): oletools and its dependencies are wheels lamware-fetch
# downloaded against requirements.lock, pinned to the versions the image ran.
COPY wheels/ /tmp/wheels/
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels \
        --require-hashes -r /tmp/requirements.lock \
    && rm -rf /tmp/wheels /tmp/requirements.lock

COPY analyze-office.py /opt/analyze-office.py

ENTRYPOINT ["python3", "/opt/analyze-office.py"]
