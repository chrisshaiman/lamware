# LLM interpretation container
# Holds Claude API conversation for agentic malware RE.
# Built locally by Ansible. Never pulled from a registry.
# {{ build_fetch_python_slim }}, by image ID (ADR-023 amendment)
FROM {{ build_fetch_python_slim_id }}
LABEL lamware.base="{{ build_fetch_python_slim }}"

# Hermetic (ADR-023): wheels lamware-fetch downloaded against requirements.lock.
COPY wheels/ /tmp/wheels/
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels \
        --require-hashes -r /tmp/requirements.lock \
    && rm -rf /tmp/wheels /tmp/requirements.lock

COPY interpret-ghidra.py /opt/interpret-ghidra.py
RUN chmod +x /opt/interpret-ghidra.py

# The nine deploy-time scalars the script used to carry as Jinja (#205). It looks for
# this beside itself, so the two must stay in the same directory.
COPY interpret-config.json /opt/interpret-config.json

# nobody user — matches other pipeline containers
RUN mkdir -p /nonexistent && chmod 777 /nonexistent
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/interpret-ghidra.py"]
