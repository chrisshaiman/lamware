#!/bin/bash
# =============================================================================
# run-interpret — host-side wrapper for LLM interpretation container
# Long-running container that communicates via stdin/stdout JSON lines.
#
# Usage: echo '{"type":"init",...}' | run-interpret
#        (then continue reading/writing JSON lines)
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

# LiteLLM is reachable ONLY through the bind-mounted Unix socket; the container runs
# with --network=none (no host network namespace). Fail clearly if the socket bridge
# (litellm-socket.service) is not up. LITELLM_BASE_URL's host is cosmetic — all requests
# route over LITELLM_UDS (httpx ignores the URL host); the non-resolvable .invalid host
# means a non-UDS fallback fails CLOSED instead of silently reaching a host-network LiteLLM.
SOCK=/run/litellm/litellm.sock
if [ ! -S "$SOCK" ]; then
    echo "[!] LiteLLM socket $SOCK missing — is litellm-socket.service running?" >&2
    exit 1
fi

podman run --rm -i \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ interpret_container_memory }} \
    --cpus={{ interpret_container_cpus }} \
    --timeout={{ interpret_container_timeout }} \
    --tmpfs /tmp:size=100m \
    --tmpfs /nonexistent:size=10m \
    --user 65534:65534 \
    -v "$SOCK":/run/litellm.sock:ro \
    -e LITELLM_API_KEY="{{ litellm_master_key | default('sk-lamware') }}" \
    -e LITELLM_BASE_URL="http://litellm.invalid/anthropic" \
    -e LITELLM_UDS=/run/litellm.sock \
    localhost/interpret:latest
