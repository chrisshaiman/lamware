KC_DB=postgres
KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/{{ keycloak_db_name }}
KC_DB_USERNAME={{ keycloak_db_user }}
KC_DB_PASSWORD={{ keycloak_db_password }}
KC_HOSTNAME={{ keycloak_hostname }}
KC_HOSTNAME_STRICT=true
KC_PROXY_HEADERS=xforwarded
KC_HTTP_RELATIVE_PATH=/auth
KC_HTTP_ENABLED=true
KC_HTTP_HOST={{ keycloak_listen_address }}
KC_HTTP_PORT={{ keycloak_port }}
KC_HEALTH_ENABLED=true
KC_CACHE=local
# Deprecated in 26.x in favour of KC_BOOTSTRAP_ADMIN_USERNAME/PASSWORD, but kept
# because this deployment is pinned back to 26.1 after 26.7.2 crash-looped.
# Rename them together with the image tag, not before.
#
# Inert on an existing database either way: per Keycloak's own help the
# bootstrap admin is "used only when the master realm is created", and master
# already exists. To recover admin access here use `kc.sh bootstrap-admin user`,
# which does work against an existing database.
KEYCLOAK_ADMIN={{ keycloak_admin_user }}
KEYCLOAK_ADMIN_PASSWORD={{ keycloak_admin_password }}
