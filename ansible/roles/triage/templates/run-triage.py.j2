#!/usr/bin/env python3
"""
Triage analysis script — runs inside a Podman container.
Analyzes a malware sample with YARA, ssdeep, FLOSS, file type, and entropy.
Outputs JSON to stdout. Full FLOSS dump written to /output/ if mounted.

Usage: python3 run-triage.py /sample/filename.exe

Author: Christopher Shaiman
License: Apache 2.0
"""

import hashlib
import json
import math
import os
import subprocess
import sys
from pathlib import Path

import magic
import pefile
import ppdeep as ssdeep
import yara


def file_hashes(path: Path) -> dict:
    """Compute MD5, SHA1, SHA256 of a file."""
    # MD5/SHA1 here are NOT cryptographic signatures. They are the sample IDENTIFIERS the
    # malware-analysis ecosystem keys on: VirusTotal, MalwareBazaar and effectively every
    # public IOC feed index by them, and an analyst pivots on them daily. SHA256 is
    # computed alongside and is what we trust for integrity. Taking semgrep's autofix
    # would break interoperability without improving security.
    md5 = hashlib.md5()  # nosemgrep: python.lang.security.insecure-hash-algorithms-md5.insecure-hash-algorithm-md5
    sha1 = hashlib.sha1()  # nosemgrep: python.lang.security.insecure-hash-algorithms.insecure-hash-algorithm-sha1
    sha256 = hashlib.sha256()
    with open(path, "rb") as f:
        while chunk := f.read(8192):
            md5.update(chunk)
            sha1.update(chunk)
            sha256.update(chunk)
    return {
        "md5": md5.hexdigest(),
        "sha1": sha1.hexdigest(),
        "sha256": sha256.hexdigest(),
    }


def file_entropy(path: Path) -> float:
    """Calculate Shannon entropy of the file."""
    with open(path, "rb") as f:
        data = f.read()
    if not data:
        return 0.0
    freq = [0] * 256
    for byte in data:
        freq[byte] += 1
    length = len(data)
    entropy = 0.0
    for count in freq:
        if count:
            p = count / length
            entropy -= p * math.log2(p)
    return round(entropy, 2)


def pe_compile_timestamp(path: Path) -> str | None:
    """Extract PE compile timestamp. Returns ISO format string or None."""
    try:
        pe = pefile.PE(str(path), fast_load=True)
        ts = pe.FILE_HEADER.TimeDateStamp
        if ts and ts > 946684800:  # after 2000-01-01 (filter bogus timestamps)
            from datetime import datetime, timezone
            dt = datetime.fromtimestamp(ts, tz=timezone.utc)
            if dt.year <= 2030:  # filter far-future timestamps
                return dt.isoformat()
    except (pefile.PEFormatError, Exception):
        pass
    return None


def section_entropies(path: Path) -> list[dict]:
    """Calculate per-section entropy for PE files."""
    try:
        pe = pefile.PE(str(path))
    except pefile.PEFormatError:
        return []
    sections = []
    for section in pe.sections:
        name = section.Name.rstrip(b"\x00").decode("utf-8", errors="replace")
        data = section.get_data()
        if not data:
            ent = 0.0
        else:
            freq = [0] * 256
            for byte in data:
                freq[byte] += 1
            length = len(data)
            ent = 0.0
            for count in freq:
                if count:
                    p = count / length
                    ent -= p * math.log2(p)
        sections.append({
            "name": name,
            "entropy": round(ent, 2),
            "size": len(data),
        })
    return sections


def run_yara(path: Path, rules_dir: str = "/rules") -> tuple[list[dict], dict]:
    """Scan file against all YARA rules in the rules directory.

    Returns (matches, status). `status` says how many rule files were found and
    compiled, and why none were. Every way of getting no matches used to look
    the same: a missing dir, an UNREADABLE dir (rglob yields nothing on
    EACCES) and a rule that fails to compile all returned [] silently. YARA
    matched nothing from 2026-05-09 to 2026-10-08 because the container could
    not read /rules, and every report said "0 YARA matches" (#736).
    """
    matches: list[dict] = []
    status: dict = {"rules_dir": rules_dir, "rule_files": 0, "compiled": 0,
                    "compile_errors": 0, "error": None}
    rules_path = Path(rules_dir)
    if not rules_path.exists():
        status["error"] = f"rules dir not found: {rules_dir}"
        return matches, status
    walk_errors: list[str] = []
    rule_files: list[Path] = []
    for root, _dirs, files in os.walk(rules_path, onerror=lambda e: walk_errors.append(str(e))):
        rule_files += [Path(root) / f for f in files if f.endswith((".yar", ".yara"))]
    rule_files.sort()
    status["rule_files"] = len(rule_files)
    if walk_errors:
        status["error"] = f"{len(walk_errors)} unreadable dir(s), first: {walk_errors[0]}"
    for rule_file in rule_files:
        try:
            rules = yara.compile(filepath=str(rule_file))
        except yara.Error:
            # Expected for some community rules (modules this build lacks, such
            # as androguard/cuckoo); counted so a wholesale failure is visible.
            status["compile_errors"] += 1
            continue
        status["compiled"] += 1
        for match in rules.match(str(path)):
            matches.append({
                "rule": match.rule,
                "source": rule_file.parent.name or "unknown",
                "tags": list(match.tags),
                "meta": {k: str(v) for k, v in match.meta.items()},
            })
    if status["compiled"] == 0 and status["error"] is None:
        status["error"] = (f"no rule compiled ({status['rule_files']} file(s), "
                           f"{status['compile_errors']} compile error(s))")
    return matches, status


def run_ssdeep(path: Path) -> str:
    """Compute ssdeep fuzzy hash."""
    try:
        with open(path, "rb") as f:
            return ssdeep.hash(f.read())
    except Exception:
        return ""


def run_floss(path: Path, output_dir: str = "/output") -> dict:
    """Run FLOSS for string extraction. Save full dump to output dir."""
    result = {
        "static_strings": 0,
        "decoded_strings": 0,
        "interesting": [],
    }
    try:
        proc = subprocess.run(
            ["floss", "--json", str(path)],
            capture_output=True,
            text=True,
            timeout=120,
        )
        if proc.returncode != 0:
            return result
        floss_data = json.loads(proc.stdout)

        # Save full dump
        output_path = Path(output_dir)
        if output_path.exists():
            with open(output_path / "floss_full.json", "w") as f:
                json.dump(floss_data, f, indent=2)

        # Extract summary
        static = floss_data.get("strings", {}).get("static_strings", [])
        decoded = floss_data.get("strings", {}).get("decoded_strings", [])
        result["static_strings"] = len(static)
        result["decoded_strings"] = len(decoded)

        # Find interesting strings (URLs, IPs, commands, registry keys)
        interesting_patterns = [
            "http://", "https://", "ftp://",
            "cmd.exe", "powershell", "wscript", "cscript",
            "SOFTWARE\\", "CurrentVersion\\Run",
            "HKEY_", ".onion", "bitcoin",
        ]
        all_strings = [s.get("string", "") for s in static + decoded]
        for s in all_strings:
            for pattern in interesting_patterns:
                if pattern.lower() in s.lower() and s not in result["interesting"]:
                    result["interesting"].append(s)
                    break
        # Cap at 50 interesting strings
        result["interesting"] = result["interesting"][:50]

    except (subprocess.TimeoutExpired, json.JSONDecodeError, FileNotFoundError):
        pass
    return result


def derive_routing_tags(file_type: str, yara_matches: list[dict]) -> list[str]:
    """Derive Cape routing tags from triage results."""
    tags = []

    # File type based routing
    ft_lower = file_type.lower()
    if any(kw in ft_lower for kw in ["word", "document", "openxml", "odt", "rtf"]):
        tags.append("office")
    elif any(kw in ft_lower for kw in ["excel", "spreadsheet", "xls"]):
        tags.append("office")
    elif any(kw in ft_lower for kw in ["powerpoint", "presentation", "ppt"]):
        tags.append("office")

    # YARA match based routing
    for match in yara_matches:
        match_tags = match.get("tags", [])
        if "macro" in match_tags or "vba" in match_tags:
            if "office" not in tags:
                tags.append("office")

    return tags


def main():
    if len(sys.argv) != 2:
        print(json.dumps({"error": "Usage: run-triage.py <sample_path>"}))
        sys.exit(1)

    sample_path = Path(sys.argv[1])
    if not sample_path.exists():
        print(json.dumps({"error": f"File not found: {sample_path}"}))
        sys.exit(1)

    file_type = magic.from_file(str(sample_path))
    file_mime = magic.from_file(str(sample_path), mime=True)
    hashes = file_hashes(sample_path)
    entropy = file_entropy(sample_path)
    sections = section_entropies(sample_path)
    compile_ts = pe_compile_timestamp(sample_path)
    fuzzy_hash = run_ssdeep(sample_path)
    yara_matches, yara_status = run_yara(sample_path)
    floss_result = run_floss(sample_path)
    routing_tags = derive_routing_tags(file_type, yara_matches)

    report = {
        "triage": {
            "file_type": file_type,
            "file_mime": file_mime,
            "file_size": sample_path.stat().st_size,
            "hashes": hashes,
            "ssdeep": fuzzy_hash,
            "entropy": entropy,
            "pe_compile_timestamp": compile_ts,
            "sections": sections,
            "yara_matches": yara_matches,
            "yara_status": yara_status,
            "floss": floss_result,
            "routing_tags_added": routing_tags,
        }
    }

    print(json.dumps(report, indent=2))


if __name__ == "__main__":
    main()
