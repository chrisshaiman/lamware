#!/bin/bash
# =============================================================================
# run-triage — host-side wrapper for the containerized triage tool
# Invokes the triage container with full isolation.
#
# Usage: run-triage <sample_path> [output_dir]
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: run-triage <sample_path> [output_dir]" >&2
    exit 1
fi

SAMPLE_PATH="$(realpath "$1")"
SAMPLE_NAME="$(basename "$SAMPLE_PATH")"
OUTPUT_DIR="${2:-{{ triage_output_dir }}}"

if [ ! -f "$SAMPLE_PATH" ]; then
    echo "Error: file not found: $SAMPLE_PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Copy the sample to a temporary directory so only the single file is mounted
# into the container — prevents access to other files in the sample's
# directory. Output also goes to the temp dir (nobody can't write to
# cape-owned dirs), then we copy results back.
#
# Container work dirs (#694). The container runs as 65534:65534 inside the
# pipeline user's rootless userns: host subuid 200000 + 65534 - 1 = 265533
# (/etc/subuid "pipeline:200000:65536"). It must WRITE its output and cannot
# write a pipeline-owned dir. That used to be solved with `chmod a+rwx`, which
# let any local user add or replace files in the dir while the job ran.
#   - JOB_DIR is mktemp's private 0700 dir, owned by pipeline: no other local
#     user can reach anything below it. The container never traverses it;
#     podman bind-mounts the subdirs directly.
#   - in/ is pipeline-owned 0755; the container's nobody reads via "other".
#   - out/ is 0700 and chowned to the container's uid with `podman unshare`,
#     so only that uid can write it; chowned back to namespace root (==
#     pipeline) after the run so the copy can read it.
#   - Cleanup uses `podman unshare rm`: files the container wrote are owned by
#     the subuid, which the pipeline user cannot unlink directly.
CONTAINER_UID=65534
CONTAINER_GID=65534
JOB_DIR=""
cleanup() {
    [ -n "$JOB_DIR" ] || return 0
    podman unshare rm -rf "$JOB_DIR" 2>/dev/null || rm -rf "$JOB_DIR" 2>/dev/null || true
}
trap cleanup EXIT
JOB_DIR="$(mktemp -d)"
mkdir -m 0755 "$JOB_DIR/in"
mkdir -m 0700 "$JOB_DIR/out"
podman unshare chown "$CONTAINER_UID:$CONTAINER_GID" "$JOB_DIR/out"
cp "$SAMPLE_PATH" "$JOB_DIR/in/$SAMPLE_NAME"
chmod 644 "$JOB_DIR/in/$SAMPLE_NAME"

podman run --rm \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ triage_container_memory }} \
    --cpus={{ triage_container_cpus }} \
    --timeout={{ triage_container_timeout }} \
    --tmpfs /tmp:size=512m \
    --user "$CONTAINER_UID:$CONTAINER_GID" \
    -v "$JOB_DIR/in:/sample:ro" \
    -v "{{ triage_rules_dir }}:/rules:ro" \
    -v "$JOB_DIR/out:/output:rw" \
    localhost/triage:latest \
    "/sample/$SAMPLE_NAME"

# Hand the container's output back to the pipeline user (namespace uid 0).
podman unshare chown -R 0:0 "$JOB_DIR/out"

# Copy output files back to the real output directory
if [ "$(ls -A "$JOB_DIR/out" 2>/dev/null)" ]; then
    cp -r "$JOB_DIR/out"/* "$OUTPUT_DIR/" 2>/dev/null || true
fi
