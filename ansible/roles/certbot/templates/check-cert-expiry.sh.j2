#!/bin/bash
# =============================================================================
# check-cert-expiry.sh — alert if TLS cert expires within {{ certbot_expiry_warn_days }} days
# Run daily by cron. Sends ntfy alert on expiry warning or renewal failure.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

DOMAIN="{{ certbot_domain }}"
CERT_PATH="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
WARN_DAYS="{{ certbot_expiry_warn_days }}"
NTFY_URL="{{ ntfy_url }}/{{ ntfy_topic }}"
NTFY_TOKEN="{{ ntfy_token | default('') }}"

# Authenticate the publish. The main alert path gained a bearer token in #352
# (2c9b89f); these call sites were left as bare curl, so on a token-protected
# topic every TLS-expiry alert was rejected and discarded — curl -s swallows
# the 403, and the script exits 0. A notification channel reporting healthy
# while delivering nothing, which is the shape of #336 and #343.
notify() {
    local title="$1" priority="$2" tags="$3" body="$4"
    local auth=()
    if [[ -n "$NTFY_TOKEN" ]]; then
        auth=(-H "Authorization: Bearer $NTFY_TOKEN")
    fi
    curl -sS --fail-with-body "${auth[@]}" \
         -H "Title: $title" \
         -H "Priority: $priority" \
         -H "Tags: $tags" \
         -d "$body" \
         "$NTFY_URL" || echo "WARNING: ntfy publish failed for: $title" >&2
}

if [[ ! -f "$CERT_PATH" ]]; then
    notify "lamware TLS cert missing" "urgent" "rotating_light" "Certificate file not found: ${CERT_PATH}"
    exit 1
fi

# Get cert expiry date and calculate days remaining
EXPIRY_DATE=$(openssl x509 -enddate -noout -in "$CERT_PATH" | cut -d= -f2)
EXPIRY_EPOCH=$(date -d "$EXPIRY_DATE" +%s)
NOW_EPOCH=$(date +%s)
DAYS_LEFT=$(( (EXPIRY_EPOCH - NOW_EPOCH) / 86400 ))

if [[ "$DAYS_LEFT" -le 0 ]]; then
    notify "lamware TLS cert EXPIRED" "urgent" "rotating_light" "Certificate for ${DOMAIN} expired ${DAYS_LEFT#-} days ago. Run: certbot renew"
elif [[ "$DAYS_LEFT" -le "$WARN_DAYS" ]]; then
    notify "lamware TLS cert expiring soon" "high" "warning" "Certificate for ${DOMAIN} expires in ${DAYS_LEFT} days (${EXPIRY_DATE}). Renewal should happen automatically — check certbot.timer."
fi
