# =============================================================================
# lamware nginx — React SPA + FastAPI reverse proxy
#
# Serves the React frontend from /opt/frontend/dist/ and proxies
# /api/*, /health, /ws/*, /docs, /redoc to FastAPI on port 8001.
#
# Listens on all interfaces — protected by OVH robot firewall + fail2ban.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

# Rate limiting zones
# API:   30 req/sec per IP (burst 50)  — normal browsing
# Auth:   5 req/sec per IP (burst 50)  — login/token endpoints
# Admin: 30 req/sec per IP (burst 100) — Keycloak admin console
# Upload: 2 req/sec per IP (burst 5)   — sample submission
# ws:     5 req/sec per IP (burst 10)  — WebSocket handshakes (#208)
#
# The auth burst reads 50, not the 10 this comment claimed until #209. The deployed
# value is the one that works, so the comment was corrected rather than the config:
# tightening a live login path on the strength of a stale comment is the wrong
# direction to resolve a mismatch. If 10 was the real intent it needs a login test
# behind it, not an edit here.
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=admin:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=upload:10m rate=2r/s;
limit_req_zone $binary_remote_addr zone=ws:10m rate=5r/s;
limit_req_status 429;

# HTTP — ACME challenges + HTTPS redirect
server {
    listen {{ wireguard_address | ansible.utils.ipaddr('address') }}:{{ frontend_nginx_http_port }};
    listen {{ public_ip }}:{{ frontend_nginx_http_port }};
    server_name {{ frontend_server_name }};

    # Let's Encrypt HTTP-01 challenge (certbot webroot)
    location /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
    }

    # Everything else → HTTPS
    location / {
        return 301 https://{{ frontend_server_name }}$request_uri;
    }
}

server {
    listen {{ wireguard_address | ansible.utils.ipaddr('address') }}:{{ frontend_nginx_port }} ssl;
    listen {{ public_ip }}:{{ frontend_nginx_port }} ssl;
    server_name {{ frontend_server_name }};

    # TLS certificate (Let's Encrypt via certbot auto-renewal)
    ssl_certificate {{ frontend_ssl_cert }};
    ssl_certificate_key {{ frontend_ssl_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Security headers
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{{ frontend_server_name }}; frame-ancestors 'none'" always;

    # React SPA — static files from Vite build
    root {{ frontend_dist_dir }};
    index index.html;

    # Client-side routing — serve index.html for all non-file, non-API paths
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static asset caching (Vite hashes filenames, safe to cache aggressively)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # nginx add_header does NOT merge: any add_header in a location REPLACES every
        # inherited server-level header. This block previously added Cache-Control only,
        # which silently dropped all six security headers from every static asset —
        # including HSTS and CSP (#209).
        add_header X-Frame-Options DENY always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{{ frontend_server_name }}; frame-ancestors 'none'" always;
    }

    # Investigation agent SSE — buffering must be off or events queue up
    # in nginx until the response completes, breaking real-time streaming.
    location /api/investigate/ {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # SSE streaming requires HTTP/1.1 to the upstream with keep-alive;
        # HTTP/1.0 (nginx default to upstream) buffers/breaks chunked streams.
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;
    }

    # FastAPI API proxy
    location /api/ {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # File upload support (100MB max matches FastAPI limit)
        client_max_body_size 100m;
    }

    # Sample submission — stricter rate limit
    location /api/samples/ {
        limit_req zone=upload burst=5 nodelay;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;
    }

    # Health endpoint proxy
    location /health {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }

    # WebSocket proxy — real-time pipeline updates
    location /ws/ {
        # Rate limit the HANDSHAKE, not the message stream: limit_req counts requests,
        # and an established WebSocket is one request. This bounds connect attempts,
        # which is the brute-force surface -- /ws/ authenticates in-band via the first
        # frame, so an unlimited handshake rate is an unlimited token-guessing rate.
        # It was the only proxied location with no limit_req at all (#208).
        #
        # burst=10: a page load opens one socket, and a reconnect storm after a deploy
        # is the legitimate worst case. Deliberately far below the api zone's 50.
        limit_req zone=ws burst=10 nodelay;

        proxy_pass http://{{ frontend_api_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 24h is intentional and is why the application enforces its own session
        # deadline: without one, a socket could outlive a ~5-minute Keycloak token by
        # a full day, so disabling a user would not disconnect them. See
        # _MAX_WS_SESSION_S in api/app/routers/ws.py.
        proxy_read_timeout 86400;
    }

    # OpenAPI docs proxy - WireGuard only (#529)
    location /docs {
        # Management surface: WireGuard peers only (#529).
        # The public 443 listener is deliberate and serves the SPA, /api/ and /ws/.
        # These four paths are not part of that: /docs, /redoc and /openapi.json
        # enumerate every endpoint and its schema for an unauthenticated reader,
        # and /auth/admin/ is the Keycloak admin console - the highest-value target
        # on the host. Both listeners share this server block, so the split is per
        # location on $remote_addr rather than per listener.
        allow {{ wireguard_address | ansible.utils.ipaddr('subnet') }};
        deny all;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }
    location /redoc {
        # Management surface: WireGuard peers only (#529).
        # The public 443 listener is deliberate and serves the SPA, /api/ and /ws/.
        # These four paths are not part of that: /docs, /redoc and /openapi.json
        # enumerate every endpoint and its schema for an unauthenticated reader,
        # and /auth/admin/ is the Keycloak admin console - the highest-value target
        # on the host. Both listeners share this server block, so the split is per
        # location on $remote_addr rather than per listener.
        allow {{ wireguard_address | ansible.utils.ipaddr('subnet') }};
        deny all;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }
    location /openapi.json {
        # Management surface: WireGuard peers only (#529).
        # The public 443 listener is deliberate and serves the SPA, /api/ and /ws/.
        # These four paths are not part of that: /docs, /redoc and /openapi.json
        # enumerate every endpoint and its schema for an unauthenticated reader,
        # and /auth/admin/ is the Keycloak admin console - the highest-value target
        # on the host. Both listeners share this server block, so the split is per
        # location on $remote_addr rather than per listener.
        allow {{ wireguard_address | ansible.utils.ipaddr('subnet') }};
        deny all;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }

    # Keycloak admin console. Previously exempted from rate limiting entirely, with
    # "makes many rapid API calls" as the reason — true, but it left the highest-value
    # target on the host as the one auth path with no brute-force control, while
    # /auth/ immediately below it had one (#209).
    #
    # Given its own zone rather than reusing `auth` (5 r/s), which would very likely
    # break the console and is why it was exempted in the first place. 30 r/s with a
    # burst of 100 sits far above interactive use and far below useful credential
    # stuffing. NOT yet validated against a real admin session — see the issue.
    #
    # Must appear before /auth/ so nginx matches the more specific prefix.
    location /auth/admin/ {
        # Management surface: WireGuard peers only (#529).
        # The public 443 listener is deliberate and serves the SPA, /api/ and /ws/.
        # These four paths are not part of that: /docs, /redoc and /openapi.json
        # enumerate every endpoint and its schema for an unauthenticated reader,
        # and /auth/admin/ is the Keycloak admin console - the highest-value target
        # on the host. Both listeners share this server block, so the split is per
        # location on $remote_addr rather than per listener.
        allow {{ wireguard_address | ansible.utils.ipaddr('subnet') }};
        deny all;
        limit_req zone=admin burst=100 nodelay;
        proxy_pass http://127.0.0.1:{{ keycloak_port | default(8080) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        # Re-added: overriding X-Frame-Options here replaced the whole inherited set,
        # so HSTS and CSP were silently dropped on every Keycloak response (#209).
        # The X-Frame-Options override was deliberate and documented; these two were
        # collateral and nobody noticed.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self'" always;
    }

    # Keycloak identity broker proxy
    # Override X-Frame-Options to SAMEORIGIN — Keycloak admin console uses
    # iframes for its auth flow (step1.html). DENY blocks this.
    location /auth/ {
        limit_req zone=auth burst=50 nodelay;
        proxy_pass http://127.0.0.1:{{ keycloak_port | default(8080) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Keycloak sets its own security headers — override server-level DENY
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        # Re-added: overriding X-Frame-Options here replaced the whole inherited set,
        # so HSTS and CSP were silently dropped on every Keycloak response (#209).
        # The X-Frame-Options override was deliberate and documented; these two were
        # collateral and nobody noticed.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'self'" always;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 256;
}
