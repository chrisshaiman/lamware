# =============================================================================
# lamware nginx — React SPA + FastAPI reverse proxy
#
# Serves the React frontend from /opt/frontend/dist/ and proxies
# /api/*, /health, /ws/*, /docs, /redoc to FastAPI on port 8001.
#
# Listens on wg0 (WireGuard) only — not exposed to the internet.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

# Rate limiting zones
# API: 30 requests/sec per IP (burst 50) — normal browsing
# Auth: 5 requests/sec per IP (burst 10) — login/token endpoints
# Upload: 2 requests/sec per IP (burst 5) — sample submission
limit_req_zone $binary_remote_addr zone=api:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/s;
limit_req_zone $binary_remote_addr zone=upload:10m rate=2r/s;
limit_req_status 429;

# HTTP → HTTPS redirect
server {
    listen {{ wireguard_address | ansible.utils.ipaddr('address') }}:{{ frontend_nginx_http_port }};
    server_name {{ frontend_server_name }};
    return 301 https://$host$request_uri;
}

server {
    listen {{ wireguard_address | ansible.utils.ipaddr('address') }}:{{ frontend_nginx_port }} ssl;
    server_name {{ frontend_server_name }};

    # Self-signed cert (replace with Let's Encrypt when a domain is set up)
    ssl_certificate {{ frontend_ssl_cert }};
    ssl_certificate_key {{ frontend_ssl_key }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Security headers
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' wss://{{ frontend_server_name }}; frame-ancestors 'none'" always;

    # React SPA — static files from Vite build
    root {{ frontend_dist_dir }};
    index index.html;

    # Client-side routing — serve index.html for all non-file, non-API paths
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Static asset caching (Vite hashes filenames, safe to cache aggressively)
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # FastAPI API proxy
    location /api/ {
        limit_req zone=api burst=50 nodelay;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # File upload support (100MB max matches FastAPI limit)
        client_max_body_size 100m;
    }

    # Sample submission — stricter rate limit
    location /api/samples/ {
        limit_req zone=upload burst=5 nodelay;
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 100m;
    }

    # Health endpoint proxy
    location /health {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }

    # WebSocket proxy (for future real-time pipeline updates)
    location /ws/ {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 86400;
    }

    # OpenAPI docs proxy
    location /docs {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }
    location /redoc {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }
    location /openapi.json {
        proxy_pass http://{{ frontend_api_upstream }};
        proxy_set_header Host $host;
    }

    # Keycloak identity broker proxy
    # Override X-Frame-Options to SAMEORIGIN — Keycloak admin console uses
    # iframes for its auth flow (step1.html). DENY blocks this.
    location /auth/ {
        limit_req zone=auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:{{ keycloak_port | default(8080) }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffer_size 128k;
        proxy_buffers 4 256k;
        proxy_busy_buffers_size 256k;

        # Keycloak sets its own security headers — override server-level DENY
        add_header X-Frame-Options SAMEORIGIN always;
        add_header X-Content-Type-Options nosniff always;
        add_header X-XSS-Protection "1; mode=block" always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
    }

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml;
    gzip_min_length 256;
}
