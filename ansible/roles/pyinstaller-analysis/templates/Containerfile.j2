# PyInstaller analysis container — pyinstxtractor + pycdc
# Extracts and decompiles Python bytecode from PyInstaller executables.
# Built locally by Ansible. Never pulled from a registry.
#
# LICENSING NOTE:
# - pyinstxtractor is GPL-3.0 licensed, invoked as a subprocess only.
# - pycdc (Decompyle++) is GPL-3.0 licensed, invoked as a subprocess only.
# Neither is linked or imported into the Apache 2.0 project code.
FROM {{ build_fetch_python_slim }}

# Sources are fetched into the build context by the ROLE, not by this build.
#
# The build runs as the `pipeline` user, whose outbound is restricted to
# loopback:5432 and loopback:8000 — it cannot even resolve DNS (#343). Ansible
# runs as root, which can, so the fetch happens where the network exists and the
# build stays hermetic. That also makes the pin real: a commit sha plus a sha256
# of the exact bytes, verified before the build starts rather than trusted from
# whatever the network returned mid-build.
COPY pycdc.tar.gz /tmp/pycdc.tar.gz

# Build pycdc from source — supports Python 3.11/3.12 bytecode
# Hermetic (ADR-023): the compiler is fetched by lamware-fetch, and purged by
# exact package name after (dpkg -i marks everything manual; see triage).
COPY debs/build/ /tmp/debs/
# Purge only what this set ADDED: it can carry newer base packages (libc6 and
# friends) from the snapshot, which are upgrades and must stay.
RUN dpkg-query -W -f='${Package}\n' | sort -u > /tmp/pre-pkgs \
    && for f in /tmp/debs/*.deb; do dpkg-deb -f "$f" Package; done | sort -u \
       | comm -23 - /tmp/pre-pkgs > /tmp/build-pkgs \
    && rm -f /tmp/pre-pkgs \
    && dpkg -i /tmp/debs/*.deb \
    && tar -xzf /tmp/pycdc.tar.gz -C /tmp \
    && cd /tmp/pycdc-{{ pycdc_commit }} \
    && cmake . \
    && make -j$(nproc) \
    && cp pycdc /usr/local/bin/pycdc \
    && cp pycdas /usr/local/bin/pycdas \
    && rm -rf /tmp/pycdc.tar.gz /tmp/pycdc-{{ pycdc_commit }} \
    && dpkg -P $(cat /tmp/build-pkgs) \
    && rm -rf /tmp/debs /tmp/build-pkgs

# pyinstxtractor — also fetched by the role. It was wget'd from `master`, so it
# was doubly unpinned: the URL had no commit AND it needed GitHub from a user with
# no network. Fixing only pycdc would have failed one line later.
COPY pyinstxtractor.py /opt/pyinstxtractor.py
RUN chmod +x /opt/pyinstxtractor.py

COPY analyze-pyinstaller.py /opt/analyze-pyinstaller.py
RUN chmod +x /opt/analyze-pyinstaller.py

RUN mkdir -p /output /nonexistent /work && chmod 777 /nonexistent /output /work
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/analyze-pyinstaller.py"]
