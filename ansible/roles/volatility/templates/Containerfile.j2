# Volatility 3 memory forensics container
# Built locally by Ansible. Never pulled from a registry.
# {{ build_fetch_python_slim }}, by image ID (ADR-023 amendment)
FROM {{ build_fetch_python_slim_id }}
LABEL lamware.base="{{ build_fetch_python_slim }}"

# Hermetic (ADR-023): every input below was fetched by lamware-fetch.
# requirements.lock pins volatility3 to volatility_version ({{ volatility_version }}).
COPY debs/main/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb && rm -rf /tmp/debs

COPY wheels/ /tmp/wheels/
COPY requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir --no-index --find-links /tmp/wheels \
        --require-hashes -r /tmp/requirements.lock \
    && rm -rf /tmp/wheels /tmp/requirements.lock

# ISF symbol tables are mounted at runtime via volume at /symbols
# Memory dump is mounted at /dump (read-only)
# Output goes to /output (read-write volume)

ENTRYPOINT ["vol"]
