#!/bin/bash
# =============================================================================
# run-volatility — host-side wrapper for containerized Volatility 3
# Runs a single Volatility plugin against a memory dump inside a Podman
# container with full isolation.
#
# Usage: run-volatility <dump_path> <plugin> [output_dir] [extra_args...]
#
# Example:
#   run-volatility /tmp/memdump.raw windows.pslist /tmp/vol-output
#   run-volatility /tmp/memdump.raw windows.malfind /tmp/vol-output --dump
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

if [ $# -lt 2 ]; then
    echo "Usage: run-volatility <dump_path> <plugin> [output_dir] [extra_args...]" >&2
    exit 1
fi

DUMP_PATH="$(realpath "$1")"
DUMP_DIR="$(dirname "$DUMP_PATH")"
DUMP_NAME="$(basename "$DUMP_PATH")"
PLUGIN="$2"
OUTPUT_DIR="${3:-{{ volatility_output_dir }}}"

# Extra args (e.g., --dump) are passed through to the plugin
shift 3 2>/dev/null || shift $#
EXTRA_ARGS=("$@")

if [ ! -f "$DUMP_PATH" ]; then
    echo "Error: dump not found: $DUMP_PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# The container runs as 65534 (#339). It used to run as the image default, root
# inside the rootless userns — which IS the host pipeline uid — with the live
# report dir mounted rw: a Volatility parser bug reached by a hostile dump wrote
# as pipeline. Like the other analysers, it now writes only a private job dir
# that belongs to the container's mapped uid, and its output is handed back by
# the pipeline user, dropping anything that is not a regular file or directory.
# HOME=/tmp: nobody's home is /nonexistent on a read-only root, and Volatility
# creates its cache directory under $HOME (measured: "[Errno 30] Read-only file
# system: '/nonexistent'" on every plugin).
CONTAINER_UID=65534
CONTAINER_GID=65534
JOB_DIR=""
cleanup() {
    if [ -n "$JOB_DIR" ] && [ -d "$JOB_DIR" ]; then
        podman unshare rm -rf "$JOB_DIR" 2>/dev/null || rm -rf "$JOB_DIR" 2>/dev/null || true
    fi
}
trap cleanup EXIT
JOB_DIR="$(mktemp -d)"
mkdir -m 0700 "$JOB_DIR/out"
podman unshare chown "$CONTAINER_UID:$CONTAINER_GID" "$JOB_DIR/out"

# Container is read-only with targeted writable tmpfs mounts for
# Volatility's cache and temp files. The dump is mounted directly (read-only)
# — no copy, since dumps are multi-GB.
#
# --group-add keep-groups: Cape writes memory.dmp as cape:lamware with an ACL,
# and `pipeline` reads it via the lamware group. Rootless podman drops
# supplementary groups by default, so without this the container cannot read
# the dump and Volatility reports "File does not exist" about a file that
# plainly exists. Requires crun (verified in use on this host).
#
# That failure was load-bearing, not cosmetic: stages/volatility.py falls back
# to the Cape path whenever its ramdisk copy does not happen
# (`active_dump = ramdisk_dump if ramdisk_dump else dump_path`), and two
# concurrent analyses do not fit in the 12g ramdisk. The fallback made EVERY
# plugin fail, not just one.
#
# The mount is the FILE, not its directory. With supplementary groups now
# carried in, mounting the directory would expose the whole analysis tree —
# measured at 24 files including the pcap. Mounting one file keeps the
# container to exactly what it needs, which is strictly narrower than the
# directory mount this replaces.
#
# CAUTION: keep-groups means any mount added here inherits lamware read access
# to whatever it covers. That group owns ~68k paths under
# /opt/CAPEv2/storage/analyses, including extracted payloads. Do not mount the
# storage root.
# Use timeout(1) instead of --timeout — Podman 4.x rootless timeout is unreliable
rc=0
timeout --kill-after=60 {{ volatility_container_timeout }} \
podman run --rm \
    --network=none \
    --group-add keep-groups \
    --read-only \
    --user "$CONTAINER_UID:$CONTAINER_GID" \
    -e HOME=/tmp \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ volatility_container_memory }} \
    --cpus={{ volatility_container_cpus }} \
    --tmpfs /tmp:size=2g \
    --tmpfs /root:size=100m \
    --tmpfs /home:size=100m \
    --tmpfs /var/cache:size=100m \
    -v "{{ volatility_install_dir }}/cache:/vol-cache:ro" \
    -v "$DUMP_PATH:/dump/$DUMP_NAME:ro" \
    -v "{{ volatility_symbols_dir }}:/symbols:ro" \
    -v "$JOB_DIR/out:/output:rw" \
    --workdir /output \
    localhost/volatility3:latest \
    -f "/dump/$DUMP_NAME" \
    -s /symbols \
    --cache-path /vol-cache \
    -r json \
    -o /output \
    "$PLUGIN" \
    "${EXTRA_ARGS[@]}" || rc=$?

# Hand the output back whatever the plugin's result: a failed malfind may still
# have dumped regions worth keeping.
podman unshare chown -R 0:0 "$JOB_DIR/out"
find "$JOB_DIR/out" -mindepth 1 ! -type f ! -type d -print -delete \
    | sed 's/^/run-volatility: dropped non-regular output entry: /' >&2
find "$JOB_DIR/out" -mindepth 1 -maxdepth 1 \
    -exec cp -a --remove-destination -t "$OUTPUT_DIR"/ {} + 2>/dev/null || true
exit "$rc"
