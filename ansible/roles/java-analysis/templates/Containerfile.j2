# Java analysis container — java-deobfuscator + CFR decompiler
# Deobfuscates and decompiles Java bytecode to readable source code.
# Built locally by Ansible. Never pulled from a registry.
#
# java-deobfuscator is Apache 2.0 licensed.
# CFR is MIT licensed.
#
# Hermetic (ADR-023): built with --network=none. Every input below was downloaded
# and verified before the build: the base image by digest, the Debian packages by
# lamware-fetch from a pinned Ubuntu snapshot, the jars by the role (checksummed).
FROM {{ java_analysis_base_image }}

COPY debs/main/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb && rm -rf /tmp/debs

# CFR decompiler JAR is downloaded at build time by Ansible
COPY cfr.jar /opt/cfr.jar

# java-deobfuscator — Apache 2.0, handles ZKM, Allatori, Stringer, etc.
# Fetched by the role like cfr.jar above, not wget'd here: the build runs as the
# `pipeline` user, which cannot resolve DNS (#343). This step failed the deploy on
# 2026-08-08 with "Temporary failure in name resolution" — while apt, in the same
# build, had just pulled 47.7 MB. The correct pattern was already in this file for
# CFR; the deobfuscator simply never got it.
COPY java-deobfuscator.jar /opt/java-deobfuscator.jar

COPY analyze-java.py /opt/analyze-java.py
RUN chmod +x /opt/analyze-java.py

RUN mkdir -p /output /nonexistent /work && chmod 777 /nonexistent /output /work
ENV HOME=/nonexistent

ENTRYPOINT ["python3", "/opt/analyze-java.py"]
