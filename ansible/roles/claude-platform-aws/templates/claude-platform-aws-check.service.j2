# /etc/systemd/system/claude-platform-aws-check.service — managed by Ansible (claude-platform-aws role)
# Daily: the host certificate has days left, it still yields credentials, and a
# free count_tokens call is still authorised in the workspace (ADR-026).

[Unit]
Description=Claude Platform on AWS forwarder health check (ADR-026)
After=network-online.target
Wants=network-online.target
OnFailure=claude-platform-aws-alert.service

[Service]
Type=oneshot
User={{ claude_platform_aws_user }}
Group={{ claude_platform_aws_user }}
ExecStart=/usr/bin/python3 -I {{ claude_platform_aws_install_dir }}/claude_platform_aws.py check --config {{ claude_platform_aws_config_dir }}/config.json
LoadCredential=host.key:{{ claude_platform_aws_config_dir }}/host.key
LoadCredential=host.pem:{{ claude_platform_aws_config_dir }}/host.pem
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
CapabilityBoundingSet=
AmbientCapabilities=
