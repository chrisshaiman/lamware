#!/bin/bash
# =============================================================================
# security-smoke-test.sh — post-deploy security verification
#
# Fast (<30s) smoke tests to verify security controls are in place
# after an Ansible deploy. Sends ntfy alert on failure.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -uo pipefail

API_URL="{{ security_test_api_url }}"
WG_URL="{{ security_test_wg_url }}"
KC_URL="{{ security_test_keycloak_url }}"
DOMAIN="{{ security_test_domain }}"
NUCLEI="{{ security_test_install_dir }}/nuclei"
NTFY_URL="{{ ntfy_url }}/{{ ntfy_topic }}"
{# `| default(false)` only substitutes when UNDEFINED — a defined string
   "false" sails straight through and is truthy, so `-e ntfy_enabled=false`
   rendered this as true (#349). `| bool` is what actually tests the value.
   This playbook has no `when: ntfy_enabled` to catch the mistake downstream,
   so unlike site.yml it fails SILENTLY: the smoke test just starts pushing
   alerts the operator asked it not to send. #}
NTFY_ENABLED={{ 'true' if ntfy_enabled | default(false) | bool else 'false' }}
RESULTS_DIR="{{ security_test_install_dir }}/results"

PASSED=0
FAILED=0
FAILURES=""

mkdir -p "$RESULTS_DIR"

# -------------------------------------------------------------------------
# Helpers
# -------------------------------------------------------------------------

pass() {
    PASSED=$((PASSED + 1))
    echo "  PASS: $1"
}

fail() {
    FAILED=$((FAILED + 1))
    FAILURES="${FAILURES}\n  - $1"
    echo "  FAIL: $1"
}

# -------------------------------------------------------------------------
# Test 1: API health endpoint
# -------------------------------------------------------------------------
echo "[1/12] API health check..."
# $WG_URL, not $API_URL: #604 removed the public TLS listener, so the domain
# resolves to an address nothing serves. Probing it measured DNS, not the API.
HTTP_CODE=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$WG_URL/health")
if [ "$HTTP_CODE" = "200" ]; then
    pass "API health endpoint returns 200"
else
    fail "API health endpoint returned $HTTP_CODE (expected 200)"
fi

# -------------------------------------------------------------------------
# Test 2: Keycloak health
# -------------------------------------------------------------------------
echo "[2/12] Keycloak health check..."
KC_CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://127.0.0.1:9000/auth/health/ready")
if [ "$KC_CODE" = "200" ]; then
    pass "Keycloak health endpoint returns 200"
else
    fail "Keycloak health returned $KC_CODE (expected 200)"
fi

# -------------------------------------------------------------------------
# Test 3: Unauthenticated API access blocked
# -------------------------------------------------------------------------
echo "[3/12] Auth enforcement..."
UNAUTH_CODE=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$WG_URL/api/analyses")
if [ "$UNAUTH_CODE" = "401" ] || [ "$UNAUTH_CODE" = "403" ]; then
    pass "Unauthenticated /api/analyses returns $UNAUTH_CODE"
else
    fail "Unauthenticated /api/analyses returned $UNAUTH_CODE (expected 401/403)"
fi

# -------------------------------------------------------------------------
# Test 4: Docs endpoint gated
# -------------------------------------------------------------------------
echo "[4/12] Docs endpoint gated..."
# There are TWO gates since #529, and this checks both. Previously it checked
# only the application one and asserted 404, so adding the network layer made a
# correctly-hardened host fail:
#
#   public listener   nginx `deny all`            -> 403, refused before the app
#   WireGuard peer    LAMWARE_ENABLE_DOCS=false   -> 404, from the API itself
#
# 403 is the STRONGER answer, not a regression. The invariant that actually
# matters is that /docs is never 200 from either source, so that is asserted
# directly rather than pinning an exact code and calling it security.
# Since #604 there is NO public TLS listener, so a public probe returns 000
# (refused) and can no longer tell "nginx denied me" from "nothing is
# listening". Asserting 403 here would fail a host that is strictly safer than
# the one the assertion was written for.
#
# The invariant that matters is unchanged: /docs must never be 200 from either
# source. That is asserted directly. The public side is now asserted as
# "refused", which is the stronger property #604 created.
DOCS_PUBLIC=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$API_URL/docs")
DOCS_WG=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "$WG_URL/docs")

if [ "$DOCS_PUBLIC" = "200" ]; then
    fail "/docs returned 200 on the public address — it is exposed"
elif [ "$DOCS_WG" = "200" ]; then
    fail "/docs returned 200 over WireGuard — LAMWARE_ENABLE_DOCS is on"
elif [ "$DOCS_PUBLIC" = "000" ] || [ "$DOCS_PUBLIC" = "403" ]; then
    pass "/docs: $DOCS_PUBLIC publicly (no listener or denied), $DOCS_WG over WireGuard"
else
    fail "/docs returned $DOCS_PUBLIC publicly, expected 000 (no listener) or 403"
fi

# -------------------------------------------------------------------------
# Test 5: TLS certificate valid
# -------------------------------------------------------------------------
echo "[5/12] TLS certificate check..."
# WireGuard address: TLS is no longer served publicly (#604). -servername keeps
# the SNI as the real domain, which is what the certificate is issued for.
CERT_EXPIRY=$(echo | openssl s_client -servername "$DOMAIN" -connect {{ security_test_wg_address }}:443 2>/dev/null | openssl x509 -noout -enddate 2>/dev/null | cut -d= -f2)
if [ -n "$CERT_EXPIRY" ]; then
    EXPIRY_EPOCH=$(date -d "$CERT_EXPIRY" +%s 2>/dev/null)
    NOW_EPOCH=$(date +%s)
    DAYS_LEFT=$(( (EXPIRY_EPOCH - NOW_EPOCH) / 86400 ))
    if [ "$DAYS_LEFT" -gt 7 ]; then
        pass "TLS cert valid for $DAYS_LEFT more days"
    else
        fail "TLS cert expires in $DAYS_LEFT days"
    fi
else
    fail "Could not read TLS certificate"
fi

# -------------------------------------------------------------------------
# Test 6: HTTP redirects to HTTPS
# -------------------------------------------------------------------------
echo "[6/12] HTTP redirect check..."
REDIRECT_CODE=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 "http://{{ public_ip | default('127.0.0.1') }}/" -H "Host: $DOMAIN")
if [ "$REDIRECT_CODE" = "301" ]; then
    pass "HTTP redirects to HTTPS (301)"
else
    fail "HTTP returned $REDIRECT_CODE (expected 301 redirect)"
fi

# -------------------------------------------------------------------------
# Test 7: the UI is NOT served on the public address (#604)
# -------------------------------------------------------------------------
# Asserted positively, because "the tests stopped failing" is not evidence a
# listener is gone. Every other test here would still pass if the public TLS
# listener came back — they probe WireGuard now — so without this the whole
# point of #604 could regress silently.
#
# Port 80 MUST stay public: certbot renews by webroot/HTTP-01, so Let's Encrypt
# has to reach the challenge. Both halves are checked; removing the port-80
# listener breaks renewal and would not show up for ~90 days.
echo "[7/12] Public listener surface..."
# NO `|| echo 000` here. curl's -w already prints 000 when the connection is
# refused AND exits non-zero, so the fallback CONCATENATES: the first live run
# of this check reported "000000", which matches neither branch and reported a
# returning public listener on a host where TLS was correctly refused.
PUB_TLS=$(curl -sk -o /dev/null -w '%{http_code}' --max-time 5 "https://{{ public_ip }}/" 2>/dev/null)
PUB_TLS=${PUB_TLS:-000}
PUB_ACME=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 \
    "http://{{ public_ip }}/.well-known/acme-challenge/smoke-probe" -H "Host: $DOMAIN" 2>/dev/null)
PUB_ACME=${PUB_ACME:-000}

if [ "$PUB_TLS" != "000" ]; then
    fail "public TLS listener is back: https://{{ public_ip }}/ returned $PUB_TLS (#604)"
elif [ "$PUB_ACME" = "000" ]; then
    fail "public port 80 is not answering ACME — certbot webroot renewal will fail silently"
else
    pass "public: TLS refused, ACME reachable ($PUB_ACME for a missing challenge file)"
fi

# -------------------------------------------------------------------------
# Test 8: Nuclei quick scan
# -------------------------------------------------------------------------
echo "[8/12] Nuclei misconfig scan..."
if [ -x "$NUCLEI" ]; then
    NUCLEI_OUT="$RESULTS_DIR/nuclei-$(date +%Y%m%d-%H%M%S).txt"
    # $WG_URL, not $API_URL. After #604 the public address serves no TLS, and a
    # scanner pointed at a dead address reports zero findings — a false pass
    # that looks identical to a clean scan. Scan where the app actually is.
    "$NUCLEI" -u "$WG_URL" -t http/ -severity high,critical -timeout 10 \
        -silent -no-color -o "$NUCLEI_OUT" 2>/dev/null
    NUCLEI_FINDINGS=$(wc -l < "$NUCLEI_OUT" 2>/dev/null || echo "0")
    if [ "$NUCLEI_FINDINGS" -eq 0 ]; then
        pass "Nuclei: no high/critical findings"
    else
        fail "Nuclei: $NUCLEI_FINDINGS high/critical finding(s) — see $NUCLEI_OUT"
    fi
else
    fail "Nuclei binary not found at $NUCLEI"
fi

# =============================================================================
# Can the sandbox still reach the things it analyses?
#
# The checks above all probe the PUBLIC surface. Nothing checked the inward
# path, and that gap cost a working day twice.
#
# #563 (2026-09-03): a `TAGS=hardening,kvm,frontend` deploy left the host unable
# to reach its own guests. konstruktoid set `deny (outgoing)` with no rule for
# the detonation network, and `roles/networking` -- which owns those rules --
# was not in the tag list. A freshly built guest booted, took a DHCP lease,
# reached the desktop, and answered nothing. Hours went into the image before
# the host was suspected.
#
# 2026-09-19: the same mechanism, different route. CAPE could not reach the
# guest agent, every detonation returned 0 processes and 0 API calls, and the
# cause -- OUTPUT dropping to the detonation subnet -- took three detonations
# and a packet-logging rule to find. #563 had already written it down.
#
# This is the assertion that issue asked for. A guest is usually shut off, so
# the firewall PATH is checked rather than a live connection, and the live
# connection is attempted only when a guest happens to be up.
# =============================================================================
echo "[9/12] PREREQUISITE: sandbox can reach its own guests..."
DET_SUBNET="{{ security_test_detonation_subnet | default('192.168.100.0/24') }}"
DET_BRIDGE="{{ security_test_detonation_bridge | default('virbr-det') }}"
AGENT_PORT="{{ security_test_guest_agent_port | default('8000') }}"
GUEST_IP="{{ security_test_guest_ip | default('192.168.100.10') }}"

OUT_POLICY=$(sudo iptables -S OUTPUT 2>/dev/null | awk '/^-P OUTPUT/ {print $3}')
DET_ACCEPT=$(sudo iptables -S 2>/dev/null | grep -cE "^-A .*-o ${DET_BRIDGE}.*-j ACCEPT")

if [ "$OUT_POLICY" = "ACCEPT" ]; then
    PATH_OK="policy ACCEPT"
elif [ "${DET_ACCEPT:-0}" -gt 0 ]; then
    PATH_OK="explicit ACCEPT to ${DET_BRIDGE}"
else
    PATH_OK=""
fi

if [ -z "$PATH_OK" ]; then
    fail "OUTPUT policy is $OUT_POLICY with no ACCEPT to ${DET_BRIDGE} — the host cannot reach its own guests; CAPE will time out on guest init with 0 processes (#563)"
else
    # If a guest is actually up, prove it rather than infer it.
    if sudo virsh list --state-running --name 2>/dev/null | grep -q .; then
        if timeout 5 bash -c "echo > /dev/tcp/${GUEST_IP}/${AGENT_PORT}" 2>/dev/null; then
            pass "guest agent reachable at ${GUEST_IP}:${AGENT_PORT} ($PATH_OK)"
        else
            fail "a guest is running but its agent at ${GUEST_IP}:${AGENT_PORT} is unreachable — analyses will time out on guest init (#563)"
        fi
    else
        pass "firewall path to ${DET_BRIDGE} is open ($PATH_OK); no guest running to probe"
    fi
fi

# =============================================================================
# CONTAINMENT. Everything above either checks a service is UP or checks one
# negative property (the public TLS listener). These check the properties the
# whole sandbox rests on: that things which must be impossible are.
#
# They were missing. `make security-test` ran nine checks and asserted
# containment once, while SECURITY_MODEL.md said outright that the air gap was
# somebody else's job. On 2026-09-19 the pipeline user's egress DROP sat at 0
# packets for a day, reachable to 1.1.1.1:443, and nothing in this file would
# have noticed.
#
# A negative assertion has to be made by ATTEMPTING the thing. A rule that
# exists satisfied every structural check for the whole day it did nothing.
# =============================================================================
echo "[10/12] CONTAINMENT: pipeline user cannot reach the internet..."
PIPE_USER="{{ security_test_pipeline_user | default('pipeline') }}"
if ! id -u "$PIPE_USER" >/dev/null 2>&1; then
    fail "user $PIPE_USER does not exist — the egress allowlist cannot be verified"
else
    EGRESS_LEAK=""
    for dst in 1.1.1.1/443 8.8.8.8/443 1.1.1.1/53; do
        if sudo -u "$PIPE_USER" timeout 4 bash -c "echo > /dev/tcp/${dst}" 2>/dev/null; then
            EGRESS_LEAK="${EGRESS_LEAK}${EGRESS_LEAK:+, }${dst}"
        fi
    done
    if [ -n "$EGRESS_LEAK" ]; then
        fail "pipeline user reached the internet at $EGRESS_LEAK — a compromised analysis process can exfiltrate"
    else
        pass "pipeline user: internet refused (443, 53 to three destinations)"
    fi
fi

echo "[11/12] CONTAINMENT: pipeline user is held to its localhost allowlist..."
if id -u "$PIPE_USER" >/dev/null 2>&1; then
    LOCAL_LEAK=""
    # Ports the role explicitly revokes. Reaching either means the allowlist is
    # not being enforced, however present its rules look.
    for dst in 127.0.0.1/27017 127.0.0.1/4000; do
        if sudo -u "$PIPE_USER" timeout 4 bash -c "echo > /dev/tcp/${dst}" 2>/dev/null; then
            LOCAL_LEAK="${LOCAL_LEAK}${LOCAL_LEAK:+, }${dst}"
        fi
    done
    # And the allowlist must still work, or the check above passes for the
    # wrong reason — a host with no network at all would look contained.
    ALLOW_OK=0
    sudo -u "$PIPE_USER" timeout 4 bash -c "echo > /dev/tcp/127.0.0.1/5432" 2>/dev/null && ALLOW_OK=1

    if [ -n "$LOCAL_LEAK" ]; then
        fail "pipeline user reached $LOCAL_LEAK, which the allowlist denies — something ACCEPTs before the DROP"
    elif [ "$ALLOW_OK" -eq 0 ]; then
        fail "pipeline user cannot reach PostgreSQL on 5432 — the allowlist is denying traffic the pipeline needs"
    else
        pass "pipeline user: denied ports refused, allowed ports reachable"
    fi
fi

echo "[12/12] CONTAINMENT: detonation network cannot leave the box..."
# Guests are shut off between analyses and a host cannot originate a FORWARDed
# packet, so this asserts the RULES and their ORDER rather than a live probe.
# That is a weaker claim and is stated as one. network-monitor does the
# continuous version, reading counters every five minutes.
MGMT_IF="{{ management_interface }}"
AIRGAP_FAIL=""
for fam in iptables ip6tables; do
    for pair in "${MGMT_IF}:internet" "wg0:management"; do
        oif="${pair%%:*}"; label="${pair##*:}"
        # -v is REQUIRED: without it iptables omits the in/out interface
        # columns entirely, so nothing can match on virbr-det or the outbound
        # NIC. The first version of this check used `-L -n --line-numbers` and
        # reported "no rule for virbr-det" on a host whose air-gap rules were
        # present and correct -- a false FAILURE, which is its own kind of
        # dangerous: it trains the operator to distrust the alarm.
        #
        # Columns with -v -n -x --line-numbers:
        #   1:num 2:pkts 3:bytes 4:target 5:prot 6:opt 7:in 8:out 9:src 10:dst
        # Matched positionally rather than by substring, so a comment mentioning
        # an interface name cannot satisfy it.
        line=$(sudo "$fam" -L FORWARD -v -n -x --line-numbers 2>/dev/null \
               | awk -v o="$oif" 'NR>2 && $7 == "virbr-det" && $8 == o {print $1, $4; exit}')
        num="${line%% *}"; tgt="${line##* }"
        if [ -z "$line" ]; then
            AIRGAP_FAIL="${AIRGAP_FAIL}${AIRGAP_FAIL:+; }$fam has no rule for virbr-det -> $label ($oif)"
        elif [ "$tgt" != "DROP" ] && [ "$tgt" != "REJECT" ]; then
            AIRGAP_FAIL="${AIRGAP_FAIL}${AIRGAP_FAIL:+; }$fam rule $num for virbr-det -> $label is $tgt, not DROP"
        fi
    done
done
if [ -n "$AIRGAP_FAIL" ]; then
    fail "AIR GAP: $AIRGAP_FAIL — malware on the detonation network could reach the internet or the management VPN"
else
    pass "air gap: first matching FORWARD rule for virbr-det is DROP, both families, both paths"
fi

# -------------------------------------------------------------------------
# Summary + ntfy alert on failure
#
# This MUST stay below the last check. It used to sit after the nuclei scan,
# so it printed "Results: 8 passed, 0 failed" while the four containment
# checks -- the ones that actually assert the security boundary -- had not run
# yet. A reader seeing a green total had no way to tell it was a partial tally.
#
# (Deliberately no step label in this comment: the label regex in
# tests/test_security_smoke_targets_wireguard.py reads the whole rendered file
# and a number in prose is indistinguishable from a real step.)
# -------------------------------------------------------------------------
echo ""
echo "========================================="
echo "  Results: $PASSED passed, $FAILED failed"
echo "========================================="

if [ "$FAILED" -gt 0 ]; then
    echo -e "\nFailures:$FAILURES"

    if [ "$NTFY_ENABLED" = "true" ]; then
        curl -s -H "Title: lamware security test FAILED" \
             -H "Priority: urgent" \
             -H "Tags: rotating_light" \
             -d "Post-deploy security test: $PASSED passed, $FAILED failed$(echo -e "$FAILURES")" \
             "$NTFY_URL" >/dev/null 2>&1
    fi
    exit 1
fi

if [ "$NTFY_ENABLED" = "true" ]; then
    curl -s -H "Title: lamware security test passed" \
         -H "Priority: low" \
         -H "Tags: white_check_mark" \
         -d "Post-deploy: all $PASSED tests passed" \
         "$NTFY_URL" >/dev/null 2>&1
fi
exit 0
