# auto-feeder.service — one-shot MalwareBazaar ingestion cycle
# Triggered by auto-feeder.timer. Each invocation runs one cycle:
# check guardrails, query MalwareBazaar, download sample, run pipeline.
#
# Managed by Ansible (auto-feeder role). Do not edit manually.

[Unit]
Description=Auto-feeder MalwareBazaar ingestion cycle
After=network-online.target cape.service
Wants=network-online.target

[Service]
Type=oneshot
User={{ auto_feeder_user }}
Group={{ auto_feeder_user }}
SupplementaryGroups=lamware
WorkingDirectory=/tmp
Environment=HOME=/home/pipeline
ExecStart=/bin/bash -c 'export XDG_RUNTIME_DIR=/run/user/$(id -u); exec /usr/bin/python3 {{ auto_feeder_install_dir }}/auto-feeder.py'
TimeoutStartSec=4200

# Security hardening
NoNewPrivileges=true
# ProtectHome omitted — pipeline user's Podman config lives in /home/pipeline
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# PrivateTmp and ProtectSystem=strict intentionally omitted —
# Podman containers need host /tmp and /proc/sys access.
