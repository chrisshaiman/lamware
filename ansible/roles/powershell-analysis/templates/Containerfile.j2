# Hermetic (ADR-023): built with --network=none. The base image is pinned by
# digest; python3 was fetched by lamware-fetch from the Debian snapshot the base
# image records as its own.
# {{ powershell_analysis_base_image }}, by image ID (ADR-023 amendment)
FROM {{ powershell_analysis_base_image_id }}
LABEL lamware.base="{{ powershell_analysis_base_image }}"

COPY debs/main/ /tmp/debs/
# apt, not dpkg -i: dpkg does not order Pre-Depends (python3-minimal on
# python3.10-minimal failed that way). Every dependency is a local file here,
# so apt resolves among them with no lists and no network.
RUN DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends /tmp/debs/*.deb \
    && rm -rf /tmp/debs

# Static deobfuscation (#766): minusone (airbus-cert/minusone, MIT), as the
# pyminusone wheel lamware-fetch downloaded against requirements.lock. It parses
# PowerShell and evaluates obfuscated expressions; nothing from the sample runs.
# analyze-powershell.py adds the layer driver (iex / ScriptBlock / -enc).
#
# Installed without pip: Debian's python3-pip would add setuptools and wheel
# tooling to a container that parses hostile scripts, and this wheel is one
# compiled module. Each wheel's sha256 is checked against the lock again here
# (the fetch already checked it), then the wheel is extracted into site-packages.
# PSDecode, which this image used to name, was never installed and has no
# licence (#766).
COPY wheels/ /tmp/wheels/
COPY requirements.lock /tmp/requirements.lock
RUN python3 -c 'import glob, hashlib, re, sys, sysconfig, zipfile; \
ok = set(re.findall(r"sha256:([0-9a-f]{64})", open("/tmp/requirements.lock").read())); \
whls = glob.glob("/tmp/wheels/*.whl"); \
assert whls, "no wheels"; \
[sys.exit("hash not in lock: " + w) for w in whls if hashlib.sha256(open(w, "rb").read()).hexdigest() not in ok]; \
[zipfile.ZipFile(w).extractall(sysconfig.get_paths()["purelib"]) for w in whls]' \
    && python3 -c "import pyminusone; pyminusone.deobfuscate_powershell('Write-Host 1')" \
    && rm -rf /tmp/wheels /tmp/requirements.lock
# MIT requires the notice to travel with the binary.
COPY minusone-LICENSE /usr/share/doc/pyminusone/LICENSE

COPY analyze-powershell.py /opt/analyze-powershell.py

ENTRYPOINT ["python3", "/opt/analyze-powershell.py"]
