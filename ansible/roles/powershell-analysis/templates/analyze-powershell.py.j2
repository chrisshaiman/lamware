"""
analyze-powershell.py — PowerShell deobfuscation and IOC extraction.

Orchestrates PowerShell deobfuscation inside a Podman container with pwsh
and PSDecode installed. Handles Base64-encoded PowerShell commands (UTF-16LE,
as used with pwsh -EncodedCommand), runs PSDecode for multi-layer unpacking,
extracts IOCs (URLs, IPs, file paths, registry keys, domains), detects
obfuscation techniques, and surfaces behavioral strings of interest.

Author: Christopher Shaiman
"""

import argparse
import base64
import json
import re
import subprocess
import sys
import tempfile
import traceback
from pathlib import Path

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

MAX_SCRIPT_LENGTH = 100_000
PSDECODE_TIMEOUT = 30  # seconds


# ---------------------------------------------------------------------------
# Public entry point
# ---------------------------------------------------------------------------


def analyze_powershell(file_path: str) -> dict:
    """
    Orchestrate deobfuscation and IOC extraction for a PowerShell script.

    Reads the file as raw bytes, attempts Base64/UTF-16LE decode (the format
    used by ``pwsh -EncodedCommand``), then runs PSDecode for layer unwrapping.
    Falls back gracefully when PSDecode is unavailable or times out.

    Args:
        file_path: Absolute path to the input file (raw bytes or .ps1).

    Returns:
        A result dict — see module docstring for the full schema.
    """
    result = {
        "analysis_success": False,
        "analysis_type": "powershell",
        "input_mode": "file",
        "original_script": "",
        "decoded_layers": [],
        "final_decoded": "",
        "layer_count": 0,
        "iocs_extracted": {
            "urls": [],
            "ips": [],
            "domains": [],
            "file_paths": [],
            "registry_keys": [],
        },
        "obfuscation_techniques": [],
        "strings_of_interest": [],
        "psdecode_success": False,
        "psdecode_error": None,
    }

    # --- Read input file ---------------------------------------------------
    raw_bytes = Path(file_path).read_bytes()

    # --- Attempt Base64 / UTF-16LE decode (PowerShell -enc format) ----------
    decoded_text = _try_decode_base64(raw_bytes)
    if decoded_text is not None:
        result["input_mode"] = "encoded_command"
        original_script = decoded_text
    else:
        # Treat as a plain-text PowerShell script; fall back to UTF-8 / latin-1
        try:
            original_script = raw_bytes.decode("utf-8")
        except UnicodeDecodeError:
            original_script = raw_bytes.decode("latin-1")

    result["original_script"] = original_script[:MAX_SCRIPT_LENGTH]

    # --- Obfuscation detection on the original layer -----------------------
    result["obfuscation_techniques"] = _detect_obfuscation(original_script)

    # --- Run PSDecode for multi-layer unwrapping ---------------------------
    layers, psdecode_err = _run_psdecode(original_script)
    if layers is not None:
        result["psdecode_success"] = True
        result["decoded_layers"] = [layer[:MAX_SCRIPT_LENGTH] for layer in layers]
        final_decoded = layers[-1] if layers else original_script
    else:
        result["psdecode_error"] = psdecode_err
        # Fall back: if we did a Base64 decode, use that as the final layer
        if result["input_mode"] == "encoded_command":
            final_decoded = original_script
            result["decoded_layers"] = [original_script[:MAX_SCRIPT_LENGTH]]
        else:
            final_decoded = original_script

    result["final_decoded"] = final_decoded[:MAX_SCRIPT_LENGTH]
    result["layer_count"] = len(result["decoded_layers"])

    # --- IOC extraction from the deepest layer -----------------------------
    result["iocs_extracted"] = _extract_iocs(final_decoded)

    # --- Behavioral strings of interest ------------------------------------
    result["strings_of_interest"] = _extract_strings_of_interest(final_decoded)

    result["analysis_success"] = True
    return result


# ---------------------------------------------------------------------------
# Helper: Base64 decode (UTF-16LE / PowerShell -enc format)
# ---------------------------------------------------------------------------


def _try_decode_base64(raw_bytes: bytes) -> str | None:
    """
    Attempt to decode *raw_bytes* as a Base64-encoded PowerShell command.

    PowerShell's ``-EncodedCommand`` / ``-enc`` flag expects UTF-16LE text
    encoded as Base64.  Strip whitespace before trying so that files with
    trailing newlines are handled correctly.

    Returns:
        Decoded Unicode string, or ``None`` if decoding fails.
    """
    # Strip whitespace that might surround the base64 blob
    candidate = raw_bytes.strip()
    try:
        decoded_bytes = base64.b64decode(candidate, validate=True)
        # PowerShell -enc is always UTF-16LE; require at least one null byte
        # as a quick sanity check before committing to this path.
        if b"\x00" in decoded_bytes:
            return decoded_bytes.decode("utf-16-le")
        # Some scripts are Base64 of plain ASCII — try that too
        text = decoded_bytes.decode("utf-8")
        # Only accept if the result looks like a script (has PS keywords)
        ps_markers = (b"function", b"param", b"$", b"Invoke", b"Write-")
        if any(marker in decoded_bytes for marker in ps_markers):
            return text
        return None
    except Exception:
        return None


# ---------------------------------------------------------------------------
# Helper: Run PSDecode via pwsh subprocess
# ---------------------------------------------------------------------------


def _run_psdecode(script_text: str) -> tuple[list[str] | None, str | None]:
    """
    Write *script_text* to a temp file and run PSDecode via ``pwsh``.

    Uses a 30-second timeout to avoid hanging on heavily obfuscated samples
    that trigger infinite loops inside PSDecode.

    Returns:
        A 2-tuple ``(layers, error_message)``.  On success, *layers* is a
        non-empty list of decoded layer strings and *error_message* is
        ``None``.  On failure, *layers* is ``None`` and *error_message*
        describes what went wrong.
    """
    input_path = "/tmp/ps_input.ps1"
    try:
        Path(input_path).write_text(script_text, encoding="utf-8")
    except OSError as exc:
        return None, f"Failed to write temp file: {exc}"

    cmd = [
        "pwsh",
        "-NoProfile",
        "-NonInteractive",
        "-Command",
        f"Import-Module PSDecode; PSDecode '{input_path}'",
    ]

    try:
        proc = subprocess.run(
            cmd,
            capture_output=True,
            text=True,
            timeout=PSDECODE_TIMEOUT,
        )
    except subprocess.TimeoutExpired:
        return None, f"PSDecode timed out after {PSDECODE_TIMEOUT}s"
    except FileNotFoundError:
        return None, "pwsh not found — is PowerShell installed in the container?"
    except Exception as exc:
        return None, f"Unexpected error running PSDecode: {exc}"

    if proc.returncode != 0:
        stderr_snippet = (proc.stderr or "").strip()[:500]
        return None, f"PSDecode exited {proc.returncode}: {stderr_snippet}"

    output = (proc.stdout or "").strip()
    if not output:
        return None, "PSDecode produced no output"

    layers = _parse_psdecode_output(output)
    if not layers:
        return None, "PSDecode output could not be parsed into layers"

    return layers, None


# ---------------------------------------------------------------------------
# Helper: Parse PSDecode layer output
# ---------------------------------------------------------------------------


def _parse_psdecode_output(output: str) -> list[str]:
    """
    Split PSDecode stdout into individual decoded layers.

    PSDecode separates layers with banners like::

        ###### Layer 1 ######
        ...layer content...
        ###### Layer 2 ######

    If no such banners are present the entire output is returned as a single
    layer — this handles older PSDecode versions that print only one layer.

    Returns:
        List of stripped layer strings (empty layers are discarded).
    """
    layer_header = re.compile(r"^#{4,}\s+Layer\s+\d+\s+#{4,}", re.MULTILINE | re.IGNORECASE)
    parts = layer_header.split(output)

    # parts[0] is text before the first header (usually blank or a preamble)
    layers = [p.strip() for p in parts if p.strip()]

    if not layers:
        # No markers found — return the whole output as one layer
        whole = output.strip()
        return [whole] if whole else []

    return layers


# ---------------------------------------------------------------------------
# Helper: Obfuscation technique detection
# ---------------------------------------------------------------------------


def _detect_obfuscation(script: str) -> list[str]:
    """
    Heuristically identify obfuscation techniques present in *script*.

    Checks are intentionally conservative to minimise false positives while
    still catching the most common PowerShell obfuscation patterns seen in
    malware (Invoke-Obfuscation, AMSI bypass loaders, Empire stagers, etc.).

    Returns:
        Sorted list of technique names that were detected.
    """
    techniques: list[str] = []
    lower = script.lower()

    # Base64 encoding via .NET or PowerShell built-ins
    if "frombase64string" in lower or "[convert]::frombase64" in lower:
        techniques.append("base64_encoding")

    # Encoded command flag with a blob that looks like base64
    if re.search(r"-e(?:nc(?:odedcommand)?)?\s+[A-Za-z0-9+/]{20,}={0,2}", script, re.IGNORECASE):
        techniques.append("encoded_command")

    # IEX / Invoke-Expression wrapping
    if re.search(r"\biex\b|\binvoke-expression\b", lower):
        techniques.append("iex_invoke_expression")

    # Character code arrays — [char] casting used to hide strings
    char_hits = len(re.findall(r"\[char\]", script, re.IGNORECASE))
    if char_hits >= 3:
        techniques.append("char_code_array")

    # Format string operator: -f with positional placeholders
    if re.search(r"-f\s*['\"][^'\"]*\{0\}[^'\"]*['\"]", script, re.IGNORECASE) or re.search(
        r"\{0\}\{1\}", script
    ):
        techniques.append("format_string_obfuscation")

    # String concatenation: 5+ literal '+' joins
    concat_hits = len(re.findall(r"'\s*\+\s*'|'\s*\+\s*\$|\$[A-Za-z_]\w*\s*\+\s*'", script))
    if concat_hits >= 5:
        techniques.append("string_concatenation")

    # Replace chains: 3+ .Replace() or -replace calls
    replace_hits = len(re.findall(r"\.replace\(|-replace\b", script, re.IGNORECASE))
    if replace_hits >= 3:
        techniques.append("replace_chain")

    # Backtick obfuscation (PowerShell escape character abused to split tokens)
    backtick_hits = len(re.findall(r"`", script))
    if backtick_hits >= 5:
        techniques.append("backtick_obfuscation")

    # Compression / deflate streams used to hide payload
    if re.search(r"decompress|gzipstream|deflatestream", lower):
        techniques.append("compression_deflate")

    # Variable substitution: many short $var = assignments + high $ density
    short_var_assignments = len(re.findall(r"\$[A-Za-z_]\w{0,5}\s*=\s*['\"\[]", script))
    dollar_count = script.count("$")
    if short_var_assignments >= 6 and dollar_count >= 20:
        techniques.append("variable_substitution")

    return sorted(techniques)


# ---------------------------------------------------------------------------
# Helper: IOC extraction
# ---------------------------------------------------------------------------


def _extract_iocs(script: str) -> dict:
    """
    Extract Indicators of Compromise from *script* using regex patterns.

    Each category is capped at 50 entries to avoid bloating the result dict
    on heavily obfuscated scripts that manufacture hundreds of fake strings.

    Returns:
        Dict with keys: urls, ips, domains, file_paths, registry_keys.
    """
    _CAP = 50

    # --- URLs ---------------------------------------------------------------
    url_pattern = re.compile(r"https?://[^\s'\"<>)}\]]+", re.IGNORECASE)
    urls = list(dict.fromkeys(url_pattern.findall(script)))[:_CAP]

    # --- IP addresses -------------------------------------------------------
    ip_pattern = re.compile(r"\b(?:\d{1,3}\.){3}\d{1,3}\b")
    raw_ips = ip_pattern.findall(script)
    ips = [
        ip
        for ip in dict.fromkeys(raw_ips)
        if not (
            ip.startswith("0.")
            or ip.startswith("127.")
            or ip.startswith("255.")
        )
    ][:_CAP]

    # --- File paths (Windows) -----------------------------------------------
    path_pattern = re.compile(
        r"[A-Za-z]:\\[\w\\\.\-\s]+(?:\.exe|\.dll|\.bat|\.cmd|\.ps1|\.vbs|\.tmp|\.dat)",
        re.IGNORECASE,
    )
    file_paths = list(dict.fromkeys(path_pattern.findall(script)))[:_CAP]

    # --- Registry keys ------------------------------------------------------
    reg_pattern = re.compile(
        r"(?:HKLM|HKCU|HKCR|HKU|HKCC)[:\\][^\s'\"<>)]+",
        re.IGNORECASE,
    )
    registry_keys = list(dict.fromkeys(reg_pattern.findall(script)))[:_CAP]

    # --- Domains (not already captured in URLs) -----------------------------
    # Common TLD set — intentionally broad to catch C2 beacons
    domain_pattern = re.compile(
        r"\b(?:[a-zA-Z0-9](?:[a-zA-Z0-9\-]{0,61}[a-zA-Z0-9])?\.)+"
        r"(?:com|net|org|io|co|ru|cn|de|uk|info|biz|xyz|top|club|pw|tk|ml|ga|cf|gq)\b",
        re.IGNORECASE,
    )
    all_domains = domain_pattern.findall(script)
    # Strip domains that are already part of an extracted URL
    url_bodies = " ".join(urls)
    domains = [
        d for d in dict.fromkeys(all_domains) if d not in url_bodies
    ][:_CAP]

    return {
        "urls": urls,
        "ips": ips,
        "domains": domains,
        "file_paths": file_paths,
        "registry_keys": registry_keys,
    }


# ---------------------------------------------------------------------------
# Helper: Strings of interest (behavioral indicators)
# ---------------------------------------------------------------------------


def _extract_strings_of_interest(script: str) -> list[dict]:
    """
    Search *script* for behavioral indicator patterns by category.

    Returns at most one finding per category (the first match found), keeping
    the result actionable rather than exhaustive.

    Returns:
        List of dicts, each with keys: ``type``, ``value``, ``context``.
        *context* is up to 120 characters of surrounding script text.
    """
    categories: dict[str, list[str]] = {
        "download_cradle": [
            r"DownloadString",
            r"DownloadFile",
            r"Invoke-WebRequest",
            r"\bwget\b",
            r"\bcurl\b",
            r"Net\.WebClient",
            r"Start-BitsTransfer",
        ],
        "execution": [
            r"Start-Process",
            r"Invoke-Item",
            r"Invoke-Command",
            r"Invoke-WmiMethod",
            r"New-Service",
        ],
        "credential_access": [
            r"Invoke-Mimikatz",
            r"\bmimikatz\b",
            r"sekurlsa",
            r"\blsass\b",
            r"\bSAM\b",
        ],
        "offensive_tool": [
            r"Invoke-Shellcode",
            r"Invoke-ReflectivePEInjection",
            r"PowerSploit",
            r"\bEmpire\b",
            r"Invoke-Obfuscation",
        ],
        "persistence": [
            r"New-ScheduledTask",
            r"\bschtasks\b",
            r"HKLM:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run",
            r"HKCU:\\SOFTWARE\\Microsoft\\Windows\\CurrentVersion\\Run",
            r"New-Service",
            r"sc\.exe\s+create",
        ],
        "evasion": [
            r"Set-MpPreference",
            r"-ExclusionPath",
            r"DisableRealtimeMonitoring",
            r"AmsiUtils",
            r"amsiInitFailed",
        ],
    }

    findings: list[dict] = []

    for category, patterns in categories.items():
        for pattern in patterns:
            match = re.search(pattern, script, re.IGNORECASE)
            if match:
                start = max(0, match.start() - 40)
                end = min(len(script), match.end() + 80)
                context = script[start:end].replace("\n", " ").replace("\r", "")
                findings.append(
                    {
                        "type": category,
                        "value": match.group(0),
                        "context": context[:120],
                    }
                )
                break  # one finding per category

    return findings


# ---------------------------------------------------------------------------
# CLI entry point
# ---------------------------------------------------------------------------


if __name__ == "__main__":
    parser = argparse.ArgumentParser(
        description="Analyze and deobfuscate a PowerShell script using PSDecode."
    )
    parser.add_argument("file", help="Path to the PowerShell script or encoded command file")
    args = parser.parse_args()

    target = Path(args.file)
    if not target.exists():
        print(
            json.dumps(
                {
                    "analysis_success": False,
                    "analysis_type": "powershell",
                    "error": f"File not found: {args.file}",
                }
            )
        )
        sys.exit(1)

    try:
        output = analyze_powershell(str(target))
    except Exception:
        output = {
            "analysis_success": False,
            "analysis_type": "powershell",
            "error": "Unhandled exception during analysis",
            "traceback": traceback.format_exc(),
        }

    print(json.dumps(output, indent=2))
