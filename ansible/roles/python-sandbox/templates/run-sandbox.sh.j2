#!/bin/bash
# =============================================================================
# run-sandbox — execute a Python script in an isolated container
#
# Usage: echo '<script>' | run-sandbox [--data <payload_dir>]
#
# stdin:  Python script to execute (streamed directly into the container;
#         max {{ python_sandbox_max_script_size }} bytes via head -c)
# stdout: combined script stdout/stderr (max {{ python_sandbox_max_output_size }} bytes)
#
# Isolation: no network, read-only root, all caps dropped, 256MB / 1 CPU / 30s limits.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -uo pipefail

# Re-enter pipeline's lingering systemd user session before touching podman.
# The API delegates via `sudo -u pipeline` (a non-login shell) where rootless
# podman cannot attach to its pause process (which holds the user namespace)
# and fails with "image not found". systemd-run --user runs us inside the
# persistent user manager where podman works. The guard var prevents an
# infinite re-exec; the bus-socket check falls through to current behavior if
# no user session is reachable. See docs/superpowers/specs for full rationale.
_uid="$(id -u)"
if [ -z "${LAMWARE_IN_USER_SESSION:-}" ] && [ -S "/run/user/${_uid}/bus" ]; then
    export LAMWARE_IN_USER_SESSION=1
    exec env XDG_RUNTIME_DIR="/run/user/${_uid}" \
             DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${_uid}/bus" \
             systemd-run --user --pipe --quiet --wait --collect -- "$0" "$@"
fi

VOLUME_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --data)
            DATA_DIR="$(realpath "$2")"
            if [ ! -d "$DATA_DIR" ]; then
                echo "Error: data directory not found: $DATA_DIR" >&2
                exit 1
            fi
            # Allowlist: only Cape analysis dirs may be mounted — prevents a
            # compromised caller from exposing arbitrary host paths ro.
            case "$DATA_DIR" in
                {{ python_sandbox_data_allowlist | default('/opt/CAPEv2/storage/analyses') }}/*)  ;;
                *)
                    echo "Error: --data must be under {{ python_sandbox_data_allowlist | default('/opt/CAPEv2/storage/analyses') }}" >&2
                    exit 1
                    ;;
            esac
            VOLUME_ARGS+=(-v "$DATA_DIR:/data:ro")
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if ! podman image exists localhost/python-sandbox:latest; then
    echo "Error: image localhost/python-sandbox:latest not found — deploy the python-sandbox role first" >&2
    exit 1
fi

# Stream stdin directly into the container — no shell variable, no quoting concerns.
# USER directive in Containerfile enforces non-root; no --user override needed.
head -c {{ python_sandbox_max_script_size }} | podman run --rm -i \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ python_sandbox_container_memory }} \
    --cpus={{ python_sandbox_container_cpus }} \
    --timeout={{ python_sandbox_container_timeout }} \
    --tmpfs /tmp:size=50m \
    "${VOLUME_ARGS[@]}" \
    localhost/python-sandbox:latest \
    python3 -u - 2>&1 | head -c {{ python_sandbox_max_output_size }}
