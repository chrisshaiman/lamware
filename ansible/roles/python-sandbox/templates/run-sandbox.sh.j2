#!/bin/bash
# =============================================================================
# run-sandbox — execute a Python script in an isolated container
#
# Usage: echo '<script>' | run-sandbox [--data-as NAME=<payload_dir>]...
#
# stdin:  Python script to execute (streamed directly into the container;
#         max {{ python_sandbox_max_script_size }} bytes via head -c)
# stdout: combined script stdout/stderr (max {{ python_sandbox_max_output_size }} bytes)
#
# Isolation: no network, read-only root, all caps dropped, {{ python_sandbox_container_memory }} / {{ python_sandbox_container_cpus }} CPU / {{ python_sandbox_container_timeout }}s limits.
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -uo pipefail

# Re-enter pipeline's lingering systemd user session before touching podman.
# The API delegates via `sudo -u pipeline` (a non-login shell) where rootless
# podman cannot attach to its pause process (which holds the user namespace)
# and fails with "image not found". systemd-run --user runs us inside the
# persistent user manager where podman works. The guard var prevents an
# infinite re-exec; the bus-socket check falls through to current behavior if
# no user session is reachable. See docs/superpowers/specs for full rationale.
_uid="$(id -u)"
if [ -z "${LAMWARE_IN_USER_SESSION:-}" ] && [ -S "/run/user/${_uid}/bus" ]; then
    # XDG_RUNTIME_DIR/DBUS let `env` reach pipeline's user manager. The guard
    # must be passed to the UNIT via --setenv (systemd-run --user does not
    # forward our env into the unit); without it the inner wrapper re-execs
    # again and loses stdin.
    exec env XDG_RUNTIME_DIR="/run/user/${_uid}" \
             DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${_uid}/bus" \
             systemd-run --user --pipe --quiet --wait --collect \
             --setenv=LAMWARE_IN_USER_SESSION=1 -- "$0" "$@"
fi

VOLUME_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        --data)
            # Removed. It mounted a whole Cape task directory (pcaps, memory dumps,
            # the full report) where LLM-authored code runs; the API stopped using
            # it in #392, and with keep-groups below it would make all of that
            # readable. Refuse rather than ignore, so a caller finds out.
            echo "Error: --data was removed; use --data-as NAME=<task>/<payload dir>" >&2
            exit 1
            ;;
        --data-as)
            # NAME=PATH, mounted read-only at /data/NAME. Exists because --data
            # maps to a fixed /data and so cannot be repeated, which forced the
            # caller to mount the whole 76MB task directory — pcaps, memory
            # dumps, evtx, the full Cape report — into the container where
            # LLM-authored code runs, when all it needed was the payloads
            # (#392). Passing CAPE/files/procdump as the names keeps the
            # in-container paths identical to that mount.
            AS_NAME="${2%%=*}"
            AS_PATH="${2#*=}"
            if [ -z "$AS_NAME" ] || [ "$AS_NAME" = "$2" ]; then
                echo "Error: --data-as expects NAME=PATH, got: $2" >&2
                exit 1
            fi
            # The name becomes a path component inside the container; keep it a
            # bare word so it cannot escape /data or inject mount options.
            case "$AS_NAME" in
                *[!A-Za-z0-9_-]*)
                    echo "Error: --data-as name must be alphanumeric: $AS_NAME" >&2
                    exit 1
                    ;;
            esac
            AS_PATH="$(realpath "$AS_PATH")"
            if [ ! -d "$AS_PATH" ]; then
                echo "Error: data directory not found: $AS_PATH" >&2
                exit 1
            fi
            # Exactly <storage>/<task id>/<payload dir>, named after that dir:
            # the four directories payload_dirs() returns (shared/lamware_shared/
            # cape_payloads.py PAYLOAD_SUBDIRS). keep-groups below gives the
            # container lamware's read access to whatever is mounted, and that
            # group can read ~68k paths under the storage root, so "anything
            # under storage" is no longer a safe allowlist: a task directory
            # would expose its pcaps and memory dumps.
            ALLOW_ROOT="{{ python_sandbox_data_allowlist | default('/opt/CAPEv2/storage/analyses') }}"
            if [[ ! "$AS_PATH" =~ ^${ALLOW_ROOT}/[0-9]+/(CAPE|files|procdump|dropped)$ ]] \
                    || [ "${BASH_REMATCH[1]}" != "$AS_NAME" ]; then
                echo "Error: --data-as must be NAME=${ALLOW_ROOT}/<task id>/NAME with NAME one of CAPE files procdump dropped" >&2
                exit 1
            fi
            VOLUME_ARGS+=(-v "$AS_PATH:/data/$AS_NAME:ro")
            shift 2
            ;;
        *)
            shift
            ;;
    esac
done

if ! {{ image_store_lib_dir | default('/usr/local/lib/lamware') }}/lamware-podman image exists localhost/python-sandbox:latest; then
    echo "Error: image localhost/python-sandbox:latest not found — deploy the python-sandbox role first" >&2
    exit 1
fi

# Stream stdin directly into the container — no shell variable, no quoting concerns.
# USER directive in Containerfile enforces non-root; no --user override needed.
#
# --group-add keep-groups: Cape writes payloads as cape:lamware (0640, with an
# ACL), and `pipeline` reads them through the lamware group. Rootless podman drops
# supplementary groups unless told to keep them, so every payload the API mounted
# was "Permission denied" inside the container (measured 2026-11-27: /data/CAPE
# EACCES, groups [999]) while the agent's prompt said the payloads were there.
# Same flag and reason as run-volatility-wrapper.sh.j2. It is safe only because
# --data-as above admits nothing but a task's payload directories.
head -c {{ python_sandbox_max_script_size }} | {{ image_store_lib_dir | default('/usr/local/lib/lamware') }}/lamware-podman run --rm -i \
    --network=none \
    --group-add keep-groups \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ python_sandbox_container_memory }} \
    --cpus={{ python_sandbox_container_cpus }} \
    --timeout={{ python_sandbox_container_timeout }} \
    --tmpfs /tmp:size=50m \
    "${VOLUME_ARGS[@]}" \
    localhost/python-sandbox:latest \
    python3 -u - 2>&1 | head -c {{ python_sandbox_max_output_size }}
