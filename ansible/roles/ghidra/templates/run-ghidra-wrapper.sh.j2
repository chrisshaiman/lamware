#!/bin/bash
# =============================================================================
# run-ghidra — host-side wrapper for containerized Ghidra headless analysis
# Runs Ghidra's headless analyzer against a PE binary inside a Podman
# container with full isolation.
#
# Usage (analysis mode):  run-ghidra <sample_path> [output_dir]
# Usage (tool mode):      run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>
#
# Analysis mode: import and analyze a PE binary, output JSON to stdout.
# Tool mode: query an already-analyzed Ghidra project (no re-analysis).
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

if [ $# -lt 1 ]; then
    echo "Usage: run-ghidra <sample_path> [output_dir]" >&2
    echo "       run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Tool mode
# ---------------------------------------------------------------------------
if [ "$1" = "--tool" ]; then
    # Re-enter pipeline's lingering systemd user session before touching podman.
    # Tool mode is API-delegated via non-login `sudo -u pipeline`, where rootless
    # podman cannot attach its pause process (which holds the user namespace) and
    # fails with "image not found". systemd-run --user runs us inside the
    # persistent user manager where podman works. Analysis/shellcode modes are
    # pipeline-native and intentionally NOT wrapped. Guard prevents an infinite
    # re-exec; bus-socket check falls through if no session is reachable.
    _uid="$(id -u)"
    if [ -z "${LAMWARE_IN_USER_SESSION:-}" ] && [ -S "/run/user/${_uid}/bus" ]; then
        export LAMWARE_IN_USER_SESSION=1
        exec env XDG_RUNTIME_DIR="/run/user/${_uid}" \
                 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${_uid}/bus" \
                 systemd-run --user --pipe --quiet --wait --collect -- "$0" "$@"
    fi

    # SECURITY: this arg-count check is load-bearing — the lamware-api sudoers
    # rule allows 'run-ghidra --tool *' and relies on this rejection of extra
    # args. Do not relax it.
    if [ $# -ne 5 ]; then
        echo "Usage: run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>" >&2
        exit 1
    fi

    PROJECT_DIR="$(realpath "$2")"
    PROGRAM_NAME="$3"
    TOOL_NAME="$4"
    TOOL_ARGS="$5"

    if [ ! -d "$PROJECT_DIR" ]; then
        echo "Error: project dir not found: $PROJECT_DIR" >&2
        exit 1
    fi

    # Ghidra must acquire a write lock to open the project. The persisted
    # project is owned pipeline:lamware (0750), but the container runs as
    # nobody (65534) and cannot write the lock file there — opening fails with
    # "Unable to lock project". Copy the project to a world-writable temp so
    # the container can lock it. This also makes concurrent tool calls safe:
    # each call operates on its own copy, with no lock contention on the
    # shared persisted project.
    WORK_PROJECT="$(mktemp -d)"
    trap 'rm -rf "$WORK_PROJECT" 2>/dev/null || true' EXIT
    cp -a "$PROJECT_DIR/." "$WORK_PROJECT/"
    chmod -R a+rwX "$WORK_PROJECT"

    podman run --rm \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --memory={{ ghidra_container_memory }} \
        --cpus={{ ghidra_container_cpus }} \
        --timeout=120 \
        --tmpfs /tmp:size=1g \
        --tmpfs /nonexistent:size=100m \
        --user 65534:65534 \
        -v "$WORK_PROJECT:/project:rw" \
        localhost/ghidra:latest \
        --tool /project "$PROGRAM_NAME" "$TOOL_NAME" "$TOOL_ARGS"
    # run-ghidra.py always prints a JSON result dict (with an "error" key on
    # failure) and exits 0; propagate podman's exit code and STOP. Without this
    # exit the script falls through to analysis mode below, whose arg-count
    # check rejects the 5 tool-mode args and exits 1 — making the API discard
    # otherwise-valid tool output (it gates on a non-zero return code).
    exit $?
fi

# ---------------------------------------------------------------------------
# Shellcode mode — import raw binary for analysis
# ---------------------------------------------------------------------------
if [ "$1" = "--shellcode" ]; then
    if [ $# -lt 3 ] || [ $# -gt 4 ]; then
        echo "Usage: run-ghidra --shellcode <dump_file> <output_dir> [base_address]" >&2
        exit 1
    fi

    DUMP_FILE="$(realpath "$2")"
    DUMP_NAME="$(basename "$DUMP_FILE")"
    OUTPUT_DIR="$3"
    BASE_ADDR="${4:-0x0}"

    if [ ! -f "$DUMP_FILE" ]; then
        echo "Error: file not found: $DUMP_FILE" >&2
        exit 1
    fi

    mkdir -p "$OUTPUT_DIR"

    # Copy dump to temp dir for isolation
    WORK_DIR="$(mktemp -d)"
    CONTAINER_OUTPUT="$(mktemp -d)"
    trap 'rm -rf "$WORK_DIR" "$CONTAINER_OUTPUT" 2>/dev/null || true' EXIT
    chmod 755 "$WORK_DIR"
    chmod a+rwx "$CONTAINER_OUTPUT" 2>/dev/null || true
    cp "$DUMP_FILE" "$WORK_DIR/$DUMP_NAME"
    chmod 644 "$WORK_DIR/$DUMP_NAME"

    podman run --rm \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --memory={{ ghidra_container_memory }} \
        --cpus={{ ghidra_container_cpus }} \
        --timeout={{ ghidra_container_timeout }} \
        --tmpfs /tmp:size=1g \
        --tmpfs /nonexistent:size=100m \
        --tmpfs /var/cache:size=100m \
        --user 65534:65534 \
        -v "$WORK_DIR:/sample:ro" \
        -v "$CONTAINER_OUTPUT:/output:rw" \
        localhost/ghidra:latest \
        --shellcode "/sample/$DUMP_NAME" "$BASE_ADDR"

    # Container wrote output as UID-mapped 'nobody'; reassign to the pipeline
    # user inside the rootless userns so the copy can read it (see analysis
    # mode below for the full rationale).
    podman unshare chown -R 0:0 "$CONTAINER_OUTPUT" 2>/dev/null || true
    if ! cp -a "$CONTAINER_OUTPUT"/. "$OUTPUT_DIR"/; then
        echo "Error: failed to copy Ghidra shellcode output to $OUTPUT_DIR" >&2
    fi
    # Stop here so we don't fall through to analysis mode (which would reject
    # the shellcode arg count and exit 1). Output JSON is already on stdout.
    exit 0
fi

# ---------------------------------------------------------------------------
# Analysis mode
# ---------------------------------------------------------------------------
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: run-ghidra <sample_path> [output_dir]" >&2
    exit 1
fi

SAMPLE_PATH="$(realpath "$1")"
SAMPLE_NAME="$(basename "$SAMPLE_PATH")"
OUTPUT_DIR="${2:-{{ ghidra_output_dir }}}"

if [ ! -f "$SAMPLE_PATH" ]; then
    echo "Error: file not found: $SAMPLE_PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Copy sample to temp dir — only the single file is mounted
WORK_DIR="$(mktemp -d)"
# Container output goes to a separate temp dir (rootless Podman UID mapping
# prevents the container's nobody user from writing to pipeline-owned dirs)
CONTAINER_OUTPUT="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR" "$CONTAINER_OUTPUT" 2>/dev/null || true' EXIT
chmod 755 "$WORK_DIR"
chmod a+rwx "$CONTAINER_OUTPUT" 2>/dev/null || true
cp "$SAMPLE_PATH" "$WORK_DIR/$SAMPLE_NAME"
chmod 644 "$WORK_DIR/$SAMPLE_NAME"

podman run --rm \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ ghidra_container_memory }} \
    --cpus={{ ghidra_container_cpus }} \
    --timeout={{ ghidra_container_timeout }} \
    --tmpfs /tmp:size=1g \
    --tmpfs /nonexistent:size=100m \
    --tmpfs /var/cache:size=100m \
    --user 65534:65534 \
    -v "$WORK_DIR:/sample:ro" \
    -v "$CONTAINER_OUTPUT:/output:rw" \
    localhost/ghidra:latest \
    "/sample/$SAMPLE_NAME"

# Copy results back to the real output directory.
#
# The container runs as rootless-podman's UID-mapped 'nobody', so everything it
# wrote — including the saved Ghidra project — is owned by a high subuid with
# 0750/0640 perms, unreadable by the pipeline user. Reassign ownership to the
# pipeline user *inside* the rootless user namespace (namespace uid 0 == host
# pipeline uid) so the copy can read it and so tool-mode can later open the
# project. Without this, cp silently copied an empty project (analysis.rep with
# no data/) and agentic Ghidra tools failed with "Project data directory not
# found". Do NOT silence the copy — a failure here means lost analysis output.
podman unshare chown -R 0:0 "$CONTAINER_OUTPUT" 2>/dev/null || true
if ! cp -a "$CONTAINER_OUTPUT"/. "$OUTPUT_DIR"/; then
    echo "Error: failed to copy Ghidra analysis output to $OUTPUT_DIR" >&2
fi
