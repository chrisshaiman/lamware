#!/bin/bash
# =============================================================================
# run-ghidra — host-side wrapper for containerized Ghidra headless analysis
# Runs Ghidra's headless analyzer against a PE binary inside a Podman
# container with full isolation.
#
# Usage (analysis mode):  run-ghidra <sample_path> [output_dir]
# Usage (tool mode):      run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>
#
# Analysis mode: import and analyze a PE binary, output JSON to stdout.
# Tool mode: query an already-analyzed Ghidra project (no re-analysis).
#
# Author: Christopher Shaiman
# License: Apache 2.0
# =============================================================================

set -euo pipefail

# Container work dirs (#694). The container runs as 65534:65534 inside the
# pipeline user's rootless userns: host subuid 200000 + 65534 - 1 = 265533
# (/etc/subuid "pipeline:200000:65536"). It must WRITE its output (and the
# project lock in tool mode) and cannot write a pipeline-owned dir. That used
# to be solved with `chmod a+rwx`, which let any local user add or replace
# files in the dir while the job ran.
#   - JOB_DIR is mktemp's private 0700 dir, owned by pipeline: no other local
#     user can reach anything below it. The container never traverses it;
#     podman bind-mounts the subdirs directly.
#   - Dirs the container reads are pipeline-owned 0755; its nobody reads them
#     via "other". Dirs it writes are chowned to its uid with `podman unshare`
#     and are 0700, so only that uid can write them; output is chowned back to
#     namespace root (== pipeline) after the run so the copy can read it.
#   - Cleanup uses `podman unshare rm`: files the container wrote are owned by
#     the subuid, which the pipeline user cannot unlink directly.
CONTAINER_UID=65534
CONTAINER_GID=65534
JOB_DIR=""
cleanup() {
    [ -n "$JOB_DIR" ] || return 0
    podman unshare rm -rf "$JOB_DIR" 2>/dev/null || rm -rf "$JOB_DIR" 2>/dev/null || true
}
setup_job_dir() {
    trap cleanup EXIT
    JOB_DIR="$(mktemp -d)"
    mkdir -m 0755 "$JOB_DIR/in"
    mkdir -m 0700 "$JOB_DIR/out"
    podman unshare chown "$CONTAINER_UID:$CONTAINER_GID" "$JOB_DIR/out"
}

# Copy the container's output to $1 once it has exited.
collect_output() {
    # Hand the output back to the pipeline user (namespace uid 0). Everything
    # the container wrote — including the saved Ghidra project — is owned by
    # the subuid with 0750/0640 perms, unreadable by the pipeline user; without
    # this, cp silently copied an empty project (analysis.rep with no data/)
    # and agentic Ghidra tools failed with "Project data directory not found".
    podman unshare chown -R 0:0 "$JOB_DIR/out"
    # Container output is untrusted: a compromised analyser can leave symlinks (or
    # FIFOs, devices) in it, and `cp -a` copies a link AS a link into the report
    # dir, where the pipeline later writes through it. Only regular files and
    # directories are handed back; anything else is deleted and named on stderr.
    find "$JOB_DIR/out" -mindepth 1 ! -type f ! -type d -print -delete \
        | sed 's/^/run-ghidra: dropped non-regular output entry: /' >&2
    # Entry by entry. NOT `cp -a out/. "$1"/`: copying "." stamps the work
    # dir's own mode onto the destination, which made it 0777 while the work
    # dir was a+rwx (#694) and would now make it 0700, hiding it from the
    # lamware group. --remove-destination: a link already AT the destination
    # (report dirs are group-writable) is replaced, not written through. Do NOT
    # silence the copy — a failure means lost output.
    if ! find "$JOB_DIR/out" -mindepth 1 -maxdepth 1 -exec cp -a --remove-destination -t "$1"/ {} +; then
        echo "Error: failed to copy Ghidra output to $1" >&2
    fi
}

if [ $# -lt 1 ]; then
    echo "Usage: run-ghidra <sample_path> [output_dir]" >&2
    echo "       run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>" >&2
    exit 1
fi

# ---------------------------------------------------------------------------
# Tool mode
# ---------------------------------------------------------------------------
if [ "$1" = "--tool" ]; then
    # Re-enter pipeline's lingering systemd user session before touching podman.
    # Tool mode is API-delegated via non-login `sudo -u pipeline`, where rootless
    # podman cannot attach its pause process (which holds the user namespace) and
    # fails with "image not found". systemd-run --user runs us inside the
    # persistent user manager where podman works. Analysis/shellcode modes are
    # pipeline-native and intentionally NOT wrapped. Guard prevents an infinite
    # re-exec; bus-socket check falls through if no session is reachable.
    _uid="$(id -u)"
    if [ -z "${LAMWARE_IN_USER_SESSION:-}" ] && [ -S "/run/user/${_uid}/bus" ]; then
        # XDG_RUNTIME_DIR/DBUS let `env` reach pipeline's user manager. The guard
        # must be passed to the UNIT via --setenv (systemd-run --user does not
        # forward our env into the unit); without it the inner wrapper re-execs
        # again and loses its args/stdin.
        exec env XDG_RUNTIME_DIR="/run/user/${_uid}" \
                 DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/${_uid}/bus" \
                 systemd-run --user --pipe --quiet --wait --collect \
                 --setenv=LAMWARE_IN_USER_SESSION=1 -- "$0" "$@"
    fi

    # SECURITY: this arg-count check is load-bearing — the lamware-api sudoers
    # rule allows 'run-ghidra --tool *' and relies on this rejection of extra
    # args. Do not relax it.
    if [ $# -ne 5 ]; then
        echo "Usage: run-ghidra --tool <project_dir> <program_name> <tool_name> <args_json>" >&2
        exit 1
    fi

    PROJECT_DIR="$(realpath "$2")"
    PROGRAM_NAME="$3"
    TOOL_NAME="$4"
    TOOL_ARGS="$5"

    if [ ! -d "$PROJECT_DIR" ]; then
        echo "Error: project dir not found: $PROJECT_DIR" >&2
        exit 1
    fi

    # Ghidra must acquire a write lock to open the project. The persisted
    # project is owned pipeline:lamware (0750), but the container runs as
    # nobody (65534) and cannot write the lock file there — opening fails with
    # "Unable to lock project". Copy the project to a private temp and give the
    # copy to the container's uid so it can lock it. This also makes concurrent
    # tool calls safe: each call operates on its own copy, with no lock
    # contention on the shared persisted project.
    #
    # The copy used to be `chmod -R a+rwX`, writable by every local user (#694).
    # JOB_DIR is mktemp's 0700 pipeline-owned dir, and project/ is owned by the
    # container's uid only (see setup_job_dir at the top for the uid mapping).
    setup_job_dir
    mkdir -m 0700 "$JOB_DIR/project"
    cp -a "$PROJECT_DIR/." "$JOB_DIR/project/"
    chmod -R u+rwX,go-rwx "$JOB_DIR/project"
    podman unshare chown -R "$CONTAINER_UID:$CONTAINER_GID" "$JOB_DIR/project"

    podman run --rm \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --memory={{ ghidra_container_memory }} \
        --cpus={{ ghidra_container_cpus }} \
        --timeout=120 \
        --tmpfs /tmp:size=1g \
        --tmpfs /nonexistent:size=100m \
        --user "$CONTAINER_UID:$CONTAINER_GID" \
        -v "$JOB_DIR/project:/project:rw" \
        localhost/ghidra:latest \
        --tool /project "$PROGRAM_NAME" "$TOOL_NAME" "$TOOL_ARGS"
    # run-ghidra.py always prints a JSON result dict (with an "error" key on
    # failure) and exits 0; propagate podman's exit code and STOP. Without this
    # exit the script falls through to analysis mode below, whose arg-count
    # check rejects the 5 tool-mode args and exits 1 — making the API discard
    # otherwise-valid tool output (it gates on a non-zero return code).
    exit $?
fi

# ---------------------------------------------------------------------------
# Shellcode mode — import raw binary for analysis
# ---------------------------------------------------------------------------
if [ "$1" = "--shellcode" ]; then
    if [ $# -lt 3 ] || [ $# -gt 4 ]; then
        echo "Usage: run-ghidra --shellcode <dump_file> <output_dir> [base_address]" >&2
        exit 1
    fi

    DUMP_FILE="$(realpath "$2")"
    DUMP_NAME="$(basename "$DUMP_FILE")"
    OUTPUT_DIR="$3"
    BASE_ADDR="${4:-0x0}"

    if [ ! -f "$DUMP_FILE" ]; then
        echo "Error: file not found: $DUMP_FILE" >&2
        exit 1
    fi

    mkdir -p "$OUTPUT_DIR"

    # Copy dump to a private temp dir for isolation
    setup_job_dir
    cp "$DUMP_FILE" "$JOB_DIR/in/$DUMP_NAME"
    chmod 644 "$JOB_DIR/in/$DUMP_NAME"

    podman run --rm \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --memory={{ ghidra_container_memory }} \
        --cpus={{ ghidra_container_cpus }} \
        --timeout={{ ghidra_container_timeout }} \
        --tmpfs /tmp:size=1g \
        --tmpfs /nonexistent:size=100m \
        --tmpfs /var/cache:size=100m \
        --user "$CONTAINER_UID:$CONTAINER_GID" \
        -v "$JOB_DIR/in:/sample:ro" \
        -v "$JOB_DIR/out:/output:rw" \
        localhost/ghidra:latest \
        --shellcode "/sample/$DUMP_NAME" "$BASE_ADDR"

    collect_output "$OUTPUT_DIR"
    # Stop here so we don't fall through to analysis mode (which would reject
    # the shellcode arg count and exit 1). Output JSON is already on stdout.
    exit 0
fi

# ---------------------------------------------------------------------------
# Analysis mode
# ---------------------------------------------------------------------------
if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    echo "Usage: run-ghidra <sample_path> [output_dir]" >&2
    exit 1
fi

SAMPLE_PATH="$(realpath "$1")"
SAMPLE_NAME="$(basename "$SAMPLE_PATH")"
OUTPUT_DIR="${2:-{{ ghidra_output_dir }}}"

if [ ! -f "$SAMPLE_PATH" ]; then
    echo "Error: file not found: $SAMPLE_PATH" >&2
    exit 1
fi

mkdir -p "$OUTPUT_DIR"

# Copy sample to a private temp dir — only the single file is mounted. Output
# goes to a separate subdir owned by the container's uid (rootless Podman UID
# mapping prevents its nobody user from writing to pipeline-owned dirs).
setup_job_dir
cp "$SAMPLE_PATH" "$JOB_DIR/in/$SAMPLE_NAME"
chmod 644 "$JOB_DIR/in/$SAMPLE_NAME"

podman run --rm \
    --network=none \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges \
    --memory={{ ghidra_container_memory }} \
    --cpus={{ ghidra_container_cpus }} \
    --timeout={{ ghidra_container_timeout }} \
    --tmpfs /tmp:size=1g \
    --tmpfs /nonexistent:size=100m \
    --tmpfs /var/cache:size=100m \
    --user "$CONTAINER_UID:$CONTAINER_GID" \
    -v "$JOB_DIR/in:/sample:ro" \
    -v "$JOB_DIR/out:/output:rw" \
    localhost/ghidra:latest \
    "/sample/$SAMPLE_NAME"

# Copy results back to the real output directory (and give the saved project
# to the pipeline user so tool mode can later open it).
collect_output "$OUTPUT_DIR"
