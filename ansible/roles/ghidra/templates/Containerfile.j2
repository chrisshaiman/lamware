# Ghidra headless static analysis container
# Built locally by Ansible. Never pulled from a registry.
#
# The release zip is fetched by the ROLE (get_url + sha256) and arrives here as
# ghidra.zip in the build context. The build itself reaches no network: it runs
# as `pipeline`, whose egress allowlist covers loopback:5432 and loopback:8000
# and nothing else — it cannot even resolve DNS.
#
# Two stages, because the zip is ~486 MiB. A COPY in the final image would keep
# it in a layer forever, `rm` or not, roughly doubling the image. Unpack here,
# copy only the tree.
#
# Hermetic (ADR-023): built with --network=none. The base image is pinned by
# digest; each stage's Debian packages were fetched by lamware-fetch from a
# pinned Ubuntu snapshot, one set per stage (debs/unpack, debs/runtime).

FROM {{ ghidra_base_image }} AS ghidra-unpack

COPY debs/unpack/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb && rm -rf /tmp/debs

COPY ghidra.zip /tmp/ghidra.zip
RUN unzip -q /tmp/ghidra.zip -d /opt \
    && mv /opt/ghidra_{{ ghidra_version }}_PUBLIC /opt/ghidra \
    && rm /tmp/ghidra.zip

# -------------------------------------------------------------------------

FROM {{ ghidra_base_image }}

# wget and unzip are deliberately NOT installed here. Nothing at runtime uses
# them, and this container is handed malware: the fewer fetch-and-unpack tools
# inside it, the less a sample has to work with.
COPY debs/runtime/ /tmp/debs/
RUN dpkg -i /tmp/debs/*.deb && rm -rf /tmp/debs

COPY --from=ghidra-unpack /opt/ghidra /opt/ghidra

COPY run-ghidra.py /opt/run-ghidra.py
COPY ExportAnalysis.java /opt/ghidra/Ghidra/Features/Base/ghidra_scripts/ExportAnalysis.java
COPY GhidraTool.java /opt/ghidra/Ghidra/Features/Base/ghidra_scripts/GhidraTool.java
RUN chmod +x /opt/run-ghidra.py

# Java reads user.home from /etc/passwd via getpwuid(), ignoring $HOME.
# The nobody user (65534) has /nonexistent as home — create it so Java
# and Ghidra can write config there. Matches triage/volatility pattern
# of using nobody (65534:65534) with no custom user.
RUN mkdir -p /nonexistent && chmod 777 /nonexistent

ENV JAVA_HOME=/opt/java/openjdk
ENV HOME=/nonexistent
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Sample PE is mounted at /sample (read-only)
# Output goes to /output (read-write volume)

ENTRYPOINT ["python3", "/opt/run-ghidra.py"]
